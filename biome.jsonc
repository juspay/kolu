// Phase 12 of #710: flip on the `a11y` rule group. 88 findings split
// across mechanical (useButtonType, noSvgWithoutTitle) and judgment
// (noStaticElementInteractions on canvas widgets). The 4 spatial-mouse
// sites in `canvas/CanvasMinimap.tsx` and `canvas/CanvasTile.tsx` keep
// the rules off via overrides — see the bottom of this file for why.
{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!pnpm-lock.yaml",
      "!apm.lock.yaml",
      "!AGENTS.md",
      "!CLAUDE.md",
      "!.claude/agents",
      "!.claude/commands",
      "!.claude/rules",
      "!.claude/skills",
      "!.claude/hooks",
      "!.claude/settings.json",
      "!.agents",
      "!.codex",
      "!.opencode",
      "!opencode.json",
      // apm-managed: `just ai::apm` rewrites .mcp.json with its own JSON
      // writer (multiline arrays), which fights biome's format on every
      // regeneration — the machine that owns the file owns its formatting.
      "!.mcp.json",
      // Claude Code dynamic-workflow scripts use top-level return/await and
      // runtime-injected globals (agent/phase/log/...) — they aren't valid
      // standalone ES modules, so biome can't parse them. Authored, not linted.
      "!**/*.workflow.js",
      "!**/dist",
      "!**/node_modules",
      "!**/.direnv",
      "!**/.logs",
      "!patches",
      // The dev-shell hook materializes this ignored path as a symlink into the
      // Nix store. CI source transfer can dereference it, so exclude the
      // generated font bundle explicitly rather than formatting store output.
      "!packages/client/public/fonts",
      // Astro files: frontmatter imports/consts are resolved inside the template
      // body, which Biome doesn't parse — lint + format would false-positive
      // and corrupt files. Astro has its own formatter (future: astro fmt).
      "!**/*.astro",
      // One-off heap-snapshot analyzers; not part of the product surface.
      "!docs/perf-investigations/scripts",
      // Top-level HTML files are design / plan artifacts, not shipping code.
      "!*.html"
    ]
  },
  // Biome is now the sole formatter — Prettier has been retired (#710).
  // Defaults mirror the old Prettier defaults (2-space indent, 80-column,
  // double quotes, semicolons, trailing commas) so the one-shot churn
  // from the flip is whitespace-minimal.
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    // `project` domain unlocks Biome's type-aware rules (Scanner-backed).
    // Per-rule opt-in: only the rules explicitly turned on below fire;
    // Scanner runs lazily for files touched by those rules.
    "domains": {
      "project": "all"
    },
    "rules": {
      "recommended": true,
      "nursery": {
        // Unawaited promises that silently swallow errors — the
        // flagship motivation for adopting Biome (#710).
        "noFloatingPromises": "error",
        // Type-aware exhaustiveness on discriminated unions — adding a
        // new variant forces every `switch` site to handle it.
        "useExhaustiveSwitchCases": "error",
        // Promises passed where `void` is expected — e.g. Solid
        // `<button onClick={asyncFn}>` silently swallows errors.
        "noMisusedPromises": "error"
      },
      "performance": {
        // Solid domain: prefer `<For each={…}>` over `items.map(…)` so
        // list reactivity is keyed properly instead of re-rendering on
        // every signal change.
        "useSolidForComponent": "error"
      },
      // `ci::biome` runs with `--error-on-warnings`, so there is no silent
      // advisory tier: every `recommended` rule either fails the build or is
      // explicitly turned off here (or scoped off in `overrides`) with the
      // reason it stays advisory. The baseline stays `recommended: true` so
      // rules promoted in future Biome releases surface on the next upgrade —
      // and, because the gate is strict, must be triaged (fix or off) in the
      // PR that bumps Biome rather than accruing as invisible debt (#1362).
      "suspicious": {
        // Terminal code legitimately parses ANSI escape sequences —
        // the rule is a permanent false positive against xterm diagnostics.
        "noControlCharactersInRegex": "off",
        // Promoted from the default `warn` after #1005 broke the 9 server
        // cycles via the `surfaceCtx.ts` holder pattern. As `error`, any
        // PR that re-introduces a cycle fails `just check` immediately —
        // the TDZ-on-import-reorder class becomes structurally impossible.
        "noImportCycles": "error"
      },
      "complexity": {
        // Tailwind `!important` overrides are intentional in kolu's
        // rare CSS escape-hatches.
        "noImportantStyles": "off"
      },
      "style": {
        // The `!` non-null assertion is a sanctioned escape hatch here:
        // `Map.get(k)` after a `.has(k)` guard, array indices the surrounding
        // code proves present, and similar spots where the value is known
        // non-null. Replacing them with runtime guards would only add branches
        // that can never execute. The load-bearing safety rules
        // (noFloatingPromises, noMisusedPromises, noImportCycles) are promoted
        // to `error` separately — `!` carries no such hazard, so it stays off
        // rather than advisory-but-unenforced.
        "noNonNullAssertion": "off",
        // The signals engine (`@preact/signals-core`) is a dependency of
        // `@kolu/surface` ONLY, wrapped by `reactor.ts` (the reactive bridge's
        // one exit from the backend graph into the cell machinery). Banning its
        // deep import everywhere else makes that wrapper the graph's only exit
        // BY CONSTRUCTION, not by review — so the engine stays swappable
        // (`@solidjs/signals` is the named target) behind one module. The two
        // sanctioned exceptions are `reactor.ts` itself and the engine-law test
        // (the engine's acceptance suite), re-allowed in `overrides` below.
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@preact/signals-core": "Do not import the signals engine directly — it is wrapped by @kolu/surface's reactor.ts (the graph's one exit). Import derived.cell / scan / source from ./reactor instead."
            }
          }
        }
      },
      "correctness": {
        // Project-domain rule: 293 sites of bare relative imports that
        // would need `.ts`/`.tsx` extensions. Kolu uses TS's
        // `moduleResolution: bundler` which resolves without extensions;
        // flipping this on is an independent migration.
        "useImportExtensions": "off",
        // Project-domain rule: 39 findings. Triggers on path-aliased
        // imports Biome's resolver doesn't understand the same way tsc
        // does; dedicated follow-up needed to align them.
        "noUnresolvedImports": "off"
      }
    }
  },
  "css": {
    // Kolu uses Tailwind v4 (`@theme`, `@plugin`, `@apply`) in both the
    // client and the website — without this flag the CSS parser rejects
    // those directives even on lint-only runs.
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      // `@kolu/acp` is built on `AgentSideConnection` / `ClientSideConnection`
      // from `@agentclientprotocol/sdk`, which the SDK marks `@deprecated` in
      // favour of its newer `agent()` / `client()` app model. They are exported,
      // documented, fully functional, and the SDK's OWN test suite still uses
      // them — this is a direction signal, not a removal.
      //
      // Adopting the app model is not a rename: it changes the programming
      // model on both faces of the proxy plus both test fixtures. Doing that in
      // the PR that introduced the package would have meant rewriting its
      // process-supervision core, unreviewed, immediately after the review
      // gauntlet that caught four lifetime bugs in exactly that code.
      //
      // So it is scoped off HERE and only here, and it is temporary: removing
      // this block is the completion signal for
      // https://github.com/juspay/kolu/issues/1989, which carries the migration
      // and its own review.
      "includes": ["packages/acp/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDeprecatedImports": "off"
          }
        }
      }
    },
    {
      // `defineSurface`'s generic machinery is a library over *heterogeneous*
      // descriptor maps: `Record<string, CellSpec<any, any>>` and the mapped
      // types that walk it. `unknown` can't stand in — a concrete
      // `CellSpec<Note>` is not assignable to `CellSpec<unknown>` in these
      // invariant container/constraint positions, so the spec object a caller
      // writes would stop type-checking. The `any`s are confined to this one
      // file — the generic type plumbing plus the single runtime
      // `(contract as any).surface` walk-by-string in `composeSurfaceContracts`
      // — and every value flows through Zod schemas at the edges, so the rule is
      // scoped off here rather than repo-wide.
      "includes": ["packages/surface/src/define.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      // vazhi is the repo's ONE React tree (Ink), not SolidJS — every other UI
      // package is Solid, which is why the Solid rules are on repo-wide.
      // `useSolidForComponent` exists to stop `.map` from recreating DOM nodes
      // in a Solid render; React's reconciler is keyed and this is the idiomatic
      // React list. Scoped off for this package rather than contorting the
      // component around a rule aimed at a different framework.
      "includes": ["packages/vazhi/**"],
      "linter": {
        "rules": {
          "performance": {
            "useSolidForComponent": "off"
          }
        }
      }
    },
    {
      // Test code uses idioms production code doesn't: async generators
      // that throw before yielding (error-path tests) and assign-in-expr
      // patterns (indexOf loops, Cucumber world-scratch fields).
      "includes": ["**/*.test.ts", "**/*.test.tsx", "packages/tests/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useYield": "off"
          },
          "suspicious": {
            "noAssignInExpressions": "off"
          }
        }
      }
    },
    {
      // Spatial-mouse canvas widgets: the minimap (drag-to-pan, click
      // empty space to recenter, drag tile rectangles to rearrange), the
      // canvas tile wrapper (mousedown to focus, drag-to-rearrange), and
      // the canvas surface itself (wheel/middle-drag to pan, double-click
      // the empty background to open the New terminal palette) are
      // inherently pointer-driven. Synthetic `role="button"` +
      // `tabIndex={0}` + a fake `onKeyDown` would *claim* keyboard
      // accessibility without delivering it — worse than no claim.
      //
      // Real keyboard navigation across terminals is provided by the
      // command palette (⌘K, fuzzy search), the pill tree (sidebar,
      // arrow-key tree nav), and the ⌘1..9 / ⌘J shortcuts. Those are
      // the canonical a11y entry points for tile selection; the canvas
      // is the visual layer they drive. (Double-click-to-create opens the
      // very same ⌘K palette, so its keyboard equivalent already exists.)
      "includes": [
        "packages/client/src/canvas/CanvasMinimap.tsx",
        "packages/client/src/canvas/CanvasTile.tsx",
        "packages/client/src/canvas/TerminalCanvas.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "noNoninteractiveElementInteractions": "off"
          }
        }
      }
    },
    {
      // The two sanctioned homes of the direct `@preact/signals-core` import:
      // `reactor.ts` is the wrapper (the graph's one exit), and the engine-law
      // test is the engine's acceptance suite — it must exercise the raw engine
      // to pin the guarantees (glitch-freedom, equality-cascade stop, disposal)
      // a swap to `@solidjs/signals` would have to reproduce. Everywhere else
      // the `style/noRestrictedImports` ban above stands.
      "includes": [
        "packages/surface/src/reactor.ts",
        "packages/surface/src/reactorEngineLaws.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
