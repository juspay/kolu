{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "enabled": true,
      "command": [
        ".agents/skills/nix-chrome-devtools-mcp/bin/serve"
      ]
    },
    "kolu": {
      "type": "local",
      "enabled": true,
      "command": [
        "kolu",
        "mcp"
      ],
      "env_vars": [
        "PADI_SOCKET"
      ]
    }
  }
}