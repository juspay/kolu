{
  "name": "@kolu/surface-app-example",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:server": "tsx --watch src/server/main.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "start": "tsx src/server/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@kolu/surface": "workspace:*",
    "@kolu/surface-app": "workspace:*",
    "effect": "catalog:",
    "solid-js": "^1.9.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
