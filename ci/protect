#!/usr/bin/env bash
# Set the branch's required status checks to the COMPLETE gate: odu's canonical
# DAG contexts PLUS the GitHub Actions contexts that guard the binary-cache warm.
#
#     ci/protect --dry-run            # print the complete required set
#     ci/protect --contexts-only      # print only this file's GHA contexts
#     ci/protect                      # apply it to the default branch
#     ci/protect --branch some-branch # …to another branch
#
# WHY THE APPEND LIVES HERE AND NOT IN A ONE-OFF `gh` CALL
# -------------------------------------------------------
# `odu protect` REPLACES `required_status_checks.contexts` with the list its
# canonical DAG produces. It has no extra-context flag, so anything added
# out-of-band survives exactly until the next person runs protect — which is
# the routine way this repo edits the gate. A context enrolled by hand is
# therefore not enrolled; it is scheduled for silent removal. Putting the
# append INSIDE the protect path makes "re-running protect drops it" unspellable.
#
# WHY THESE CONTEXTS ARE WORTH GATING ON
# --------------------------------------
# `.github/workflows/nix-cache.yml` is what pushes this repo's closures to
# https://cache.kolu.dev/kolu-r2. When it is green-but-not-required, a red or
# never-run cache push blocks nothing — and a deploy off that commit finds no
# agent closure in the cache and COMPILES the daemon on the remote host over
# ssh. That is not hypothetical: it happened (juspay/kolu#2101, G7) while the
# workflow sat there, unrequired, doing its job badly and nobody's merge caring.
# The cache warm is deploy-critical, so it belongs in the required set.
#
# THE CONTEXT NAMES ARE DERIVED FROM THE WORKFLOW, NEVER SPELLED HERE
# -------------------------------------------------------------------
# A check-run's name — which IS the branch-protection context string — is
# `<job-id> (<matrix value>)` for a single-dimension matrix job with no `name:`
# override. So the workflow file is the source of truth and this script parses
# it: EVERY job, each with one matrix dimension and one flow sequence of values
# (`build-and-push` warms the cache; `publish-closures` writes the closure
# index a trust-free remote dial reads — both deploy-critical, both gated). A hardcoded
# `build-and-push (macos-latest)` here would be a second source of truth that
# goes stale the day the job or the matrix is renamed — and it would go stale
# SILENTLY, by requiring a context nothing posts (which blocks every merge) or
# by dropping one nothing gates (which restores the incident above).
#
# Every departure from that shape is a HARD failure naming the workflow file.
# There is no partial extraction and no empty list: this script would rather
# refuse to touch branch protection than set a gate it cannot justify.
#
# ONE SHAPE IS EXEMPT, and only this one: a job whose `if:` says
# `github.event_name == 'push'` cannot run on a pull request, so it posts no
# check-run there and requiring it would block EVERY merge on a context nobody
# reports. `linux-pin` is that job — it starts the pod's run of master, which
# is meaningless on a PR. Such a job contributes no context and carries no
# matrix. Any OTHER `if:` is a hard failure: this parse will not guess when
# GitHub does and does not post a check-run.
#
# `yq` is not in this repo's dev shell (`nix develop`), so the parse is awk —
# deliberately, rather than as a fallback. A yq branch that never executes here
# is an untested parser, and an untested parser guarding a merge gate is worse
# than no parser at all.
#
# NOT RUN BY THE DAG. This is coordinator-side, like the `ci::protect` recipe
# that calls it: it edits GitHub's branch protection, which no CI node may do.
#
# No `mapfile`, no namerefs — same discipline as `ci/agent-substitutable`, so
# the scripts in this directory read alike (that one runs on GitHub's bash 3.2;
# this one only ever runs on the machine driving CI).

set -euo pipefail

die() {
  echo "ci/protect: $*" >&2
  exit 1
}

here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "${here}/.." && pwd)"
workflow="${root}/.github/workflows/nix-cache.yml"

case "${1:-}" in
  -h | --help)
    echo "usage: ci/protect [--dry-run | --contexts-only] [--branch B] [odu protect args…]"
    exit 2
    ;;
esac

# ── the derivation ───────────────────────────────────────────────────────────
# Emits one `<job> (<value>)` per line, or exits non-zero having said exactly
# which structural expectation the workflow no longer meets.
gha_contexts() {
  awk '
    function bail(msg) { print msg > "/dev/stderr"; exit 3 }

    # Full-line comments and blanks carry no structure.
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }

    {
      line = $0
      sub(/[[:space:]]+$/, "", line)
      match(line, /^ */)
      indent = RLENGTH
      key = line
      sub(/^ +/, "", key)
    }

    # Top level: we care about the `jobs:` mapping and nothing else.
    indent == 0 {
      in_jobs = (key == "jobs:")
      in_strategy = 0
      in_matrix = 0
      next
    }
    !in_jobs { next }

    # A job id. Every job is a gate; each is checked on its own below.
    indent == 2 {
      njobs++
      job = key
      sub(/:.*$/, "", job)
      jobs[njobs] = job
      in_strategy = 0
      in_matrix = 0
      next
    }

    # Job-level keys. A `name:` here renames every check-run, so the derivation
    # would be wrong in a way GitHub reports as "expected, never posted". An
    # `if:` decides whether the job runs on a pull request at all, which is the
    # event branch protection observes; it is read here and judged in END.
    indent == 4 {
      if (key ~ /^name:/) named[njobs] = 1
      if (key ~ /^if:/) {
        cond = key
        sub(/^if:[[:space:]]*/, "", cond)
        guard[njobs] = cond
      }
      in_strategy = (key == "strategy:")
      in_matrix = 0
      next
    }

    indent == 6 && in_strategy {
      in_matrix = (key == "matrix:")
      next
    }

    # A matrix dimension. Two of them and the check-run name becomes
    # `<job> (<a>, <b>)`, which this parse does not (and should not guess how to)
    # construct.
    indent == 8 && in_matrix {
      nmatrix[njobs]++
      mkey = key
      sub(/:.*$/, "", mkey)
      mval = key
      sub(/^[^:]*:[[:space:]]*/, "", mval)
      dimension[njobs] = mkey
      values[njobs] = mval
      next
    }

    END {
      if (njobs == 0) bail("no `jobs:` mapping with a job under it")
      for (j = 1; j <= njobs; j++) {
        job = jobs[j]
        # A push-only job posts nothing on a pull request, so it is not a
        # gateable context. Matched without a literal quote character: this
        # awk program lives inside a single-quoted shell string.
        if (guard[j] != "") {
          if (guard[j] ~ /github\.event_name[[:space:]]*==[[:space:]]*.push./) continue
          bail("job `" job "` has an `if:` this parse cannot reason about: " guard[j])
        }
        if (named[j]) bail("job `" job "` sets its own `name:`, which renames every check-run")
        if (nmatrix[j] != 1) bail("expected exactly 1 matrix dimension under job `" job "`, found " (nmatrix[j] + 0))
        vals = values[j]
        if (vals !~ /^\[.*\]$/) bail("matrix `" dimension[j] ":` of job `" job "` is not an inline [a, b] sequence")
        if (job !~ /^[A-Za-z0-9_.-]+$/) bail("job id `" job "` is not a plain identifier")

        gsub(/^\[|\]$/, "", vals)
        n = split(vals, v, ",")
        emitted = 0
        for (i = 1; i <= n; i++) {
          item = v[i]
          gsub(/^[[:space:]]*["'"'"']?|["'"'"']?[[:space:]]*$/, "", item)
          if (item == "") bail("matrix `" dimension[j] ":` of job `" job "` has an empty entry")
          if (item ~ /[()]/) bail("matrix value `" item "` cannot appear in a check-run name")
          print job " (" item ")"
          emitted++
          if (item ~ /ubuntu/) seen_linux = 1
          if (item ~ /macos/) seen_darwin = 1
        }
        if (emitted == 0) bail("matrix `" dimension[j] ":` of job `" job "` yields no contexts")
      }
      # The floor used to be TWO contexts per job, to catch a gate quietly
      # narrowed to one platform. That floor is wrong now: `build-and-push`
      # is deliberately `[macos-latest]` alone, because x86_64-linux is
      # warmed and verified on the odu lane (`ci::nix` pushes its `result*`
      # closures, `ci::cache-substitutable` asks the cache back) and that
      # lane contributes the other half of this required set.
      #
      # What it was really guarding survives one level up: ACROSS the whole
      # workflow, both platform families must stay gated. `publish-closures`
      # is the job that now carries it — nothing in the DAG posts the
      # closure index, so a narrowing there has no odu lane standing in for
      # it. Derived from the matrix values, so no job and no runner label is
      # hand-listed here.
      if (!seen_linux || !seen_darwin) bail("the workflow matrices cover only one platform family (linux: " (seen_linux + 0) ", darwin: " (seen_darwin + 0) ") — both must stay gated")
    }
  ' "$1"
}

# ── the parser's own door ────────────────────────────────────────────────────
# `ci/protect --contexts-only [WORKFLOW]` prints the derived contexts and
# stops, touching neither odu nor GitHub. It exists so the parse is EXECUTED
# by an automated check rather than only by an operator editing branch
# protection — the state this file's own header calls worse than no parser at
# all. `packages/daemon-test-gate/src/ci-parsers.test.ts` runs it against the
# real workflow and compares the output to the three names GitHub posts, and
# against a one-platform-family fixture it must refuse. A quoting regression
# in the awk program (one apostrophe closes it) is then red in CI, not at the
# gate.
#
# The optional WORKFLOW is why the refusal is testable at all: same shape as
# `ci/agent-substitutable [FLAKE]` — the question is parameterised by the
# thing being asked about, and defaults to this repo's own.
contexts_only=""
if [ "${1:-}" = "--contexts-only" ]; then
  contexts_only=1
  workflow="${2:-$workflow}"
fi

[ -f "$workflow" ] || die "no ${workflow} — the cache-warm contexts are derived from it, and it is gone"

if [ -n "$contexts_only" ]; then
  gha_contexts "$workflow"
  exit
fi

contexts=""
contexts="$(gha_contexts "$workflow")" || die "cannot derive the cache-warm contexts from ${workflow} (see above).
A check-run's name is '<job-id> (<matrix value>)'; this script requires every
job in that workflow to hold exactly one inline matrix dimension, except a
push-only job (an \`if:\` naming \`github.event_name == 'push'\`), which posts
no check-run on a pull request and is therefore gated on nothing.
Fix the workflow or teach this parse the new shape — do NOT let protect run
without these contexts: an unrequired cache push is how a deploy ends up
compiling the daemon over ssh (juspay/kolu#2101, G7)."

# Derived BEFORE odu touches anything: odu protect replaces the required list,
# so a parse that dies after it would leave the branch gated on the DAG alone —
# exactly the state this script exists to prevent.

# ── argument reading (pass-through, never consumed) ───────────────────────────
dry_run=""
branch=""
prev=""
for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=1 ;;
    --branch=*) branch="${arg#--branch=}" ;;
  esac
  [ "$prev" = "--branch" ] && branch="$arg"
  prev="$arg"
done

# ── odu's half: the canonical DAG contexts ───────────────────────────────────
# x86_64-linux is pinned here, not left to the caller, so the required list can
# never drift with a machine-local `hosts.json`. Darwin is NOT pinned: this repo
# gates on linux (see the ci skill). A caller who deliberately wants a darwin
# lane in the gate passes `--platform aarch64-darwin`, which forwards through
# "$@" and adds to — rather than replaces — the pin below.
nix run "${root}/ci#odu" -- ci protect --platform x86_64-linux "$@"

if [ -n "$dry_run" ]; then
  # odu printed the DAG contexts one per line; ours complete the set. Together
  # this is the authoritative "what must be green" list.
  printf '%s\n' "$contexts"
  exit 0
fi

# ── our half: append, then ASK whether it took ───────────────────────────────
command -v gh > /dev/null || die "gh is required to enrol the cache-warm contexts"

repo="$(gh repo view --json nameWithOwner -q .nameWithOwner)"
[ -n "$repo" ] || die "could not resolve owner/repo via gh"

if [ -z "$branch" ]; then
  branch="$(gh repo view --json defaultBranchRef -q .defaultBranchRef.name)"
  [ -n "$branch" ] || die "could not resolve ${repo}'s default branch via gh"
fi

echo "ci/protect: enrolling the ${workflow##*/} contexts on ${repo}@${branch}:"
# An ARRAY, not a string: every one of these names contains a space
# (`build-and-push (macos-latest)`), so an unquoted word-split would post two
# mangled contexts instead of one real one — and the read-back below would then
# fail on a branch whose gate had already been replaced.
gh_args=()
while IFS= read -r context; do
  [ -z "$context" ] && continue
  echo "  + ${context}"
  gh_args+=(-f "contexts[]=${context}")
done <<< "$contexts"

gh api -X POST "repos/${repo}/branches/${branch}/protection/required_status_checks/contexts" \
  "${gh_args[@]}" > /dev/null \
  || die "could not append the cache-warm contexts to ${repo}@${branch}"

# The POST is an instruction; this is the verdict. Same discipline as
# nix-cache.yml's own verify step — read the state back rather than trusting a
# 200.
required="$(gh api "repos/${repo}/branches/${branch}/protection/required_status_checks" -q '.contexts[]')"
while IFS= read -r context; do
  [ -z "$context" ] && continue
  printf '%s\n' "$required" | grep -qxF "$context" \
    || die "'${context}' is NOT in ${repo}@${branch}'s required contexts after the append.
The branch is now gated on the odu DAG alone, and a cold cache would merge
green. Re-run this script; if it fails again, the token or the ruleset — not
this repo — is refusing the write."
done <<< "$contexts"

echo "ci/protect: ${repo}@${branch} requires the odu DAG contexts + $(printf '%s\n' "$contexts" | wc -l | tr -d ' ') cache-warm contexts"
