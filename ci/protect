#!/usr/bin/env bash
# Set the branch's required status checks to the COMPLETE gate: odu's canonical
# DAG contexts PLUS the GitHub Actions contexts that guard the binary-cache warm.
# The two halves live in two different places GitHub enforces together:
#
#   ruleset            odu's `<recipe>@<platform>` DAG contexts (odu writes it)
#   classic protection EXACTLY this file's cache-warm contexts (this script)
#
#     ci/protect --dry-run            # print the complete required set
#     ci/protect --contexts-only      # print only this file's GHA contexts
#     ci/protect                      # apply it to the default branch
#     ci/protect --branch some-branch # …to another branch
#
# WHY TWO HOMES, AND WHY THE CLASSIC LIST IS REPLACED, NEVER APPENDED TO
# ---------------------------------------------------------------------
# `odu ci protect` writes the `required_status_checks` rule of the repository
# RULESET governing the branch, and nothing else — it never touches classic
# branch protection. That rule is odu's: its PUT replaces the ruleset's rules
# wholesale with the list its canonical DAG produces, and it has no
# extra-context flag, so a cache-warm context added to the ruleset by hand
# survives exactly until the next protect. A merge must satisfy the ruleset AND
# classic protection, so classic protection is where this script's half goes.
#
# And it is REPLACED, every run, with exactly the derived set — never appended
# to, never a copy of the `ci::*` list. An earlier version POSTed (appended)
# here, written for an odu that replaced the classic list itself. Once odu moved
# to the ruleset, nothing reset the classic list any more: the append hit a
# context already present and GitHub answered 422, and a context whose job no
# longer existed (`build-and-push (ubuntu-latest)`, after that matrix went
# darwin-only) stayed required — posted by nothing, it blocked every merge. A
# replace makes both unspellable: a second run is a no-op, and a renamed job's
# old context leaves the gate the next time anyone protects. No `ci::*` context
# belongs in the classic list either: a second copy of the ruleset's list goes
# stale, the same way, the day a recipe is renamed.
#
# THE CONTEXT NAMES ARE DERIVED FROM THE WORKFLOW, NEVER SPELLED HERE
# -------------------------------------------------------------------
# A check-run's name — which IS the branch-protection context string — is
# `<job-id> (<matrix value>)` for a single-dimension matrix job with no `name:`
# override. So the workflow file is the source of truth and this script parses
# it: EVERY job, each with one matrix dimension and one flow sequence of values
# (`build-and-push` warms the cache; `publish-closures` writes the closure
# index a trust-free remote dial reads — both deploy-critical, both gated). A hardcoded
# `build-and-push (macos-latest)` here would be a second source of truth that
# goes stale the day the job or the matrix is renamed — and it would go stale
# SILENTLY, by requiring a context nothing posts (which blocks every merge) or
# by dropping one nothing gates (which restores the incident above).
#
# Every departure from that shape is a HARD failure naming the workflow file.
# There is no partial extraction and no empty list: this script would rather
# refuse to touch branch protection than set a gate it cannot justify.
#
# ONE SHAPE IS EXEMPT, and only this one: a job whose `if:` says
# `github.event_name == 'push'` never runs on a pull request. GitHub reports it
# there as SKIPPED, which says nothing about the commit, so there is no result
# to gate on — and it carries no matrix, so this parse could not name a context
# for it anyway. `linux-pin` is that job: it starts the pod's run of master,
# which is meaningless on a PR. Any OTHER `if:` is a hard failure — this parse
# will not guess when a job does and does not really run.

set -euo pipefail

die() {
  echo "ci/protect: $*" >&2
  exit 1
}

here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "${here}/.." && pwd)"
workflow="${root}/.github/workflows/nix-cache.yml"

case "${1:-}" in
  -h | --help)
    echo "usage: ci/protect [--dry-run | --contexts-only] [--branch B] [odu protect args…]"
    exit 2
    ;;
esac

gha_contexts() {
  awk '
    function bail(msg) { print msg > "/dev/stderr"; exit 3 }

    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }

    {
      line = $0
      sub(/[[:space:]]+$/, "", line)
      match(line, /^ */)
      indent = RLENGTH
      key = line
      sub(/^ +/, "", key)
    }

    indent == 0 {
      in_jobs = (key == "jobs:")
      in_strategy = 0
      in_matrix = 0
      next
    }
    !in_jobs { next }

    indent == 2 {
      njobs++
      job = key
      sub(/:.*$/, "", job)
      jobs[njobs] = job
      in_strategy = 0
      in_matrix = 0
      next
    }

    indent == 4 {
      if (key ~ /^name:/) named[njobs] = 1
      if (key ~ /^if:/) {
        cond = key
        sub(/^if:[[:space:]]*/, "", cond)
        guard[njobs] = cond
      }
      in_strategy = (key == "strategy:")
      in_matrix = 0
      next
    }

    indent == 6 && in_strategy {
      in_matrix = (key == "matrix:")
      next
    }

    indent == 8 && in_matrix {
      nmatrix[njobs]++
      mkey = key
      sub(/:.*$/, "", mkey)
      mval = key
      sub(/^[^:]*:[[:space:]]*/, "", mval)
      dimension[njobs] = mkey
      values[njobs] = mval
      next
    }

    END {
      if (njobs == 0) bail("no `jobs:` mapping with a job under it")
      for (j = 1; j <= njobs; j++) {
        job = jobs[j]
        # A push-only job only ever skips on a pull request, so it is not a
        # gateable context. Matched without a literal quote character: this
        # awk program lives inside a single-quoted shell string.
        if (guard[j] != "") {
          if (guard[j] ~ /github\.event_name[[:space:]]*==[[:space:]]*.push./) continue
          bail("job `" job "` has an `if:` this parse cannot reason about: " guard[j])
        }
        if (named[j]) bail("job `" job "` sets its own `name:`, which renames every check-run")
        if (nmatrix[j] != 1) bail("expected exactly 1 matrix dimension under job `" job "`, found " (nmatrix[j] + 0))
        vals = values[j]
        if (vals !~ /^\[.*\]$/) bail("matrix `" dimension[j] ":` of job `" job "` is not an inline [a, b] sequence")
        if (job !~ /^[A-Za-z0-9_.-]+$/) bail("job id `" job "` is not a plain identifier")

        gsub(/^\[|\]$/, "", vals)
        n = split(vals, v, ",")
        emitted = 0
        for (i = 1; i <= n; i++) {
          item = v[i]
          gsub(/^[[:space:]]*["'"'"']?|["'"'"']?[[:space:]]*$/, "", item)
          if (item == "") bail("matrix `" dimension[j] ":` of job `" job "` has an empty entry")
          if (item ~ /[()]/) bail("matrix value `" item "` cannot appear in a check-run name")
          print job " (" item ")"
          emitted++
          if (item ~ /ubuntu/) seen_linux = 1
          if (item ~ /macos/) seen_darwin = 1
        }
        if (emitted == 0) bail("matrix `" dimension[j] ":` of job `" job "` yields no contexts")
      }
      if (!seen_linux || !seen_darwin) bail("the workflow matrices cover only one platform family (linux: " (seen_linux + 0) ", darwin: " (seen_darwin + 0) ") — both must stay gated")
    }
  ' "$1"
}

contexts_only=""
if [ "${1:-}" = "--contexts-only" ]; then
  contexts_only=1
  workflow="${2:-$workflow}"
fi

[ -f "$workflow" ] || die "no ${workflow} — the cache-warm contexts are derived from it, and it is gone"

if [ -n "$contexts_only" ]; then
  gha_contexts "$workflow"
  exit
fi

contexts=""
contexts="$(gha_contexts "$workflow")" || die "cannot derive the cache-warm contexts from ${workflow} (see above).
A check-run's name is '<job-id> (<matrix value>)'; this script requires every
job in that workflow to hold exactly one inline matrix dimension, except a
push-only job (an \`if:\` naming \`github.event_name == 'push'\`), which posts
no check-run on a pull request and is therefore gated on nothing.
Fix the workflow or teach this parse the new shape — do NOT let protect run
without these contexts: an unrequired cache push is how a deploy ends up
compiling the daemon over ssh (juspay/kolu#2101, G7)."

dry_run=""
branch=""
prev=""
for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=1 ;;
    --branch=*) branch="${arg#--branch=}" ;;
  esac
  [ "$prev" = "--branch" ] && branch="$arg"
  prev="$arg"
done

nix run "${root}/ci#odu" -- ci protect --platform x86_64-linux "$@"

if [ -n "$dry_run" ]; then
  printf '%s\n' "$contexts"
  exit 0
fi

command -v gh > /dev/null || die "gh is required to set the cache-warm contexts"

repo="$(gh repo view --json nameWithOwner -q .nameWithOwner)"
[ -n "$repo" ] || die "could not resolve owner/repo via gh"

if [ -z "$branch" ]; then
  branch="$(gh repo view --json defaultBranchRef -q .defaultBranchRef.name)"
  [ -n "$branch" ] || die "could not resolve ${repo}'s default branch via gh"
fi

classic="repos/${repo}/branches/${branch}/protection/required_status_checks"

lines() { if [ -n "$1" ]; then printf '%s\n' "$1"; fi; }
want="$(lines "$contexts" | LC_ALL=C sort -u)"
classic_contexts() { gh api "$classic" -q '.contexts[]' | LC_ALL=C sort; }

have="$(classic_contexts)" \
  || die "could not read ${repo}@${branch}'s classic required status checks"

if [ "$have" = "$want" ]; then
  echo "ci/protect: ${repo}@${branch}'s classic protection already requires exactly the ${workflow##*/} contexts"
else
  echo "ci/protect: setting ${repo}@${branch}'s classic required checks to exactly the ${workflow##*/} contexts:"
  LC_ALL=C comm -13 <(lines "$have") <(lines "$want") | sed 's/^/  + /'
  LC_ALL=C comm -23 <(lines "$have") <(lines "$want") | sed 's/^/  - /'
  # An ARRAY, not a string: every one of these names contains a space
  # (`build-and-push (macos-latest)`), so an unquoted word-split would send two
  # mangled contexts instead of one real one.
  gh_args=()
  while IFS= read -r context; do
    gh_args+=(-f "contexts[]=${context}")
  done <<< "$want"
  # PUT, not POST: this endpoint's PUT replaces the list (the header says why).
  gh api -X PUT "${classic}/contexts" "${gh_args[@]}" > /dev/null \
    || die "could not set the cache-warm contexts on ${repo}@${branch}"

  got="$(classic_contexts)" \
    || die "could not read back ${repo}@${branch}'s classic required status checks"
  [ "$got" = "$want" ] || die "${repo}@${branch}'s classic required checks are not exactly the ${workflow##*/} contexts.
expected:
$(lines "$want" | sed 's/^/  /')
GitHub has:
$(lines "$got" | sed 's/^/  /')
Re-run this script; if it fails again, the token or a ruleset — not this
repo — is refusing the write."
fi

echo "ci/protect: ${repo}@${branch}: the ruleset requires the odu DAG contexts; classic protection requires exactly the $(lines "$want" | wc -l | tr -d ' ') cache-warm contexts"
