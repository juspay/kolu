#!/usr/bin/env bash

set -euo pipefail

die() {
  echo "ci/protect: $*" >&2
  exit 1
}

here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "${here}/.." && pwd)"
workflow="${root}/.github/workflows/nix-cache.yml"

case "${1:-}" in
  -h | --help)
    echo "usage: ci/protect [--dry-run | --contexts-only] [--branch B] [odu protect args…]"
    exit 2
    ;;
esac

gha_contexts() {
  awk '
    function bail(msg) { print msg > "/dev/stderr"; exit 3 }

    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }

    {
      line = $0
      sub(/[[:space:]]+$/, "", line)
      match(line, /^ */)
      indent = RLENGTH
      key = line
      sub(/^ +/, "", key)
    }

    indent == 0 {
      in_jobs = (key == "jobs:")
      in_strategy = 0
      in_matrix = 0
      next
    }
    !in_jobs { next }

    indent == 2 {
      njobs++
      job = key
      sub(/:.*$/, "", job)
      jobs[njobs] = job
      in_strategy = 0
      in_matrix = 0
      next
    }

    indent == 4 {
      if (key ~ /^name:/) named[njobs] = 1
      if (key ~ /^if:/) {
        cond = key
        sub(/^if:[[:space:]]*/, "", cond)
        guard[njobs] = cond
      }
      in_strategy = (key == "strategy:")
      in_matrix = 0
      next
    }

    indent == 6 && in_strategy {
      in_matrix = (key == "matrix:")
      next
    }

    indent == 8 && in_matrix {
      nmatrix[njobs]++
      mkey = key
      sub(/:.*$/, "", mkey)
      mval = key
      sub(/^[^:]*:[[:space:]]*/, "", mval)
      dimension[njobs] = mkey
      values[njobs] = mval
      next
    }

    END {
      if (njobs == 0) bail("no `jobs:` mapping with a job under it")
      for (j = 1; j <= njobs; j++) {
        job = jobs[j]
        # Matched without a literal quote character: this awk program lives
        # inside a single-quoted shell string.
        if (guard[j] != "") {
          if (guard[j] ~ /github\.event_name[[:space:]]*==[[:space:]]*.push./) continue
          bail("job `" job "` has an `if:` this parse cannot reason about: " guard[j])
        }
        if (named[j]) bail("job `" job "` sets its own `name:`, which renames every check-run")
        if (nmatrix[j] != 1) bail("expected exactly 1 matrix dimension under job `" job "`, found " (nmatrix[j] + 0))
        vals = values[j]
        if (vals !~ /^\[.*\]$/) bail("matrix `" dimension[j] ":` of job `" job "` is not an inline [a, b] sequence")
        if (job !~ /^[A-Za-z0-9_.-]+$/) bail("job id `" job "` is not a plain identifier")

        gsub(/^\[|\]$/, "", vals)
        n = split(vals, v, ",")
        emitted = 0
        for (i = 1; i <= n; i++) {
          item = v[i]
          gsub(/^[[:space:]]*["'"'"']?|["'"'"']?[[:space:]]*$/, "", item)
          if (item == "") bail("matrix `" dimension[j] ":` of job `" job "` has an empty entry")
          if (item ~ /[()]/) bail("matrix value `" item "` cannot appear in a check-run name")
          print job " (" item ")"
          emitted++
          if (item ~ /ubuntu/) seen_linux = 1
          if (item ~ /macos/) seen_darwin = 1
        }
        if (emitted == 0) bail("matrix `" dimension[j] ":` of job `" job "` yields no contexts")
      }
      if (!seen_linux || !seen_darwin) bail("the workflow matrices cover only one platform family (linux: " (seen_linux + 0) ", darwin: " (seen_darwin + 0) ") — both must stay gated")
    }
  ' "$1"
}

contexts_only=""
if [ "${1:-}" = "--contexts-only" ]; then
  contexts_only=1
  workflow="${2:-$workflow}"
fi

[ -f "$workflow" ] || die "no ${workflow} — the cache-warm contexts are derived from it, and it is gone"

if [ -n "$contexts_only" ]; then
  gha_contexts "$workflow"
  exit
fi

contexts=""
contexts="$(gha_contexts "$workflow")" || die "cannot derive the cache-warm contexts from ${workflow} (see above).
A check-run's name is '<job-id> (<matrix value>)'; this script requires every
job in that workflow to hold exactly one inline matrix dimension, except a
push-only job (an \`if:\` naming \`github.event_name == 'push'\`), which posts
no check-run on a pull request and is therefore gated on nothing.
Fix the workflow or teach this parse the new shape — do NOT let protect run
without these contexts: an unrequired cache push is how a deploy ends up
compiling the daemon over ssh (juspay/kolu#2101, G7)."

dry_run=""
branch=""
prev=""
for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=1 ;;
    --branch=*) branch="${arg#--branch=}" ;;
  esac
  [ "$prev" = "--branch" ] && branch="$arg"
  prev="$arg"
done

nix run "${root}/ci#odu" -- ci protect --platform x86_64-linux "$@"

if [ -n "$dry_run" ]; then
  printf '%s\n' "$contexts"
  exit 0
fi

command -v gh > /dev/null || die "gh is required to set the cache-warm contexts"

repo="$(gh repo view --json nameWithOwner -q .nameWithOwner)"
[ -n "$repo" ] || die "could not resolve owner/repo via gh"

if [ -z "$branch" ]; then
  branch="$(gh repo view --json defaultBranchRef -q .defaultBranchRef.name)"
  [ -n "$branch" ] || die "could not resolve ${repo}'s default branch via gh"
fi

classic="repos/${repo}/branches/${branch}/protection/required_status_checks"

lines() { if [ -n "$1" ]; then printf '%s\n' "$1"; fi; }
want="$(lines "$contexts" | LC_ALL=C sort -u)"
classic_contexts() { gh api "$classic" -q '.contexts[]' | LC_ALL=C sort; }

have="$(classic_contexts)" \
  || die "could not read ${repo}@${branch}'s classic required status checks"

if [ "$have" = "$want" ]; then
  echo "ci/protect: ${repo}@${branch}'s classic protection already requires exactly the ${workflow##*/} contexts"
else
  echo "ci/protect: setting ${repo}@${branch}'s classic required checks to exactly the ${workflow##*/} contexts:"
  LC_ALL=C comm -13 <(lines "$have") <(lines "$want") | sed 's/^/  + /'
  LC_ALL=C comm -23 <(lines "$have") <(lines "$want") | sed 's/^/  - /'
  gh_args=()
  while IFS= read -r context; do
    gh_args+=(-f "contexts[]=${context}")
  done <<< "$want"
  # PUT, not POST: this endpoint's PUT replaces the list.
  gh api -X PUT "${classic}/contexts" "${gh_args[@]}" > /dev/null \
    || die "could not set the cache-warm contexts on ${repo}@${branch}"

  got="$(classic_contexts)" \
    || die "could not read back ${repo}@${branch}'s classic required status checks"
  [ "$got" = "$want" ] || die "${repo}@${branch}'s classic required checks are not exactly the ${workflow##*/} contexts.
expected:
$(lines "$want" | sed 's/^/  /')
GitHub has:
$(lines "$got" | sed 's/^/  /')
Re-run this script; if it fails again, the token or a ruleset — not this
repo — is refusing the write."
fi

echo "ci/protect: ${repo}@${branch}: the ruleset requires the odu DAG contexts; classic protection requires exactly the $(lines "$want" | wc -l | tr -d ' ') cache-warm contexts"
