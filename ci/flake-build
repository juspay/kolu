#!/usr/bin/env bash
# Build every derivation a flake exposes for the current system.
#
# Discovery is dynamic (attrNames of the flake's own outputs) so a new
# package/check/devShell is picked up with no recipe edit — the same
# auto-coverage property devour-flake had, without a GitHub-hosted helper.
# Kinds listed under --require are fail-loud when empty for this system.
#
# Usage:
#   ci/flake-build [options] FLAKE [-- NIX_ARGS...]
#
# Options:
#   --kinds KIND[,KIND...]     Output kinds to build (default: packages,checks,devShells)
#   --require KIND[,KIND...]   Kinds that must be non-empty (default: same as --kinds)
#   --nixos-toplevels          Also build same-system nixosConfigurations.*.config.system.build.toplevel
#                              (optional; empty is fine — Darwin has none)
#   --link                     Leave `result-*` out-links instead of --no-link, so a
#                              caller that collects build outputs from the filesystem
#                              (odu's post-recipe `result*` push) can see them
#
# NIX_ARGS (after --, or any --override-input / --accept-flake-config style flag
# once FLAKE is set) are passed to every `nix eval` and the final `nix build`.
#
# Examples:
#   ci/flake-build .
#   ci/flake-build --link --kinds packages,checks ./website
#   ci/flake-build --kinds checks --nixos-toplevels ./nix/home/example -- --override-input kolu .

set -euo pipefail

kinds=(packages checks devShells)
require=()
require_set=0
nixos_toplevels=0
link=0
flake=""
# Expanded as ${nix_args[@]:+"${nix_args[@]}"} at every use site, never as a
# bare "${nix_args[@]}". Under `set -u` above, bash BEFORE 4.4 treats an
# empty array's expansion as an unbound variable and dies. Every caller used to
# reach this script through a Nix-provided bash 5.x, so the bug was unreachable
# — until GitHub Actions' macos-latest image, whose /bin/bash is 3.2, became a
# caller (.github/workflows/nix-cache.yml). Linux passed, darwin died on the
# first `nix eval`.
nix_args=()

die() {
  echo "ci/flake-build: $*" >&2
  exit 1
}

# The header block above IS the help text — derived, never a line range, so
# editing the header cannot silently truncate `--help`.
usage() {
  awk 'NR > 1 && !/^#/ { exit } NR > 1' "$0" | sed 's/^# \?//'
  exit 2
}

# Splits $1 on commas into the fixed global `split_csv_out`. Callers copy it
# out; see the nix_args comment below for why this script must run on bash 3.2.
# A nameref (`local -n`, bash 4.3+) would read better and dies on macos-latest.
split_csv() {
  local IFS=,
  # shellcheck disable=SC2206
  split_csv_out=($1)
}

while (( $# > 0 )); do
  case "$1" in
    -h|--help) usage ;;
    --kinds)
      [[ $# -ge 2 ]] || die "--kinds needs an argument"
      split_csv "$2"
      kinds=(${split_csv_out[@]:+"${split_csv_out[@]}"})
      shift 2
      ;;
    --require)
      [[ $# -ge 2 ]] || die "--require needs an argument"
      split_csv "$2"
      require=(${split_csv_out[@]:+"${split_csv_out[@]}"})
      require_set=1
      shift 2
      ;;
    --nixos-toplevels)
      nixos_toplevels=1
      shift
      ;;
    --link)
      link=1
      shift
      ;;
    --)
      shift
      nix_args+=("$@")
      break
      ;;
    -*)
      die "unknown option: $1 (pass nix flags after --)"
      ;;
    *)
      if [[ -z $flake ]]; then
        flake=$1
        shift
      else
        die "unexpected argument: $1 (pass nix flags after --)"
      fi
      ;;
  esac
done

[[ -n $flake ]] || die "FLAKE is required (see --help)"
if (( require_set == 0 )); then
  require=("${kinds[@]}")
fi

system="$(nix eval --impure --raw --expr builtins.currentSystem)"

# Installable prefix: ".#foo" for the current flake, else "path#foo".
installable() {
  local attr=$1
  if [[ $flake == . ]]; then
    printf '.#%s\n' "$attr"
  else
    printf '%s#%s\n' "$flake" "$attr"
  fi
}

kind_required() {
  local kind=$1 r
  for r in "${require[@]}"; do
    [[ $r == "$kind" ]] && return 0
  done
  return 1
}

outputs=()

for kind in "${kinds[@]}"; do
  names="$(
    nix eval --raw "${flake}#${kind}.${system}" \
      ${nix_args[@]:+"${nix_args[@]}"} \
      --apply 'attrs: builtins.concatStringsSep "\n" (builtins.attrNames attrs)'
  )"
  count=0
  while IFS= read -r name; do
    [[ -z $name ]] && continue
    outputs+=("$(installable "${kind}.${system}.${name}")")
    ((count += 1))
  done <<< "$names"
  if (( count == 0 )) && kind_required "$kind"; then
    die "flake exposed no ${kind} outputs for ${system} (${flake})"
  fi
done

if (( nixos_toplevels )); then
  config_installables="$(
    nix eval --raw "${flake}#nixosConfigurations" \
      ${nix_args[@]:+"${nix_args[@]}"} \
      --apply "configs: builtins.concatStringsSep \"\\n\" (map (name: \"nixosConfigurations.\" + name + \".config.system.build.toplevel\") (builtins.filter (name: configs.\${name}.pkgs.stdenv.hostPlatform.system == \"$system\") (builtins.attrNames configs)))"
  )"
  while IFS= read -r attr; do
    [[ -z $attr ]] && continue
    outputs+=("$(installable "$attr")")
  done <<< "$config_installables"
fi

(( ${#outputs[@]} > 0 )) || die "nothing to build for ${system} (${flake})"

# --no-link, or an out-link prefix UNIQUE to this invocation.
#
# Under odu, a recipe's build outputs are collected from the filesystem after
# it exits 0 — the runner globs `result*` in the directory the recipe ran in
# (for this repo's `ci` module, `set working-directory := '..'`, i.e. the repo
# root) and pushes each closure to the cache `flake.nix`'s `nixConfig` names.
# A `--no-link` build leaves nothing to glob, so the lane warms nothing.
#
# The prefix must be unique per invocation because `ci::nix`, `ci::website-nix`
# and `ci::odu-nix` run CONCURRENTLY in that one directory and nix names a
# multi-output build `<prefix>`, `<prefix>-2`, … — a shared prefix would have
# three builds overwriting each other's links and pushing a partial set. Flake
# path plus kinds is exactly what distinguishes them:
#
#   .                 packages,checks,devShells  → result-root-packages-checks-devShells
#   ./website         packages,checks            → result-website-packages-checks
#   ./ci              packages                   → result-ci-packages
build_args=(--no-link)
if (( link )); then
  slug=${flake#./}
  slug=${slug%/}
  slug=${slug//[^A-Za-z0-9]/-}
  while [[ $slug == *--* ]]; do slug=${slug//--/-}; done
  slug=${slug#-}
  slug=${slug%-}
  [[ -n $slug ]] || slug=root
  for kind in "${kinds[@]}"; do
    slug="${slug}-${kind}"
  done
  if (( nixos_toplevels )); then
    slug="${slug}-nixos-toplevels"
  fi
  build_args=(--out-link "result-${slug}")
fi

nix build -L "${build_args[@]}" --print-out-paths \
  ${nix_args[@]:+"${nix_args[@]}"} \
  "${outputs[@]}"
