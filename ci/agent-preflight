#!/usr/bin/env bash
# Deploy-host pre-flight: realise the remote-agent closure for the artifact you
# are about to deploy, so no remote host ever compiles a daemon over ssh.
#
# Run it on the machine that will run kolu-server, against the same flake ref
# your deploy pins, BEFORE (or right after) switching:
#
#     ci/agent-preflight github:juspay/kolu/effect
#     ci/agent-preflight path:/home/me/code/kolu     # a local / dirty tree
#     ci/agent-preflight                             # cwd
#
# WHY A DEPLOY HAS TO DO THIS AT ALL
# ----------------------------------
# `padi-agent` is NOT in `.#default`'s closure — measured, it appears zero times
# in it. That is by construction: `padi-agent` CONTAINS `default`, so it cannot
# also be contained by it. A deploy therefore installs the kolu server plus the
# baked agent SOURCE, and never the built agent CLOSURE. The binder only learns
# that closure's store path later, at dial time, by evaluating the baked source
# — and then has to get the bits from somewhere.
#
# `@kolu/surface-remote` tries, in order (packages/surface-remote/src/nixCopy.ts):
#   1. prefetch  `nix copy --from <declared cache>` into the BINDER's store
#   2. ship      `nix copy --to ssh-ng://<host>` — of the LOCALLY-VALID closure
#   3. realise   on the host
# Step 2 is the one that moves binaries, and it can only ship what step 1 (or
# anything else) made locally valid. When the cache misses AND the binder's
# store is empty, step 3 is asked to produce the path from nothing and the host
# says `error: path '…' is required, but there is no substituter` — then
# compiles. That is the production incident, twice (juspay/kolu#2101 F5a, G7).
#
# WHY CI CANNOT COVER THIS, HONESTLY STATED
# -----------------------------------------
# `ci/agent-substitutable` in nix-cache.yml proves the cache holds a COMMIT's
# agent closure. A deploy is a different event, and it can precede that proof:
# deploy #2 shipped `beb2f7418` at 21:20:43 while the nix-cache run for that sha
# was created 21:25:38 and finished 21:35:00. `nix flake update` takes seconds;
# a two-platform matrix build takes tens of minutes. The operator can always
# outrun CI, can deploy a branch that has no open PR (nothing triggers the
# workflow at all), and can deploy a dirty working tree that no CI will ever
# see. No in-repo gate can produce a receipt about an artifact that does not
# exist anywhere but the deploy host.
#
# So this does not ASK whether the bits are somewhere. It PUTS them where
# provisioning reads from — the binder's own store — which needs no cache, no
# credentials, and no network beyond the build itself. Cache state becomes an
# optimisation for other binders instead of a precondition for this one.
#
# Bash 3.2 compatible; see `ci/flake-build`'s `nix_args` comment.

set -euo pipefail

die() {
  echo "ci/agent-preflight: $*" >&2
  exit 1
}

flake="${1:-.}"
case "$flake" in
  -h | --help)
    echo "usage: ci/agent-preflight [FLAKE]   (default: .)"
    exit 2
    ;;
esac
[ $# -le 1 ] || die "one FLAKE argument at most (got $#)"

here="$(cd "$(dirname "$0")" && pwd)"

# Resolve the artifact's own agent source, then read its inventory from INSIDE
# it — the same self-describing tree `ci/agent-substitutable` reads, so the two
# scripts cannot disagree about which packages a remote may resolve.
agent_flake_ref="$(nix build "${flake}#agent-flake-source" --no-link --print-out-paths --accept-flake-config)"

packages_json="${agent_flake_ref}/nix/agent-packages.json"
[ -f "$packages_json" ] || die "the baked agent source has no nix/agent-packages.json"
packages="$(jq -r '.expose[]' "$packages_json")"
[ -n "$packages" ] || die "${packages_json} exposes no agent packages"

system="$(nix eval --impure --raw --expr builtins.currentSystem)"

echo "ci/agent-preflight: ${flake} · ${system} · source ${agent_flake_ref}"
echo "realising the agent closure into this host's store (what provisioning ships from):"

# Build them in ONE `nix build` invocation, not a loop: the exposed agents share
# almost their entire closure, and one process lets nix schedule that once
# rather than re-deciding per package.
installables=""
while IFS= read -r package; do
  [ -z "$package" ] && continue
  installables="${installables} ${agent_flake_ref}#packages.${system}.${package}"
done <<< "$packages"

# shellcheck disable=SC2086  # deliberate word-splitting of the installable list
nix build -L --no-link --print-out-paths --accept-flake-config $installables \
  || die "could not realise the agent closure — a remote provisioned from this artifact WILL compile from source"

echo
echo "this host can now ship the agent closure to any remote without a cache."
echo "cache state (an optimisation for OTHER binders, not a precondition here):"

# Report, do not gate. The contract this script exists for — "no remote
# compiles from source" — is already met by the realise above; whether some
# cache also holds the bits is a different and weaker property, and conflating
# them would make this exit non-zero for a deploy that is in fact safe.
if bash "${here}/agent-substitutable" "$flake"; then
  echo "ci/agent-preflight: local store armed, and the cache is warm too"
else
  cat <<EOF

ci/agent-preflight: local store armed — THIS deploy is safe.
The cache does not (yet) hold this artifact's agent closure, so any OTHER
binder dialing these hosts would still build it. That is expected for a rev CI
has not warmed yet, and permanent for a local or dirty tree. If this rev is
pushed and has an open PR, the nix-cache run for its head sha will close it.
EOF
fi
