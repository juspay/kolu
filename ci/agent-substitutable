#!/usr/bin/env bash
# Assert that every remote-agent package a host can be provisioned with is
# actually SUBSTITUTABLE from the binary caches the agent source itself
# declares — i.e. that the closure a `--host` dial needs is in the cache before
# any host asks for it.
#
# WHY THIS EXISTS
# ---------------
# `@kolu/surface-remote` provisions a host by resolving
# `<SURFACE_AGENT_FLAKE_REF>#packages.<system>.<attr>` and prefetching that
# out-path from the caches baked into the source's `binary-cache.json`
# (`packages/surface-remote/src/nixCopy.ts:452-476`). When no declared cache
# has it, provisioning narrates
#
#     no agent closure at <url> (…)
#     no declared cache had the agent closure — realising from source instead
#
# (`nixCopy.ts:485-489`) and the target host COMPILES the daemon. That is a
# 2-second nuisance for a warm closure and an outage for a cold one — it was
# observed on a real production deploy (juspay/kolu#2101, F5(a)).
#
# `.github/workflows/nix-cache.yml` pushes every flake output to that cache, so
# "the push covers padi-agent" is true by construction. What was NOT true is
# that the push covered the COMMIT people deploy: on `pull_request` the job
# checked out `refs/pull/N/merge`, a synthetic tree nobody ever builds, so a
# branch head's agent closure was never warmed. This script is the assertion
# that closes the loop — it does not trust the push, it QUERIES the cache.
#
# EVERY INPUT IS DERIVED, NOTHING IS SPELLED TWICE
# ------------------------------------------------
#   * the source tree     — `.#agent-flake-source`, the same attr the binder
#                           wrappers bake and `ci::agent-flake-nix` evaluates
#   * the package list    — `nix/agent-packages.json`'s `expose` (kolu policy)
#   * the cache list      — the `binary-cache.json` sidecar INSIDE that source,
#                           derived from the agent flake's own `nixConfig`
#                           (`packages/surface-daemon/nix/binary-cache.nix`)
#   * the sidecar's name  — `packages/surface-remote/agent-env.json`, the same
#                           cross-language registry the TS reader uses
#                           (`packages/surface-remote/src/agentBinaryCache.ts:28`)
#
# So a newly exposed agent attr, or a newly declared cache, is covered the day
# it lands. A hand-listed `padi-agent` here would be a second source of truth
# that could go stale exactly the way the push set once did.
#
# SCOPE, STATED HONESTLY
# ----------------------
# This checks the TOP-LEVEL out-path of each exposed attr, not every closure
# member, and that is the right granularity for two reasons. It is precisely
# the condition whose absence produced the incident's log line. And `attic
# push` uploads CLOSURES by default (`--no-closure` is the opt-out), so a
# present top-level path implies its non-upstream members went with it; the
# members it deliberately skips are the ones already substitutable from
# cache.nixos.org, which every host reaches on its own.
#
# A hit on ANY declared cache passes, because that is provisioning's own
# contract — it tries each substituter in turn and stops at the first that
# answers. Requiring ALL of them would fail the day someone declares a cache
# this repo is not the publisher for.
#
# WHY THIS IS NOT AN `odu` CI RECIPE
# -----------------------------------
# It is deliberately NOT wired into `ci/mod.just`'s DAG. The odu lanes and the
# GitHub-hosted cache push run concurrently on the same commit, so an odu node
# asking "is this in the cache yet?" would be asking before the answer can be
# yes — a check that goes red for a reason unrelated to the change under
# review. It runs in `nix-cache.yml` AFTER that job's own `attic push`, where
# the answer is a real verdict about work the same job just did, and it runs by
# hand against any published build:
#
#     git checkout v1.2.3 && bash ci/agent-substitutable
#
# to answer "is the shipped release's agent path warm?" without deploying it.
#
# Bash 3.2 compatible (GitHub's macos-latest `/bin/bash`) — no `mapfile`, no
# namerefs. See `ci/flake-build`'s `nix_args` comment for the history there.

set -euo pipefail

die() {
  echo "ci/agent-substitutable: $*" >&2
  exit 1
}

[ -f nix/agent-packages.json ] || die "run from the repository root (no nix/agent-packages.json here)"

# The exact tree a remote resolves against — a store path, so this is the same
# flake ref the shipped wrappers bake, not a re-derivation of it.
agent_flake_ref="$(nix build .#agent-flake-source --no-link --print-out-paths --accept-flake-config)"

cache_file="$(jq -r '.binaryCacheFile' packages/surface-remote/agent-env.json)"
[ -n "$cache_file" ] && [ "$cache_file" != "null" ] \
  || die "packages/surface-remote/agent-env.json declares no binaryCacheFile"

cache_json="${agent_flake_ref}/${cache_file}"
[ -f "$cache_json" ] || die "the baked agent source has no ${cache_file} — provisioning would refuse it"

substituters="$(jq -r '.substituters[]' "$cache_json")"
[ -n "$substituters" ] || die "${cache_json} declares no substituters"

packages="$(jq -r '.expose[]' nix/agent-packages.json)"
[ -n "$packages" ] || die "nix/agent-packages.json exposes no agent packages"

system="$(nix eval --impure --raw --expr builtins.currentSystem)"

echo "ci/agent-substitutable: ${system} · source ${agent_flake_ref}"
echo "caches:"
# shellcheck disable=SC2086  # word-splitting one-per-line is the intent
printf '  %s\n' $substituters

missing=""
while IFS= read -r package; do
  [ -z "$package" ] && continue
  # `nix eval …outPath`, not `nix build`: this must report on the path the
  # cache is expected to hold, and must not quietly REALISE it locally — a
  # build here would mask the very absence we are testing for.
  out="$(nix eval --accept-flake-config --raw \
    "${agent_flake_ref}#packages.${system}.${package}.outPath" < /dev/null)"
  hit=""
  while IFS= read -r url; do
    [ -z "$url" ] && continue
    # `path-info` against the cache as a store: a narinfo lookup, no transfer.
    if nix path-info --store "$url" "$out" > /dev/null 2>&1 < /dev/null; then
      hit="$url"
      break
    fi
  done <<< "$substituters"
  if [ -n "$hit" ]; then
    echo "  ok      ${package} ${out}  ←  ${hit}"
  else
    echo "  MISSING ${package} ${out}" >&2
    missing="${missing}${package} "
  fi
done <<< "$packages"

if [ -n "$missing" ]; then
  cat >&2 <<EOF

ci/agent-substitutable: NOT SUBSTITUTABLE — ${missing}

Every host provisioned from this build will find no agent closure in any
declared cache and COMPILE the daemon from source over ssh instead (see
'no declared cache had the agent closure' in packages/surface-remote/src/nixCopy.ts).

Either the cache push for this commit has not run/succeeded, or it built a
different tree than this one. Check the nix-cache workflow run for THIS sha —
note it must check out the branch head, not a merge ref, or it warms a closure
no one deploys.
EOF
  exit 1
fi

echo "ci/agent-substitutable: every exposed agent package is substitutable"
