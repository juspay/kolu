---
/**
 * Responsive grid wrapper for <Card> / <LinkCard>. Two columns on wider
 * viewports, one on narrow.
 */
---

<div class="doc-cardgrid"><slot /></div>

<style>
  .doc-cardgrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }
  @media (max-width: 40rem) {
    .doc-cardgrid {
      grid-template-columns: 1fr;
    }
  }
</style>
