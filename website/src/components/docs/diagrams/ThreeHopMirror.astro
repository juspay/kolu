---
// ThreeHopMirror — a remote surface fronted by a local mirror in three hops:
// (1) dial over ssh, (2) pump frames into a local implementSurface,
// (3) re-serve that local copy. The browser always faces the LOCAL copy;
// only the pipe behind it swaps.
---

<figure class="doc-diagram">
  <svg
    viewBox="0 0 940 430"
    width="100%"
    height="auto"
    role="img"
    aria-labelledby="mirror-title mirror-desc"
  >
    <title id="mirror-title">Mirroring a surface over ssh in three hops</title>
    <desc id="mirror-desc">
      A remote agent serves its surface over stdio. The parent dials it over ssh
      (hop one), pumps its frames into a local implementSurface copy (hop two),
      and re-serves that copy over a direct or WebSocket link (hop three). The
      browser only ever faces the local copy; only the ssh pipe behind it swaps.
    </desc>

    <defs>
      <marker id="tm-arr" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7.5" markerHeight="7.5" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="context-stroke" />
      </marker>
    </defs>

    <!-- remote agent -->
    <rect x="26" y="120" width="176" height="118" rx="12"
      fill="color-mix(in srgb, var(--color-live-teal) 9%, var(--color-void-raised))"
      stroke="var(--color-kolu-bottom-strong)" stroke-width="1.6" />
    <text x="114" y="152" text-anchor="middle" font-family="var(--font-sans)" font-size="16.8" font-weight="700" fill="var(--color-ink)">remote agent</text>
    <text x="114" y="176" text-anchor="middle" font-family="var(--font-sans)" font-size="14" fill="var(--color-ink-muted)">serves its surface</text>
    <text x="114" y="196" text-anchor="middle" font-family="var(--font-sans)" font-size="14" fill="var(--color-ink-muted)">over stdio</text>
    <text x="114" y="220" text-anchor="middle" font-family="var(--font-sans)" font-size="14" fill="var(--color-kolu-bottom-strong)">the source of truth</text>

    <!-- parent process container -->
    <rect x="290" y="60" width="440" height="278" rx="14" fill="var(--color-void)" stroke="var(--color-rule-strong)" stroke-width="1.4" stroke-dasharray="2 3" />
    <text x="510" y="86" text-anchor="middle" font-family="var(--font-sans)" font-size="15.0" font-weight="700" fill="var(--color-ink-dim)">parent process</text>

    <!-- pump -->
    <rect x="312" y="108" width="176" height="96" rx="11"
      fill="color-mix(in srgb, var(--color-kolu-top-strong) 9%, var(--color-void-raised))"
      stroke="var(--color-kolu-top-strong)" stroke-width="1.6" />
    <text x="400" y="136" text-anchor="middle" font-family="var(--font-sans)" font-size="16.2" font-weight="700" fill="var(--color-ink)">② pump</text>
    <text x="400" y="158" text-anchor="middle" font-family="var(--font-mono)" font-size="14" fill="var(--color-ink-muted)">pumpRemoteSurface</text>
    <text x="400" y="176" text-anchor="middle" font-family="var(--font-sans)" font-size="14" fill="var(--color-ink-muted)">folds frames into</text>
    <text x="400" y="192" text-anchor="middle" font-family="var(--font-mono)" font-size="14" fill="var(--color-ink-muted)">implementSurface</text>

    <!-- local copy -->
    <rect x="530" y="108" width="176" height="96" rx="11"
      fill="color-mix(in srgb, var(--color-live-teal) 12%, var(--color-void-raised))"
      stroke="var(--color-kolu-bottom-strong)" stroke-width="1.8" />
    <text x="618" y="140" text-anchor="middle" font-family="var(--font-sans)" font-size="16.2" font-weight="700" fill="var(--color-ink)">the LOCAL copy</text>
    <text x="618" y="163" text-anchor="middle" font-family="var(--font-sans)" font-size="14" fill="var(--color-ink-muted)">a live mirror of</text>
    <text x="618" y="181" text-anchor="middle" font-family="var(--font-sans)" font-size="14" fill="var(--color-ink-muted)">everything served</text>

    <!-- re-serve -->
    <rect x="400" y="248" width="238" height="66" rx="11"
      fill="color-mix(in srgb, var(--color-kolu-top-strong) 9%, var(--color-void-raised))"
      stroke="var(--color-kolu-top-strong)" stroke-width="1.6" />
    <text x="519" y="274" text-anchor="middle" font-family="var(--font-sans)" font-size="16.2" font-weight="700" fill="var(--color-ink)">③ re-serve</text>
    <text x="519" y="296" text-anchor="middle" font-family="var(--font-mono)" font-size="14" fill="var(--color-ink-muted)">directLink / ws</text>

    <!-- browser -->
    <rect x="792" y="120" width="122" height="118" rx="12"
      fill="color-mix(in srgb, var(--color-kolu-primary) 8%, var(--color-void-raised))"
      stroke="var(--color-kolu-primary)" stroke-width="1.8" />
    <text x="853" y="164" text-anchor="middle" font-family="var(--font-sans)" font-size="16.8" font-weight="700" fill="var(--color-ink)">browser</text>
    <text x="853" y="188" text-anchor="middle" font-family="var(--font-sans)" font-size="14" fill="var(--color-ink-muted)">faces the</text>
    <text x="853" y="204" text-anchor="middle" font-family="var(--font-sans)" font-size="14" fill="var(--color-ink-muted)">local copy</text>

    <!-- hop 1: dial (the swappable pipe) -->
    <path d="M202 179 L 308 158" fill="none" stroke="var(--color-kolu-primary)" stroke-width="2.2" stroke-dasharray="6 4" marker-end="url(#tm-arr)" />
    <text x="255" y="140" text-anchor="middle" font-family="var(--font-sans)" font-size="14.4" font-weight="700" fill="var(--color-ink)">① dial</text>
    <text x="255" y="235" text-anchor="middle" font-family="var(--font-sans)" font-size="14" fill="var(--color-ink-muted)">ssh · makeSession</text>
    <text x="255" y="249" text-anchor="middle" font-family="var(--font-mono)" font-size="14" fill="var(--color-ink-muted)">+ sshConnector</text>
    <text x="255" y="270" text-anchor="middle" font-family="var(--font-sans)" font-size="14" fill="var(--color-kolu-primary)">this pipe swaps</text>

    <!-- pump -> local copy -->
    <path d="M488 156 L 528 156" fill="none" stroke="var(--color-live-teal)" stroke-width="2" marker-end="url(#tm-arr)" />
    <text x="509" y="146" text-anchor="middle" font-family="var(--font-sans)" font-size="14" fill="var(--color-ink-muted)">folds in</text>

    <!-- local copy -> re-serve -->
    <path d="M600 204 C 590 224, 560 232, 545 246" fill="none" stroke="var(--color-live-teal)" stroke-width="2" marker-end="url(#tm-arr)" />

    <!-- re-serve -> browser (hop 3) -->
    <path d="M638 281 C 730 281, 760 210, 788 190" fill="none" stroke="var(--color-kolu-primary)" stroke-width="2.2" marker-end="url(#tm-arr)" />

    <!-- load-bearing bracket -->
    <path d="M530 356 L 530 366 L 900 366 L 900 356" fill="none" stroke="var(--color-kolu-bottom-strong)" stroke-width="1.4" />
    <text x="715" y="392" text-anchor="middle" font-family="var(--font-sans)" font-size="14.4" font-weight="700" fill="var(--color-ink)">the browser always faces the LOCAL copy</text>
    <text x="715" y="410" text-anchor="middle" font-family="var(--font-sans)" font-size="14" fill="var(--color-ink-muted)">only the pipe behind it swaps</text>
  </svg>
  <figcaption>
    The remote agent serves over stdio; the parent{" "}
    <strong>① dials</strong> it over ssh, <strong>② pumps</strong> its frames
    into a local <code>implementSurface</code>, and <strong>③ re-serves</strong>{" "}
    that copy to the browser. The browser only ever talks to the local copy —
    only the ssh pipe behind it swaps.
  </figcaption>
</figure>

<style>
  .doc-diagram {
    margin: 1.75rem 0;
    max-width: 100%;
    text-align: center;
  }
  .doc-diagram svg {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-rule);
    border-radius: 0.75rem;
    background: var(--color-void-sunk);
  }
  .doc-diagram figcaption {
    margin: 0.6rem 0 0;
    color: var(--color-ink-muted);
    font-size: 0.86rem;
    line-height: 1.55;
    text-align: left;
  }
</style>
