---
/**
 * "On this page" table of contents — built from the headings Astro's render()
 * returns for the page. Lists the section headings (h2) and links to their
 * auto-generated anchors. Sticky on wide viewports; hidden on narrow ones where
 * vertical space is scarce (the sidebar disclosure covers navigation there).
 */
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  variant?: "rail" | "inline";
}
const { headings, variant = "rail" } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{
  items.length > 0 && (
    <nav class:list={["docs-toc", `docs-toc--${variant}`]} aria-label="On this page">
      <p class="docs-toc__label">On this page</p>
      <ul>
        {items.map((h) => (
          <li>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .docs-toc {
    font-size: 0.85rem;
  }
  .docs-toc--rail {
    position: sticky;
    top: 4.5rem;
  }
  .docs-toc--inline {
    margin: -0.85rem 0 1.7rem;
    border: 1px solid var(--color-rule);
    border-radius: 0.55rem;
    padding: 0.85rem 1rem;
    background: color-mix(in srgb, var(--color-void-raised) 70%, transparent);
  }
  .docs-toc__label {
    margin: 0 0 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .docs-toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .docs-toc a {
    color: var(--color-ink-dim);
    text-decoration: none;
    line-height: 1.4;
    transition: color 120ms ease;
  }
  .docs-toc a:hover {
    color: var(--color-kolu-primary);
  }
  @media (max-width: 72rem) {
    .docs-toc--rail {
      display: none;
    }
  }
  @media (min-width: 72.001rem) {
    .docs-toc--inline {
      display: none;
    }
  }
</style>
