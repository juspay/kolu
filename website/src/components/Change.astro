---
/**
 * One changelog entry as a single dense row: the title on the left and the PR
 * chip cluster flush to the right margin, so every row is one scannable line.
 * The description is collapsed by default and unfolds beneath the title on hover
 * / keyboard focus (desktop) or tap (touch), so a release reads as a tight list
 * of headlines you expand only where curious. Touch devices with JS off keep
 * descriptions always visible. Entries are categorised by the `#### [Page](…)`
 * heading they sit under in the changelog MDX, so a row carries no tags of its
 * own.
 *
 *   ### Fixed
 *
 *   #### [Core Concepts](/concepts)
 *
 *   - <Change title="Terminals no longer silently freeze" pr={1235}>A WebSocket
 *     that died without notice … resumes without a reload.</Change>
 *
 * One entry can cite MORE than one PR. When an unreleased feature or fix is
 * iterated across several PRs, they fold into a SINGLE entry that carries every
 * contributing PR — `prs={[…]}` renders a chip per PR:
 *
 *   - <Change title="Work across several machines" prs={[1675, 1714, 1743]}>
 *     Point kolu at another machine over ssh …</Change>
 *
 * `pr={n}` stays the shorthand for the common single-PR entry; pass `pr` OR
 * `prs`, never both. Used as the content of a Markdown list item
 * (`- <Change …>…</Change>`), so the `<ul>/<li>` come from `.prose-changelog`;
 * this component owns the whole row — its own `→` bullet (which swings to `↓`
 * while expanded), the PR chip cluster, and the collapse. Auto-injected into
 * changelog MDX (see `changelog.astro`'s `components` prop), so entries need no
 * import. `repo` / `state` pass straight through to every `<PR>` (default: a
 * merged juspay/kolu pull).
 */
import PR from "./PR.astro";

interface Props {
  title: string;
  pr?: number;
  prs?: number[];
  repo?: string;
  state?: "merged" | "open" | "closed";
}

const { title, pr, prs, repo, state } = Astro.props;

// One id list, whether the entry used the single-PR shorthand `pr` or the
// multi-PR `prs`. Fail loud on misuse rather than silently rendering a wrong or
// empty chip cluster: both props at once is ambiguous, and an empty `prs` is a
// forgotten value, not "no PR".
if (pr !== undefined && prs !== undefined)
  throw new Error(`<Change title="${title}">: pass either \`pr\` or \`prs\`, not both`);
if (prs !== undefined && prs.length === 0)
  throw new Error(`<Change title="${title}">: \`prs\` is empty — give at least one PR, or use \`pr\``);
const prIds = prs ?? (pr !== undefined ? [pr] : []);
---

<div class="cl-change" tabindex="0">
  <p class="cl-change-head">
    <span class="cl-change-arrow" aria-hidden="true">→</span>
    <span class="cl-change-title">{title}</span>
    <span class="cl-change-meta">
      {prIds.map((id) => <PR id={id} repo={repo} state={state} />)}
    </span>
  </p>
  <div class="cl-change-reveal">
    <div class="cl-change-desc"><slot /></div>
  </div>
</div>

<style>
  /* A dense full-width row. The hover band bleeds a touch past the text on
     both sides (negative inline margin + matching padding) so hovering lights
     up the whole line, arrow included, without shifting the layout. */
  .cl-change {
    position: relative;
    margin: 0 -0.55rem;
    padding: 0.22rem 0.55rem;
    border-radius: 5px;
    outline: none;
    transition: background 0.15s ease;
  }
  /* Headline: arrow | title | right-grouped metadata, all on one baseline. */
  .cl-change-head {
    display: grid;
    grid-template-columns: 0.85rem minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: 0.5rem;
    margin: 0;
    line-height: 1.4;
  }
  .cl-change-arrow {
    font-family: var(--font-mono, ui-monospace, monospace);
    color: var(--color-ink-faint);
    transition:
      transform 0.2s ease,
      color 0.2s ease;
  }
  .cl-change-title {
    color: var(--color-ink);
    font-weight: 550;
    font-size: 0.92rem;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }
  /* The PR chip cluster, flush right so the chips align down the page. Wraps
     under the title on a narrow screen. */
  .cl-change-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: flex-end;
    gap: 0.3rem;
  }
  /* Touch / no-JS fallback: an inline collapse (grid 0fr→1fr) that animates to
     the description's natural height with no magic max-height. Indented under
     the title, clear of the arrow column. Pointer devices replace this with a
     floating popover below (see @media (hover: hover)). */
  .cl-change-reveal {
    display: grid;
    grid-template-rows: 0fr;
    padding-left: 1.35rem;
    transition: grid-template-rows 0.22s ease;
  }
  .cl-change-desc {
    overflow: hidden;
    min-height: 0;
    color: var(--color-ink-muted);
    font-size: 0.86rem;
    line-height: 1.5;
    opacity: 0;
    transition: opacity 0.22s ease;
  }
  /* Pointer devices: the description is a floating card anchored under the row.
     Absolutely positioned, so opening it overlays the rows below instead of
     shoving them down — no reflow, no list jump. It fades and lifts into place
     on a transform (cheap to animate), and the row is raised above its
     neighbours so the card is never clipped by a later row. */
  @media (hover: hover) {
    .cl-change-reveal {
      position: absolute;
      top: 100%;
      left: 1rem;
      z-index: 1;
      display: block;
      width: min(42rem, calc(100% - 1rem));
      margin-top: 0.3rem;
      padding: 0.55rem 0.85rem 0.65rem;
      background: var(--color-void-raised);
      border: 1px solid var(--color-rule-strong);
      border-radius: 8px;
      box-shadow:
        0 1px 2px rgb(0 0 0 / 0.08),
        0 14px 30px -10px rgb(0 0 0 / 0.22);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-4px);
      transition:
        opacity 0.16s ease,
        transform 0.16s ease,
        visibility 0s linear 0.16s;
      pointer-events: none;
    }
    .cl-change-desc {
      overflow: visible;
      opacity: 1;
      transition: none;
    }
    .cl-change:hover,
    .cl-change:focus-within {
      background: var(--color-void-raised);
      z-index: 20;
    }
    .cl-change:hover .cl-change-reveal,
    .cl-change:focus-within .cl-change-reveal {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition-delay: 0s;
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: reduce) {
    .cl-change-reveal {
      transform: none;
      transition:
        opacity 0.12s ease,
        visibility 0s linear 0.12s;
    }
    .cl-change:hover .cl-change-reveal,
    .cl-change:focus-within .cl-change-reveal {
      transform: none;
    }
  }
  /* No hover to reveal with (touch): the script below makes rows tap-to-toggle
     (`.cl-tap` collapses, `.open` expands). Without JS, `.cl-tap` is never
     added and descriptions stay open. */
  @media (hover: none) {
    .cl-change:not(.cl-tap) .cl-change-reveal,
    .cl-change.open .cl-change-reveal {
      grid-template-rows: 1fr;
    }
    .cl-change:not(.cl-tap) .cl-change-desc,
    .cl-change.open .cl-change-desc {
      opacity: 1;
    }
    .cl-change.open .cl-change-arrow {
      transform: translateX(1px) rotate(90deg);
      color: var(--color-kolu-primary);
    }
    .cl-change.cl-tap .cl-change-head {
      cursor: pointer;
    }
  }
  /* Breathing room between headline and unfolded description — lives INSIDE
     the clipped box so the collapsed row stays exactly headline-height. */
  .cl-change-desc > :global(:first-child) {
    margin-top: 0.3rem;
  }
  .cl-change-desc :global(p) {
    margin: 0;
  }
  .cl-change-desc :global(p + p) {
    margin-top: 0.5rem;
  }
</style>

<script>
  // Touch devices have no hover to reveal descriptions with — make each row
  // tap-to-toggle instead. Gated on (hover: none) so desktop keeps pure-CSS
  // hover; without JS this never runs and the CSS leaves descriptions open.
  if (matchMedia("(hover: none)").matches) {
    for (const row of document.querySelectorAll(".cl-change")) {
      row.classList.add("cl-tap");
      row.addEventListener("click", (e) => {
        // Let the PR chip stay a plain link tap, and tag chips filter.
        if (e.target instanceof Element && e.target.closest("a, button"))
          return;
        row.classList.toggle("open");
      });
    }
  }
</script>
