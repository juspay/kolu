---
/**
 * A changelog note with three levels of detail:
 *
 *   1. the product-facing headline is always visible;
 *   2. the plain-language explanation opens on demand with native <details>;
 *   3. implementation PRs sit in the open note's provenance footer.
 *
 * Keeping PRs out of the collapsed row is intentional. A changelog is for
 * understanding the product first; the source links remain one click away for
 * readers who want the archaeology.
 *
 *   ### Fixed
 *
 *   #### [Core Concepts](/concepts)
 *
 *   - <Change title="Terminals no longer silently freeze" pr={1235}>A
 *     WebSocket that died without notice … resumes without a reload.</Change>
 *
 * One note may cite several PRs when an unreleased feature was refined across
 * multiple changes. Pass `pr` OR `prs`, never both. Omitting both is valid for
 * release notes whose implementation history is not represented by one PR.
 */
import PR from "./PR.astro";

interface Props {
  title: string;
  pr?: number;
  prs?: number[];
  repo?: string;
  state?: "merged" | "open" | "closed";
}

const { title, pr, prs, repo, state } = Astro.props;

if (pr !== undefined && prs !== undefined)
  throw new Error(`<Change title="${title}">: pass either \`pr\` or \`prs\`, not both`);
if (prs !== undefined && prs.length === 0)
  throw new Error(`<Change title="${title}">: \`prs\` is empty — give at least one PR, or omit it`);

const prIds = prs ?? (pr !== undefined ? [pr] : []);
const provenanceLabel = prIds.length === 1 ? "1 PR" : `${prIds.length} PRs`;
---

<details class="cl-change">
  <summary>
    <span class="cl-change-toggle" aria-hidden="true">
      <span></span>
    </span>
    <span class="cl-change-title">{title}</span>
    {prIds.length > 0 && <span class="cl-change-count">{provenanceLabel}</span>}
    <span class="cl-change-match" data-search-preview hidden></span>
  </summary>

  <div class="cl-change-body">
    <div class="cl-change-desc"><slot /></div>
    {
      prIds.length > 0 && (
        <footer class="cl-change-source">
          <span class="cl-change-source-label">Shipped in</span>
          <span class="cl-change-prs">
            {prIds.map((id) => <PR id={id} repo={repo} state={state} />)}
          </span>
        </footer>
      )
    }
  </div>
</details>

<style>
  .cl-change {
    --note-accent: var(--color-kolu-primary);
    border-top: 1px solid var(--color-rule);
    transition:
      background 160ms ease,
      border-color 160ms ease;
  }

  .cl-change[open] {
    border-color: color-mix(
      in srgb,
      var(--note-accent) 32%,
      var(--color-rule)
    );
    background: color-mix(
      in srgb,
      var(--note-accent) 4%,
      var(--color-void-raised)
    );
  }

  summary {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.35rem;
    padding: 0.7rem 0.25rem;
    color: var(--color-ink);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 2px solid var(--color-kolu-primary);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .cl-change-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    border: 1px solid var(--color-rule-strong);
    border-radius: 2px;
    color: var(--color-ink-muted);
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background 160ms ease;
  }

  .cl-change-toggle::before,
  .cl-change-toggle::after {
    content: "";
    position: absolute;
    width: 0.48rem;
    height: 1px;
    background: currentColor;
    transition: transform 180ms ease;
  }

  .cl-change-toggle::after {
    transform: rotate(90deg);
  }

  .cl-change[open] .cl-change-toggle {
    color: var(--color-void);
    border-color: var(--note-accent);
    background: var(--note-accent);
  }

  .cl-change[open] .cl-change-toggle::after {
    transform: rotate(0deg);
  }

  .cl-change-title {
    font-size: 0.98rem;
    font-weight: 560;
    letter-spacing: -0.012em;
    line-height: 1.4;
    transition: color 150ms ease;
  }

  .cl-change-count {
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .cl-change-match {
    grid-column: 2 / -1;
    margin-top: -0.4rem;
    padding: 0 0 0.2rem;
    color: var(--color-ink-muted);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .cl-change-match[hidden] {
    display: none;
  }

  .cl-change-match :global(mark) {
    padding: 0 0.12em;
    color: var(--color-void);
    background: var(--color-kolu-top-strong);
    border-radius: 2px;
  }

  summary:hover .cl-change-title,
  .cl-change[open] .cl-change-title {
    color: var(--note-accent);
  }

  .cl-change-body {
    max-width: 48rem;
    padding: 0 1.5rem 1.25rem 2.25rem;
  }

  .cl-change-desc {
    color: var(--color-ink-dim);
    font-size: 0.92rem;
    line-height: 1.68;
    animation: note-in 180ms ease both;
  }

  .cl-change-desc :global(p) {
    margin: 0;
  }

  .cl-change-desc :global(p + p) {
    margin-top: 0.75rem;
  }

  .cl-change-desc :global(strong) {
    color: var(--color-ink);
    font-weight: 620;
  }

  .cl-change-source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 0.7rem;
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-rule);
  }

  .cl-change-source-label {
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .cl-change-prs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  @keyframes note-in {
    from {
      opacity: 0;
      transform: translateY(-3px);
    }
  }

  @media (max-width: 620px) {
    summary {
      grid-template-columns: 1.15rem minmax(0, 1fr);
      gap: 0.65rem;
      min-height: 3.1rem;
      padding-block: 0.62rem;
    }

    .cl-change-count {
      grid-column: 2;
      margin-top: -0.45rem;
      padding-bottom: 0.15rem;
    }

    .cl-change-match {
      grid-column: 2;
      margin-top: -0.35rem;
    }

    .cl-change-body {
      padding: 0 0.3rem 1.15rem 1.8rem;
    }

    .cl-change-desc {
      font-size: 0.9rem;
      line-height: 1.62;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cl-change,
    .cl-change-toggle,
    .cl-change-toggle::after,
    .cl-change-title {
      transition: none;
    }

    .cl-change-desc {
      animation: none;
    }
  }
</style>
