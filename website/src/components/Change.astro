---
/**
 * A changelog note with three levels of detail:
 *
 *   1. the product-facing headline is always visible;
 *   2. the plain-language explanation opens on demand with native <details>;
 *   3. implementation PRs sit in the open note's provenance footer.
 *
 * Keeping PRs out of the collapsed row is intentional. A changelog is for
 * understanding the product first; the source links remain one click away for
 * readers who want the archaeology.
 *
 *   ### Core Concepts
 *
 *   - <Change kind="fixed" title="Terminals no longer silently freeze" pr={1235}>A
 *     WebSocket that died without notice … resumes without a reload.</Change>
 *
 * One note may cite several PRs when an unreleased feature was refined across
 * multiple changes. Pass `pr` OR `prs`, never both. Omitting both is valid for
 * release notes whose implementation history is not represented by one PR.
 */
import PR from "./PR.astro";
import { CHANGE_KIND_LABELS, type ChangeKind } from "../changelog";

interface ChangeProps {
  kind: ChangeKind;
  title: string;
  repo?: string;
  state?: "merged" | "open" | "closed";
}

type Props = ChangeProps &
  (
    | { pr?: never; prs?: never }
    | { pr: number; prs?: never }
    | { pr?: never; prs: readonly [number, ...number[]] }
  );

const { kind, title, repo, state } = Astro.props;
const kindLabel = CHANGE_KIND_LABELS[kind];
const prIds = Astro.props.prs ?? (Astro.props.pr === undefined ? [] : [Astro.props.pr]);

const provenanceLabel = prIds.length === 1 ? "1 PR" : `${prIds.length} PRs`;
---

<details class="cl-change" data-kind={kind}>
  <summary>
    <span class="cl-change-toggle" aria-hidden="true"></span>
    <span class="cl-change-kind">{kindLabel}</span>
    <span class="cl-change-title">{title}</span>
    {prIds.length > 0 && <span class="cl-change-count">{provenanceLabel}</span>}
    <span class="cl-change-match" data-search-preview hidden></span>
  </summary>

  <div class="cl-change-body">
    <div class="cl-change-desc"><slot /></div>
    {
      prIds.length > 0 && (
        <footer class="cl-change-source">
          <span class="cl-change-source-label">Shipped in</span>
          <span class="cl-change-prs">
            {prIds.map((id) => <PR id={id} repo={repo} state={state} />)}
          </span>
        </footer>
      )
    }
  </div>
</details>

<style>
  /* Native details state and the generated toggle glyph require selectors that
     cannot live on individual utility-classed nodes. */
  .cl-change {
    --note-accent: var(--color-kolu-primary);
    border-top: 1px solid var(--color-rule);
    transition:
      background 160ms ease,
      border-color 160ms ease;
  }

  .cl-change[data-kind="added"] {
    --note-accent: var(--color-kolu-bottom-strong);
  }

  .cl-change[data-kind="changed"] {
    --note-accent: var(--color-kolu-top);
  }

  .cl-change[data-kind="fixed"] {
    --note-accent: var(--color-kolu-primary);
  }

  .cl-change[data-kind="heads-up"] {
    --note-accent: var(--color-kolu-bottom-deep);
  }

  .cl-change[open] {
    border-color: color-mix(
      in srgb,
      var(--note-accent) 32%,
      var(--color-rule)
    );
    background: color-mix(
      in srgb,
      var(--note-accent) 4%,
      var(--color-void-raised)
    );
  }

  summary {
    display: grid;
    grid-template-columns: 1.1rem 4.55rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.58rem;
    min-height: 2.75rem;
    padding: 0.45rem 0.2rem;
    color: var(--color-ink);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 2px solid var(--color-kolu-primary);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .cl-change-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    border: 1px solid var(--color-rule-strong);
    border-radius: 2px;
    color: var(--color-ink-muted);
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background 160ms ease;
  }

  .cl-change-toggle::before,
  .cl-change-toggle::after {
    content: "";
    position: absolute;
    width: 0.48rem;
    height: 1px;
    background: currentColor;
    transition: transform 180ms ease;
  }

  .cl-change-toggle::after {
    transform: rotate(90deg);
  }

  .cl-change[open] .cl-change-toggle {
    color: var(--color-void);
    border-color: var(--note-accent);
    background: var(--note-accent);
  }

  .cl-change[open] .cl-change-toggle::after {
    transform: rotate(0deg);
  }

  .cl-change-title {
    font-size: 0.93rem;
    font-weight: 560;
    letter-spacing: -0.012em;
    line-height: 1.35;
    transition: color 150ms ease;
  }

  .cl-change-kind {
    justify-self: start;
    width: 100%;
    padding: 0.25rem 0.42rem;
    border: 1px solid color-mix(in srgb, var(--note-accent) 45%, transparent);
    border-radius: 999px;
    color: var(--note-accent);
    background: color-mix(in srgb, var(--note-accent) 9%, transparent);
    font-family: var(--font-mono);
    font-size: 0.54rem;
    font-weight: 650;
    letter-spacing: 0.055em;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .cl-change-count {
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .cl-change-match {
    grid-column: 3 / -1;
    margin-top: -0.28rem;
    padding: 0 0 0.12rem;
    color: var(--color-ink-muted);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .cl-change-match[hidden] {
    display: none;
  }

  .cl-change-match :global(mark) {
    padding: 0 0.12em;
    color: var(--color-void);
    background: var(--color-kolu-top-strong);
    border-radius: 2px;
  }

  summary:hover .cl-change-title,
  .cl-change[open] .cl-change-title {
    color: var(--note-accent);
  }

  .cl-change-body {
    max-width: 53rem;
    padding: 0.15rem 1.25rem 1rem 6.8rem;
  }

  .cl-change-desc {
    color: var(--color-ink-dim);
    font-size: 0.9rem;
    line-height: 1.62;
    animation: note-in 180ms ease both;
  }

  .cl-change-desc :global(p) {
    margin: 0;
  }

  .cl-change-desc :global(p + p) {
    margin-top: 0.75rem;
  }

  .cl-change-desc :global(strong) {
    color: var(--color-ink);
    font-weight: 620;
  }

  .cl-change-source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 0.7rem;
    margin-top: 0.8rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--color-rule);
  }

  .cl-change-source-label {
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .cl-change-prs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  @keyframes note-in {
    from {
      opacity: 0;
      transform: translateY(-3px);
    }
  }

  @media (max-width: 620px) {
    summary {
      grid-template-columns: 1.05rem 3.8rem minmax(0, 1fr);
      gap: 0.5rem;
      min-height: 2.65rem;
      padding-block: 0.42rem;
    }

    .cl-change-count {
      display: none;
    }

    .cl-change-match {
      grid-column: 3;
      margin-top: -0.25rem;
    }

    .cl-change-body {
      padding: 0.15rem 0.25rem 0.9rem 1.55rem;
    }

    .cl-change-desc {
      font-size: 0.88rem;
      line-height: 1.58;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cl-change,
    .cl-change-toggle,
    .cl-change-toggle::after,
    .cl-change-title {
      transition: none;
    }

    .cl-change-desc {
      animation: none;
    }
  }
</style>
