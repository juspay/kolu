---
/**
 * The site header for the file-based pages (landing, blog, changelog). It wraps
 * the shared <NavBar /> in the sticky, translucent bar. The Starlight docs pages
 * render the same <NavBar /> via StarlightHeader.astro (inside Starlight's own
 * fixed header), so the top bar is identical across the whole site.
 */
import NavBar from "./NavBar.astro";
---

<header class="sticky top-0 z-10 border-b border-rule backdrop-blur-xs bg-void/80">
  <NavBar />
</header>
