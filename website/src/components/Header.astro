---
/**
 * The site header. It wraps the shared <NavBar /> in the sticky, translucent
 * bar, and is used by BaseLayout for every page — the file-based ones (landing,
 * blog, changelog) and the docs (which render through the same BaseLayout via
 * DocsLayout) — so the top bar is identical across the whole site.
 */
import NavBar from "./NavBar.astro";
---

<header class="sticky top-0 z-10 border-b border-rule backdrop-blur-xs bg-void/80">
  <NavBar />
</header>
