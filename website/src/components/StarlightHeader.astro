---
/**
 * Starlight `Header` override — makes the docs pages wear the site's own top
 * bar (see astro.config.mjs → starlight.components.Header). Starlight already
 * provides the fixed, full-width <header> shell (themed to the kolu void +
 * hairline in starlight.css); we only supply the bar's contents, so we render
 * the shared <NavBar /> bare — no extra <header>, which would be invalid nested
 * inside Starlight's. Starlight's own search box and language/theme selects are
 * intentionally dropped in favour of one consistent bar: NavBar carries the
 * site's links and the single theme toggle. (The docs are three pages today, so
 * the Pagefind search UI is a fair trade for a header that matches the site;
 * fold it back into NavBar if the docs set grows.)
 */
import NavBar from "./NavBar.astro";
---

<NavBar />
