---
/**
 * kolu.dev/padi — the per-host workspace daemon behind kolu, and padi-tui,
 * the thin CLI over the workspace surface.
 */
import BaseLayout from "../layouts/BaseLayout.astro";

const knows = [
  {
    name: "terminal registry",
    what: "which terminals exist, where they belong, and how to re-open them after the web layer moves.",
  },
  {
    name: "workspace memory",
    what: "the session record, activity feed, restore target, and durable state-root for one host.",
  },
  {
    name: "repo context",
    what: "repo, branch, pull request, checks, cwd, foreground command, file browsing, git status, and diffs.",
  },
  {
    name: "agent state",
    what: "whether a terminal's agent is working, waiting, or asking for you, folded into one live surface.",
  },
];

const commands = [
  {
    cmd: "padi-tui status",
    flags: "--json",
    what: "Print a one-shot workspace snapshot: terminals, repos, agent state, foreground process, and recency.",
  },
  {
    cmd: "padi-tui watch",
    flags: "--json",
    what: "Follow the workspace live, including state changes and activity indicators.",
  },
  {
    cmd: "padi-tui wait <id> --until awaiting,waiting",
    flags: "--timeout <ms> · --json",
    what: "Block until an agent turn ends using padi's real agent-state fold, not a guess from terminal silence.",
  },
  {
    cmd: "padi-tui create -- claude",
    flags: "--parent <id> · --worktree <branch> · --repo <path> · --json",
    what: "Create a kolu terminal from the shell: a new tile, a split tile, or a worktree'd agent that appears live on the canvas.",
  },
];
---

<BaseLayout
  title="padi"
  description="padi — the per-host workspace daemon behind kolu. It remembers sessions, terminal records, repo context, restore state, and agent awareness while kaval owns the live PTYs underneath."
>
  <section class="mx-auto max-w-3xl px-6 pt-20 md:pt-28 pb-10">
    {/* Warning orange uses the logo's top-step token directly; this is a product
        maturity warning, not the site's primary accent. */}
    <div
      class="mb-8 flex items-start gap-3 border border-kolu-top/50 bg-kolu-top/10 rounded-lg px-4 py-3 max-w-xl"
    >
      <svg
        class="mt-0.5 h-5 w-5 shrink-0 text-kolu-top"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
        ></path>
        <line x1="12" y1="9" x2="12" y2="13"></line>
        <line x1="12" y1="17" x2="12.01" y2="17"></line>
      </svg>
      <p class="mono text-sm text-ink leading-relaxed">
        <span class="text-kolu-top font-semibold">alpha</span> — padi and
        padi-tui are an early preview. Commands, flags, and output formats{" "}
        <span class="text-ink">will change</span> before they're finalized for
        production use; don't script against them yet.
      </p>
    </div>
    <div class="flex items-center justify-between gap-6">
      <div>
        <p class="eyebrow text-ink-dim mb-4">
          the workspace daemon &amp; its CLI · alpha
        </p>
        <h1 class="display text-[3.2rem] md:text-[4.2rem] text-ink">
          the memory<br />under <span class="text-kolu-primary">kolu</span>.
        </h1>
      </div>
      <img
        src="/padi-logo.svg"
        width="120"
        height="120"
        alt="padi — the per-host workspace daemon"
        class="pd-logo hidden md:block w-36 lg:w-40 shrink-0"
      />
    </div>

    <p class="mt-6 text-ink-dim max-w-xl leading-relaxed">
      <code class="mono text-ink">padi</code> is the per-host daemon that remembers
      what a Kolu workspace <em>is</em>: terminals, sessions, restore state, repo
      context, the code tree, git status, diffs, and agent awareness. It sits above{" "}
      <a href="/kaval" class="text-kolu-primary hover:underline"
        ><code class="mono">kaval</code></a
      >, which owns the live PTYs. The split is simple: kaval keeps shells alive;
      padi keeps the workspace legible.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-14">
    <h2 class="pd-head">where it sits</h2>
    <p class="text-ink-dim text-[0.95rem] leading-relaxed max-w-xl mb-6">
      The browser talks to <code class="mono text-ink">kolu-server</code>, the
      server binds <code class="mono text-ink">padi</code>, and padi supervises its
      own <code class="mono text-ink">kaval</code>. Restart the web shell and padi
      still has the workspace. Restart padi and kaval still has the PTYs. The
      layers recover on different clocks because they own different state.
    </p>

    <figure class="rounded-xl border border-rule px-5 py-6 overflow-x-auto">
      <svg
        class="pd-diagram"
        viewBox="0 0 760 324"
        role="img"
        aria-labelledby="pd-stack-title"
      >
        <title id="pd-stack-title"
          >kolu-server binds padi, padi supervises kaval, and kaval owns PTYs.
          padi holds the workspace record while kaval holds the live shells.</title
        >
        <defs>
          <marker
            id="pd-arrow"
            viewBox="0 0 10 10"
            refX="8.5"
            refY="5"
            markerWidth="6.5"
            markerHeight="6.5"
            orient="auto-start-reverse"
          >
            <path d="M0,0 L10,5 L0,10 z" class="pd-d-arrow"></path>
          </marker>
        </defs>

        <text x="120" y="38" text-anchor="middle" class="pd-d-cap">FACE</text>
        <text x="380" y="38" text-anchor="middle" class="pd-d-cap">WORKSPACE</text>
        <text x="640" y="38" text-anchor="middle" class="pd-d-cap">PTY OWNER</text>

        <rect x="44" y="64" width="152" height="104" rx="10" class="pd-d-box"></rect>
        <image href="/favicon.svg" x="102" y="80" width="36" height="36"></image>
        <text x="120" y="137" text-anchor="middle" class="pd-d-label">kolu</text>
        <text x="120" y="157" text-anchor="middle" class="pd-d-sub">browser + server</text>

        <rect x="284" y="52" width="192" height="136" rx="12" class="pd-d-daemon"></rect>
        <image href="/padi-logo.svg" x="360" y="74" width="40" height="40"></image>
        <text x="380" y="136" text-anchor="middle" class="pd-d-daemon-label">padi</text>
        <text x="380" y="158" text-anchor="middle" class="pd-d-sub">session · registry · agents</text>
        <text x="380" y="176" text-anchor="middle" class="pd-d-sub2">the workspace record</text>

        <rect x="570" y="64" width="152" height="104" rx="10" class="pd-d-box"></rect>
        <image href="/kaval-logo.svg" x="628" y="80" width="36" height="36"></image>
        <text x="646" y="137" text-anchor="middle" class="pd-d-label">kaval</text>
        <text x="646" y="157" text-anchor="middle" class="pd-d-sub">PTYs + screens</text>

        <path
          d="M196,116 H276"
          class="pd-d-flow"
          marker-start="url(#pd-arrow)"
          marker-end="url(#pd-arrow)"></path>
        <text x="236" y="105" text-anchor="middle" class="pd-d-tlabel">surface</text>
        <path
          d="M476,116 H562"
          class="pd-d-flow"
          marker-start="url(#pd-arrow)"
          marker-end="url(#pd-arrow)"></path>
        <text x="519" y="105" text-anchor="middle" class="pd-d-tlabel">unix socket</text>

        <path d="M326,218 H434" class="pd-d-store"></path>
        <path d="M380,188 V238" class="pd-d-store" marker-end="url(#pd-arrow)"></path>
        <rect x="274" y="238" width="212" height="38" rx="7" class="pd-d-store-box"></rect>
        <text x="380" y="262" text-anchor="middle" class="pd-d-store-text"
          >state-root on disk</text
        >
      </svg>
    </figure>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-14">
    <h2 class="pd-head">what padi knows</h2>
    <p class="text-ink-dim text-[0.95rem] leading-relaxed max-w-xl">
      kaval only knows terminals. padi is where terminal observations become a
      workspace: repo-aware, agent-aware, resumable, and readable from more than
      one face.
    </p>

    <dl class="pd-grid">
      {
        knows.map((item) => (
          <div class="pd-fact">
            <dt>{item.name}</dt>
            <dd>{item.what}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-14">
    <h2 class="pd-head">the thin shell face — <span class="pd-prog">padi-tui</span></h2>
    <p class="text-ink-dim text-[0.95rem] leading-relaxed max-w-xl mb-6">
      <code class="mono text-ink">padi-tui</code> reads the same workspace surface
      kolu uses. Where <code class="mono text-ink">kaval-tui</code> shows what's
      running in each PTY, padi-tui shows what each terminal is in: repo, PR,
      checks, foreground command, live byte activity, and agent state.
    </p>

    <div class="pd-term">
      <span class="cmd">padi-tui status</span>
      <span class="cmd">padi-tui watch</span>
      <span class="cmd">padi-tui wait a3f10000 --until awaiting,waiting</span>
      <span class="cmd">padi-tui create -- claude</span>
    </div>

    <pre class="pd-sample"><code>ID        REPO·BRANCH         PR        AGENT             FOREGROUND        IDLE
a3f10000  kolu·feat/dial-ssh  #1412 ✓   claude · working  node              2s
b7c20000  kolu·master         —         codex · waiting   codex             1m
c9d40000  kolu·fix/fold       #1408 ✗   —                 nvim              5m</code></pre>

    <p class="pd-note">
      <span class="text-ink">Usually no flag.</span> padi keys its socket by a
      digest of its state-root, so inside a kolu terminal{" "}
      <code class="mono text-ink">$PADI_SOCKET</code> makes{" "}
      <code class="mono text-ink">padi-tui</code> flag-less — an agent driving its
      siblings never guesses a path. Elsewhere it autodiscovers the running padi;{" "}
      <code class="mono text-ink">--socket &lt;path&gt;</code> or{" "}
      <code class="mono text-ink">--state-root &lt;dir&gt;</code> point it
      elsewhere. Remote padi over ssh is a later phase; today padi-tui is local.
    </p>

    <p class="pd-note">
      <code class="mono text-ink">wait &lt;id&gt; --until awaiting,waiting</code>{" "}
      blocks until a terminal's agent finishes its turn — a done-signal read from
      real padi state, not guessed from terminal silence. For a robust driver,
      wait in two phases: <code class="mono text-ink">--until working</code> for
      pickup, then{" "}
      <code class="mono text-ink">--until awaiting,waiting</code> for turn-end, so
      a stale previous-turn state cannot satisfy the wait early.{" "}
      <code class="mono text-ink">--timeout &lt;ms&gt;</code> fails loud (exit 2),
      a terminal that exits first exits 3, and{" "}
      <code class="mono text-ink">--json</code> prints{" "}
      <code class="mono text-ink">{"{ id, agent }"}</code>. The deeper design
      notes live in the{" "}
      <a href="https://kolu.dev/atlas/padi.html" rel="noopener">padi atlas note</a>.
    </p>

    <div class="pd-command-list">
      {
        commands.map((c) => (
          <div class="pd-command">
            <code>{c.cmd}</code>
            {c.flags && <span>{c.flags}</span>}
            <p>{c.what}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-20">
    <h2 class="pd-head">why it is not inside kolu-server</h2>
    <p class="text-ink-dim text-[0.95rem] leading-relaxed max-w-xl">
      The web server is a face: HTTP, assets, websocket transport. The workspace
      is a daemon: durable folder, terminal registry, session restore, agent
      awareness. Keeping those apart means a deploy can replace the web shell
      without making the workspace disappear.
    </p>

    <div class="pd-links">
      <a href="/architecture">
        <span>architecture</span>
        <small>the full stack and survival story</small>
      </a>
      <a href="/kaval">
        <span>kaval</span>
        <small>the PTY daemon under padi</small>
      </a>
      <a href="https://kolu.dev/atlas/padi.html" rel="noopener">
        <span>padi atlas note</span>
        <small>design notes and phase history</small>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .pd-logo {
    filter: drop-shadow(
      0 16px 38px color-mix(in srgb, var(--color-kolu-bottom-strong) 35%, transparent)
    );
  }

  .pd-head {
    position: relative;
    margin-top: 0.2rem;
    margin-bottom: 1.6rem;
    padding-left: 1.15rem;
    font-family: var(--font-sans);
    font-size: clamp(1.7rem, 1.05rem + 2.1vw, 2.35rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.12;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .pd-head::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.16em;
    bottom: 0.16em;
    width: 5px;
    border-radius: 3px;
    background: var(--color-kolu-primary);
    box-shadow: 0 0 14px -1px
      color-mix(in srgb, var(--color-kolu-primary) 60%, transparent);
  }
  .pd-prog {
    font-family: var(--font-mono);
    color: var(--color-kolu-primary);
    font-size: 0.82em;
  }

  .pd-diagram {
    display: block;
    width: 100%;
    height: auto;
  }
  .pd-diagram text {
    font-family: var(--font-mono);
  }
  .pd-d-box {
    fill: var(--color-void-raised);
    stroke: var(--color-rule-strong);
    stroke-width: 1.4;
  }
  .pd-d-daemon {
    fill: color-mix(in srgb, var(--color-kolu-primary) 12%, var(--color-void-raised));
    stroke: var(--color-kolu-primary);
    stroke-width: 1.5;
  }
  .pd-d-flow {
    fill: none;
    stroke: var(--color-kolu-top);
    stroke-width: 1.5;
  }
  .pd-d-arrow {
    fill: var(--color-kolu-top);
  }
  .pd-d-store {
    fill: none;
    stroke: var(--color-kolu-bottom);
    stroke-width: 1.4;
  }
  .pd-d-store-box {
    fill: color-mix(in srgb, var(--color-kolu-bottom) 8%, var(--color-void-raised));
    stroke: color-mix(in srgb, var(--color-kolu-bottom) 40%, var(--color-rule-strong));
    stroke-width: 1.2;
  }
  .pd-d-cap {
    fill: var(--color-kolu-primary);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 1.6px;
  }
  .pd-d-label {
    fill: var(--color-ink);
    font-size: 16.5px;
    font-weight: 650;
  }
  .pd-d-daemon-label {
    fill: var(--color-kolu-primary-hover);
    font-size: 22px;
    font-weight: 700;
  }
  .pd-d-sub,
  .pd-d-tlabel {
    fill: var(--color-ink-dim);
    font-size: 11px;
  }
  .pd-d-sub2 {
    fill: var(--color-ink-muted);
    font-size: 10px;
  }
  .pd-d-store-text {
    fill: var(--color-kolu-bottom);
    font-size: 12px;
    font-weight: 650;
  }

  .pd-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin-top: 1.5rem;
    border: 1px solid var(--color-rule);
    border-radius: 0.6rem;
    overflow: hidden;
    background: var(--color-rule);
  }
  .pd-fact {
    background: var(--color-void);
    padding: 1.15rem 1.25rem;
  }
  .pd-fact dt {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--color-kolu-primary);
    margin-bottom: 0.5rem;
  }
  .pd-fact dd {
    margin: 0;
    color: var(--color-ink-dim);
    font-size: 0.93rem;
    line-height: 1.6;
  }

  .pd-term {
    max-width: 42rem;
    border: 1px solid var(--color-rule);
    border-radius: 0.7rem;
    background: var(--color-void-sunk);
    padding: 0.95rem 1.1rem;
    font-family: var(--font-mono);
    font-variant-ligatures: none;
    font-size: 0.85rem;
    line-height: 1.95;
    overflow-x: auto;
  }
  .pd-term .cmd {
    display: block;
    white-space: pre;
    color: var(--color-ink);
  }
  .pd-term .cmd::before {
    content: "$ ";
    color: var(--color-kolu-top-strong);
    font-weight: 600;
  }

  .pd-sample {
    max-width: 42rem;
    margin-top: 1rem;
    overflow-x: auto;
    border: 1px solid var(--color-rule);
    border-radius: 0.7rem;
    background: color-mix(in srgb, var(--color-kolu-bottom) 6%, var(--color-void-sunk));
    padding: 0.95rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.75;
    color: var(--color-ink-dim);
  }

  .pd-note {
    max-width: 42rem;
    margin-top: 1rem;
    color: var(--color-ink-dim);
    font-size: 0.95rem;
    line-height: 1.65;
  }
  .pd-note a {
    color: var(--color-kolu-primary);
    text-decoration: none;
  }
  .pd-note a:hover {
    text-decoration: underline;
  }

  .pd-command-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 1.5rem;
  }
  .pd-command {
    border-top: 1px solid var(--color-rule);
    padding-top: 0.9rem;
  }
  .pd-command code {
    font-family: var(--font-mono);
    color: var(--color-kolu-primary);
    font-size: 0.9rem;
  }
  .pd-command span {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    color: var(--color-ink-muted);
    font-size: 0.78rem;
  }
  .pd-command p {
    margin-top: 0.35rem;
    color: var(--color-ink-dim);
    line-height: 1.6;
    font-size: 0.93rem;
  }

  .pd-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.9rem;
    margin-top: 1.7rem;
  }
  .pd-links a {
    border: 1px solid var(--color-rule);
    border-top: 2px solid var(--color-kolu-primary);
    border-radius: 0.55rem;
    padding: 0.95rem 1rem;
    text-decoration: none;
    background: var(--color-void-raised);
    transition:
      border-color 120ms ease,
      background 120ms ease;
  }
  .pd-links a:hover {
    border-color: var(--color-kolu-primary);
    background: color-mix(in srgb, var(--color-kolu-primary) 7%, var(--color-void-raised));
  }
  .pd-links span {
    display: block;
    font-family: var(--font-mono);
    color: var(--color-kolu-primary);
    font-size: 0.86rem;
    margin-bottom: 0.45rem;
  }
  .pd-links small {
    display: block;
    color: var(--color-ink-dim);
    line-height: 1.5;
  }

  @media (max-width: 700px) {
    .pd-grid,
    .pd-links {
      grid-template-columns: 1fr;
    }
    .pd-command span {
      display: block;
      margin: 0.3rem 0 0;
    }
  }
</style>
