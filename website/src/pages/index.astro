---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { KOLU_VERSION } from '../site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}` || '/';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts[0];

const doors = [
  {
    title: 'Try it on this machine',
    href: '/quickstart',
    eyebrow: 'this machine',
    copy: 'One Nix command. Open a local URL. See the canvas in a minute.',
  },
  {
    title: 'Mac window, Linux computer',
    href: '/from-a-mac',
    eyebrow: 'the usual setup',
    copy: 'Kolu runs on a Linux box. You open it from your Mac as an app.',
  },
];
---

<BaseLayout title="kolu" searchSection="Site">
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href="/demo/hero-demo.webp"
      fetchpriority="high"
    />
  </Fragment>

  <section class="hero">
    <span class="hero-corner hero-corner-left" aria-hidden="true">┌ kolu</span>
    <span class="hero-corner hero-corner-right" aria-hidden="true">v{KOLU_VERSION} ┐</span>

    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow">
        <span aria-hidden="true">$</span>
        <span>kolu — the terminal, done right</span>
      </p>

      <h1 class="display hero-title">
        Keep the <span>Mac</span>.<br />Run agents on Linux.<span class="cursor" aria-hidden="true"></span>
      </h1>

      <p class="hero-kicker mono">
        Not a chat-UI wrapper.<br />Not an editor fork.<br />The window onto a box that isn't slow.
      </p>

      <p class="hero-body">
        Your Mac is slow for agents, especially the filesystem. Keep the Mac.
        Put the agents on a Linux box. Kolu is the window: a real app in the
        macOS launcher, talking to kolu running on the box. Closing the laptop
        does not kill any of it. Real terminals on an infinite canvas —
        <span class="mono">claude</span>, <span class="mono">codex</span>, <span class="mono">opencode</span>, <span class="mono">grok</span>, or
        anything you run in a shell.
      </p>

      <div class="hero-actions">
        <a href={href('/start')} class="hero-primary">
          Get started <span aria-hidden="true">→</span>
        </a>
        <a href="https://github.com/juspay/kolu" rel="noopener" class="hero-secondary">
          <svg viewBox="0 0 16 16" class="size-3.5 fill-current" aria-hidden="true">
            <path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.34c-2.22.48-2.69-1.07-2.69-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.82 1.23.82.72 1.23 1.88.87 2.34.67.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.58.82-2.14-.08-.2-.36-1.01.08-2.11 0 0 .67-.21 2.2.82a7.63 7.63 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.91.08 2.11.51.56.82 1.27.82 2.14 0 3.06-1.86 3.75-3.64 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"></path>
          </svg>
          juspay/kolu
        </a>
      </div>

      <p class="hero-aside">
        <a href={href('/philosophy')}>
          Why a terminal and not an editor <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>

  <section class="demo-section" aria-label="Kolu product demo">
    <figure class="full-demo">
      <div class="full-demo-frame">
        <video
          class="demo-video"
          muted
          loop
          playsinline
          preload="none"
          poster="/demo/hero-demo.webp"
        >
          <source src="/demo/hero-demo.webm" type="video/webm" />
          <source src="/demo/hero-demo.mp4" type="video/mp4" />
        </video>
      </div>
      <figcaption class="hero-demo-cap">
        The dock finds what you cannot see: two agents in two repos, and one
        buried behind another tile asking for you.
      </figcaption>
    </figure>
  </section>

  <section class="home-band">
    <div class="section-head">
      <p class="eyebrow">start</p>
      <h2 class="display-sm">Two ways in.</h2>
      <p>
        Try it on the machine in front of you, or run it on Linux and open it
        from a Mac as an app. That second path is the one the product is built
        around.
      </p>
    </div>

    <div class="doc-card-grid">
      {
        doors.map((card) => (
          <a href={href(card.href)} class="doc-entry-card">
            <span class="doc-entry-eyebrow">{card.eyebrow}</span>
            <strong>{card.title}</strong>
            <span>{card.copy}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="home-band">
    <div class="system-shell">
      <div class="system-intro">
        <p class="eyebrow">the shape</p>
        <h2 class="display-sm">Mac is the window. Linux is the computer.</h2>
        <p>
          There is no Linux desktop to remote into. Kolu is a website the box
          serves. You open that URL on the Mac and pin it as an app. The agents
          keep running when you close the laptop.
        </p>
        <a href={href('/from-a-mac')} class="system-link">
          The five-step setup <span aria-hidden="true">→</span>
        </a>
      </div>

      <ol class="system-flow" aria-label="Mac window, Linux computer">
        <li class="system-node system-node-primary">
          <a href={href('/from-a-mac')} class="system-node-link">
            <span class="system-logo-wrap">
              <img src={href('/favicon.svg')} alt="" class="system-logo" />
            </span>
            <span class="system-copy">
              <span class="system-name">your Mac</span>
              <span class="system-role">the window</span>
              <span class="system-desc">
                a browser, then a pinned app in the macOS launcher. Nothing
                runs here except the view.
              </span>
            </span>
          </a>
          <span class="system-arrow" aria-hidden="true">→</span>
        </li>
        <li class="system-node system-node-bottom">
          <a href={href('/from-a-mac')} class="system-node-link">
            <span class="system-logo-wrap">
              <img src={href('/favicon.svg')} alt="" class="system-logo" />
            </span>
            <span class="system-copy">
              <span class="system-name">Linux box</span>
              <span class="system-role">the computer</span>
              <span class="system-desc">
                kolu runs here. The terminals and the agents live on this
                machine, whether the laptop is open or not.
              </span>
            </span>
          </a>
        </li>
      </ol>
    </div>
    <p class="builders-line">
      Building on the stack?
      <a href={href('/architecture')}>Architecture</a>
      ·
      <a href={href('/surface')}>Surface</a>
    </p>
  </section>

  {
    latest && (
      <section class="home-band latest-band">
        <div class="latest-head">
          <p class="eyebrow">from the blog</p>
          <a href={href('/blog')} class="latest-all">all posts →</a>
        </div>
        <a href={href(`/blog/${latest.id}`)} class="latest-card">
          <time datetime={latest.data.pubDate.toISOString()}>
            {latest.data.pubDate
              .toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: '2-digit',
              })
              .toUpperCase()}
          </time>
          <h2 class="display-sm">{latest.data.title}</h2>
          <p>{latest.data.description}</p>
          <span>read →</span>
        </a>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    position: relative;
    max-width: 72rem;
    margin: 0 auto;
    padding: 5rem 1.5rem 2rem;
  }
  .hero-corner {
    position: absolute;
    top: 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    color: var(--color-ink-faint);
  }
  .hero-corner-left {
    left: 1.5rem;
  }
  .hero-corner-right {
    right: 1.5rem;
  }
  .hero-copy {
    max-width: 48rem;
    margin: 2rem auto 0;
    text-align: center;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hero-eyebrow span:first-child {
    color: var(--color-kolu-primary);
  }
  .hero-title {
    margin-top: 1.25rem;
    color: var(--color-ink);
    font-size: clamp(2.8rem, 2.1rem + 3.4vw, 4.6rem);
  }
  .hero-title span {
    color: var(--color-kolu-primary);
  }
  .hero-kicker {
    margin-top: 1.45rem;
    color: var(--color-ink-muted);
    font-size: 0.78rem;
    line-height: 1.75;
  }
  .hero-body {
    max-width: 44rem;
    margin: 1.6rem auto 0;
    color: var(--color-ink-dim);
    font-size: 1.08rem;
    line-height: 1.75;
  }
  .hero-body .mono {
    color: var(--color-ink);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .hero-primary,
  .hero-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 0.25rem;
    padding: 0.7rem 1.15rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-decoration: none;
    transition:
      border-color 120ms ease,
      background 120ms ease,
      color 120ms ease;
  }
  .hero-primary {
    background: var(--color-kolu-primary);
    color: var(--color-void);
  }
  .hero-primary:hover {
    background: var(--color-kolu-primary-hover);
  }
  .hero-secondary {
    border: 1px solid var(--color-rule-strong);
    color: var(--color-ink);
  }
  .hero-secondary:hover {
    border-color: var(--color-ink-dim);
    background: var(--color-void-raised);
  }
  /* The kicker asserts the editor is the wrong shape for this era; this is the
     one click to where that argument is actually made. Deliberately quieter
     than the two hero buttons — it's a third path, not a third call to act. */
  .hero-aside {
    margin-top: 1.15rem;
  }
  .hero-aside a {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color 120ms ease;
  }
  .hero-aside a:hover {
    color: var(--color-kolu-primary);
  }
  .demo-section {
    max-width: 82rem;
    margin: 0 auto;
    padding: 1rem 1.5rem 4rem;
  }
  .full-demo {
    margin: 0;
  }
  .full-demo-frame {
    border: 1px solid var(--color-rule-strong);
    border-radius: 0.65rem;
    overflow: hidden;
    background: var(--color-void-sunk);
    box-shadow: 0 0 90px -30px
      color-mix(in srgb, var(--color-kolu-primary) 35%, transparent);
    line-height: 0;
  }
  .demo-video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
  }
  .hero-demo-cap {
    max-width: 42rem;
    margin: 0.9rem auto 0;
    color: var(--color-ink-muted);
    font-size: 0.86rem;
    line-height: 1.55;
    text-align: center;
  }
  .home-band {
    max-width: 72rem;
    margin: 0 auto;
    padding: 3.5rem 1.5rem;
    border-top: 1px solid var(--color-rule);
  }
  .section-head {
    max-width: 42rem;
    margin-bottom: 1.8rem;
  }
  .section-head h2,
  .system-intro h2,
  .latest-card h2 {
    margin-top: 0.45rem;
    color: var(--color-ink);
    font-size: clamp(1.9rem, 1.35rem + 2vw, 2.5rem);
  }
  .section-head p,
  .system-intro p,
  .latest-card p {
    margin-top: 0.9rem;
    color: var(--color-ink-dim);
    line-height: 1.7;
  }
  .doc-card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }
  .doc-entry-card {
    min-height: 11rem;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-rule);
    border-top: 2px solid var(--color-kolu-primary);
    border-radius: 0.5rem;
    padding: 1rem;
    background: var(--color-void-raised);
    text-decoration: none;
    transition:
      transform 140ms ease,
      border-color 140ms ease,
      background 140ms ease;
  }
  .doc-entry-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-kolu-primary);
    background: color-mix(in srgb, var(--color-kolu-primary) 7%, var(--color-void-raised));
  }
  .doc-entry-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-kolu-primary);
  }
  .doc-entry-card strong {
    margin-top: 0.75rem;
    color: var(--color-ink);
    font-size: 1.05rem;
    line-height: 1.25;
  }
  .doc-entry-card span:last-child {
    margin-top: 0.55rem;
    color: var(--color-ink-dim);
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .system-shell {
    display: grid;
    grid-template-columns: minmax(16rem, 0.72fr) minmax(0, 1.28fr);
    gap: 2rem;
    align-items: center;
  }
  .system-intro {
    max-width: 24rem;
  }
  .system-link,
  .latest-all {
    display: inline-flex;
    margin-top: 1.15rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-kolu-primary);
    text-decoration: none;
  }
  .system-link:hover,
  .latest-all:hover {
    color: var(--color-kolu-primary-hover);
  }
  .system-flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }
  .builders-line {
    margin-top: 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-ink-muted);
  }
  .builders-line a {
    color: var(--color-ink-dim);
    text-decoration: none;
  }
  .builders-line a:hover {
    color: var(--color-kolu-primary);
  }
  .system-node {
    position: relative;
    min-width: 0;
  }
  .system-node-link {
    min-height: 13.2rem;
    height: 100%;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 1rem;
    border: 1px solid var(--node-rule);
    border-top-width: 2px;
    border-radius: 0.5rem;
    padding: 1rem;
    background: color-mix(in srgb, var(--node-color) 5%, var(--color-void-raised));
    text-decoration: none;
    transition:
      border-color 140ms ease,
      transform 140ms ease,
      background 140ms ease;
  }
  .system-node-link:hover {
    transform: translateY(-2px);
    border-color: var(--node-color);
    background: color-mix(in srgb, var(--node-color) 8%, var(--color-void-raised));
  }
  .system-node-primary {
    --node-color: var(--color-kolu-primary);
    --node-rule: color-mix(in srgb, var(--color-kolu-primary) 48%, var(--color-rule));
  }
  .system-node-bottom {
    --node-color: var(--color-kolu-bottom-strong);
    --node-rule: color-mix(in srgb, var(--color-kolu-bottom) 50%, var(--color-rule));
  }
  .system-node-top {
    --node-color: var(--color-kolu-top-strong);
    --node-rule: color-mix(in srgb, var(--color-kolu-top) 50%, var(--color-rule));
  }
  .system-logo-wrap {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
  }
  .system-logo {
    width: 2.45rem;
    height: 2.45rem;
    object-fit: contain;
  }
  .system-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .system-name {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--node-color);
  }
  .system-role {
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .system-desc {
    margin-top: 0.72rem;
    color: var(--color-ink-dim);
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .system-arrow {
    position: absolute;
    top: 1.6rem;
    right: -0.72rem;
    z-index: 2;
    width: 1.45rem;
    height: 1.45rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    background: var(--color-void);
    color: var(--color-kolu-top);
    font-family: var(--font-mono);
    font-size: 0.88rem;
  }
  .latest-band {
    max-width: 68rem;
  }
  .latest-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.6rem;
  }
  .latest-all {
    margin-top: 0;
  }
  .latest-card {
    display: block;
    border-block: 1px solid var(--color-rule);
    padding-block: 2.3rem;
    text-decoration: none;
    transition: border-color 120ms ease;
  }
  .latest-card:hover {
    border-color: var(--color-kolu-primary-muted);
  }
  .latest-card time,
  .latest-card span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .latest-card:hover h2,
  .latest-card:hover span {
    color: var(--color-kolu-primary);
  }
  .latest-card p {
    max-width: 42rem;
  }
  .latest-card span {
    display: inline-block;
    margin-top: 1.3rem;
    transition: color 120ms ease;
  }
  @media (max-width: 760px) {
    .hero-corner {
      display: none;
    }
    .hero {
      padding-top: 3.6rem;
    }
    .doc-card-grid,
    .system-shell,
    .system-flow {
      grid-template-columns: 1fr;
    }
    .system-node-link {
      min-height: auto;
      grid-template-columns: auto 1fr;
      grid-template-rows: none;
      align-items: start;
    }
    .system-arrow {
      top: auto;
      right: auto;
      left: 1.5rem;
      bottom: -1.18rem;
      transform: rotate(90deg);
    }
  }
</style>

<script is:inline>
  (function () {
    var mq = window.matchMedia("(prefers-reduced-motion: reduce)");
    var io = null;
    function play(v) {
      v.preload = "auto";
      v.setAttribute("autoplay", "");
      var p = v.play();
      if (p && typeof p.catch === "function") p.catch(function () {});
    }
    function apply() {
      var vids = document.querySelectorAll(".demo-video");
      for (var i = 0; i < vids.length; i++) {
        var v = vids[i];
        if (mq.matches) {
          v.removeAttribute("autoplay");
          v.setAttribute("controls", "");
          v.pause();
        } else {
          v.removeAttribute("controls");
          if ("IntersectionObserver" in window) {
            if (!io) {
              io = new IntersectionObserver(
                function (entries) {
                  entries.forEach(function (e) {
                    if (e.isIntersecting) {
                      play(e.target);
                      io.unobserve(e.target);
                    }
                  });
                },
                { rootMargin: "200px 0px" },
              );
            }
            io.observe(v);
          } else {
            play(v);
          }
        }
      }
    }
    apply();
    if (mq.addEventListener) mq.addEventListener("change", apply);
    else if (mq.addListener) mq.addListener(apply);
  })();
</script>
