---
import { getCollection, render } from "astro:content";
import Change from "../components/Change.astro";
import PR from "../components/PR.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const mdxComponents = { PR, Change };
const masterCommand = "nix run github:juspay/kolu";

const fmtDate = (date: Date) =>
  date
    .toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "2-digit",
      timeZone: "UTC",
    })
    .toUpperCase();

const semverDesc = (a: string, b: string) => {
  const [aMaj, aMin, aPat] = a.split(".").map(Number);
  const [bMaj, bMin, bPat] = b.split(".").map(Number);
  return (bMaj! - aMaj!) || (bMin! - aMin!) || (bPat! - aPat!);
};

const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

interface SectionStat {
  label: string;
  key: string;
  count: number;
}

// The headings remain the source of truth for a note's section. Derive the
// release overview from those same slices instead of asking every <Change> to
// repeat a category prop that can drift from its surrounding MDX.
const sectionStats = (body?: string): SectionStat[] => {
  if (!body) return [];
  const headings = [...body.matchAll(/^###\s+(.+?)\s*$/gm)];

  return headings.map((heading, index) => {
    const label = heading[1]!.trim();
    const start = (heading.index ?? 0) + heading[0].length;
    const end = headings[index + 1]?.index ?? body.length;
    const section = body.slice(start, end);

    return {
      label,
      key: slugify(label),
      count: section.match(/^-\s+/gm)?.length ?? 0,
    };
  });
};

const all = await getCollection("changelog");
const unreleased = all.find((entry) => !entry.data.date);
const released = all
  .filter((entry) => entry.data.date)
  .sort(
    (a, b) =>
      b.data.date!.valueOf() - a.data.date!.valueOf() ||
      semverDesc(a.data.version, b.data.version) ||
      a.id.localeCompare(b.id),
  );

const unreleasedHasBody = !!unreleased?.body?.trim();
const unreleasedStats = sectionStats(unreleased?.body);
const unreleasedChangeCount = unreleasedStats.reduce(
  (total, section) => total + section.count,
  0,
);
const UnreleasedBody = unreleased ? (await render(unreleased)).Content : null;

const releases = await Promise.all(
  released.map(async (entry) => {
    const date = entry.data.date!;
    const stats = sectionStats(entry.body);
    return {
      version: entry.data.version,
      date,
      dateLabel: fmtDate(date),
      anchor: `v${entry.data.version.replace(/\./g, "-")}`,
      changeCount: stats.reduce((total, section) => total + section.count, 0),
      stats,
      Body: (await render(entry)).Content,
    };
  }),
);

const previousVersion = releases[0]?.version;
---

<BaseLayout
  title="Changelog"
  description="Every user-facing change in kolu, newest first."
  searchSection="Changelog"
>
  <section class="changelog">
    <header class="changelog-hero reveal reveal-1">
      <p class="hero-eyebrow">
        <span aria-hidden="true">↳</span>
        Release notes
      </p>
      <div class="hero-grid">
        <h1 class="display">Changelog<span>.</span></h1>
        <p>
          What changed, why it matters, and the work behind it. Product notes,
          not a commit dump. Newest first.
        </p>
      </div>
    </header>

    <nav class="release-nav reveal reveal-2" aria-label="Changelog releases">
      <span class="release-nav-label">Releases</span>
      <div class="release-nav-links">
        <a href="#unreleased" class="is-current">
          <span class="release-live" aria-hidden="true"></span>
          <span>Unreleased</span>
          <small>{unreleasedChangeCount} changes</small>
        </a>
        {
          releases.map((release) => (
            <a href={`#${release.anchor}`}>
              <span>v{release.version}</span>
              <small>{release.dateLabel}</small>
            </a>
          ))
        }
      </div>
    </nav>

    <div class="release-stream">
      <article
        id="unreleased"
        class="release release-current reveal reveal-3"
        data-release="unreleased"
        data-filterable
      >
        <header class="release-masthead">
          <div class="release-intro">
            <p class="release-kicker">
              <span class="release-live" aria-hidden="true"></span>
              Next release · live on master
            </p>
            <h2>Unreleased</h2>
            <p class="release-deck">
              {
                previousVersion
                  ? `Everything that has landed since v${previousVersion}.`
                  : "Everything that has landed before the first numbered release."
              }
            </p>
          </div>

          <div class="release-total" aria-label={`${unreleasedChangeCount} changes`}>
            <strong>{unreleasedChangeCount}</strong>
            <span>changes</span>
          </div>

          <div class="install-command">
            <span class="command-prompt" aria-hidden="true">$</span>
            <code>{masterCommand}</code>
            <button type="button" data-copy-text={masterCommand}>
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <rect x="5" y="5" width="8" height="8" rx="1"></rect>
                <path d="M3 11H2.5A1.5 1.5 0 0 1 1 9.5v-7A1.5 1.5 0 0 1 2.5 1h7A1.5 1.5 0 0 1 11 2.5V3"></path>
              </svg>
              <span>Copy</span>
            </button>
          </div>

          {
            unreleasedStats.length > 0 && (
              <dl class="release-stats" aria-label="Changes by section">
                {unreleasedStats.map((section) => (
                  <div data-section={section.key}>
                    <dt>{section.label}</dt>
                    <dd>{section.count}</dd>
                  </div>
                ))}
              </dl>
            )
          }
        </header>

        {
          unreleasedHasBody && UnreleasedBody ? (
            <>
              <div class="release-tools" aria-label="Filter release notes">
                <label class="change-search">
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <circle cx="7" cy="7" r="4.5"></circle>
                    <path d="m10.5 10.5 3 3"></path>
                  </svg>
                  <span class="sr-only">Search release notes</span>
                  <input
                    type="search"
                    placeholder={`Search ${unreleasedChangeCount} changes`}
                    autocomplete="off"
                    data-change-search
                  />
                  <kbd aria-hidden="true">/</kbd>
                </label>

                <div class="section-filters" role="group" aria-label="Change type">
                  <button type="button" data-section-filter="" aria-pressed="true">
                    All
                  </button>
                  {
                    unreleasedStats.map((section) => (
                      <button
                        type="button"
                        data-section-filter={section.key}
                        aria-pressed="false"
                      >
                        {section.label}
                      </button>
                    ))
                  }
                </div>

                <output class="filter-count" data-filter-count aria-live="polite">
                  {unreleasedChangeCount} shown
                </output>
                <button
                  class="expand-notes"
                  type="button"
                  data-expand-notes
                  aria-expanded="false"
                >
                  Expand shown
                </button>
              </div>

              <p class="no-results" data-no-results hidden>
                No release note matches that filter.
              </p>

              <div class="release-body prose prose-changelog">
                <UnreleasedBody components={mdxComponents} />
              </div>
            </>
          ) : (
            <p class="empty-note">
              Nothing unreleased. Track master with the command above.
            </p>
          )
        }
      </article>

      {
        releases.map((release) => (
          <article
            id={release.anchor}
            class="release release-past"
            data-release={release.anchor}
          >
            <header class="release-masthead release-masthead-past">
              <div class="release-intro">
                <p class="release-kicker">Release</p>
                <h2>v{release.version}</h2>
                <time datetime={release.date.toISOString()}>{release.dateLabel}</time>
              </div>

              <div class="release-total" aria-label={`${release.changeCount} changes`}>
                <strong>{release.changeCount}</strong>
                <span>changes</span>
              </div>

              {release.stats.length > 0 && (
                <dl class="release-stats" aria-label="Changes by section">
                  {release.stats.map((section) => (
                    <div data-section={section.key}>
                      <dt>{section.label}</dt>
                      <dd>{section.count}</dd>
                    </div>
                  ))}
                </dl>
              )}
            </header>

            <div class="release-body prose prose-changelog">
              <release.Body components={mdxComponents} />
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* Release-ledger layout: broad masthead, narrow reading measure. */
  .changelog {
    width: min(calc(100% - 3rem), 78rem);
    margin: 0 auto;
    padding: 4.6rem 0 7rem;
  }

  .changelog-hero {
    max-width: 70rem;
    margin: 0 auto;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.1rem;
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 550;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hero-eyebrow span {
    color: var(--color-kolu-bottom);
    font-size: 0.95rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    align-items: end;
    gap: 3rem;
  }

  .hero-grid h1 {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(4.1rem, 8.5vw, 7rem);
  }

  .hero-grid h1 span {
    color: var(--color-kolu-primary);
  }

  .hero-grid > p {
    max-width: 31rem;
    margin: 0 0 0.45rem;
    padding-left: 1.15rem;
    border-left: 1px solid var(--color-kolu-bottom);
    color: var(--color-ink-dim);
    font-size: 1.03rem;
    line-height: 1.65;
  }

  .release-nav {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    margin-top: 3.25rem;
    border-top: 1px solid var(--color-rule-strong);
    border-bottom: 1px solid var(--color-rule-strong);
  }

  .release-nav-label {
    display: flex;
    align-items: center;
    padding: 0.9rem 1rem 0.9rem 0;
    border-right: 1px solid var(--color-rule);
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .release-nav-links {
    display: flex;
    min-width: 0;
    overflow-x: auto;
  }

  .release-nav a {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.55rem;
    min-width: 11.5rem;
    padding: 0.85rem 1.1rem;
    border-right: 1px solid var(--color-rule);
    color: var(--color-ink-dim);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-decoration: none;
    transition:
      color 150ms ease,
      background 150ms ease;
  }

  .release-nav a:hover {
    color: var(--color-ink);
    background: color-mix(
      in srgb,
      var(--color-kolu-primary) 5%,
      transparent
    );
  }

  .release-nav a.is-current {
    color: var(--color-kolu-primary);
  }

  .release-nav small {
    margin-left: auto;
    color: var(--color-ink-muted);
    font-size: 0.58rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .release-live {
    display: inline-block;
    width: 0.42rem;
    height: 0.42rem;
    flex: none;
    border-radius: 50%;
    background: var(--color-kolu-bottom-strong);
    box-shadow: 0 0 0 3px
      color-mix(in srgb, var(--color-kolu-bottom-strong) 12%, transparent);
  }

  .release {
    scroll-margin-top: 5rem;
  }

  .release-current {
    margin-top: 3rem;
  }

  .release-past {
    margin-top: 8rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-rule-strong);
  }

  .release-masthead {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 11rem;
    overflow: hidden;
    border: 1px solid var(--color-rule-strong);
    border-top: 2px solid var(--color-kolu-primary);
    border-radius: 9px;
    background: color-mix(
      in srgb,
      var(--color-void-raised) 90%,
      var(--color-void)
    );
    box-shadow: 0 18px 55px -44px var(--color-kolu-primary);
  }

  .release-masthead::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.45;
    background-image:
      linear-gradient(var(--color-rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-rule) 1px, transparent 1px);
    background-size: 2.25rem 2.25rem;
    mask-image: linear-gradient(90deg, transparent 15%, black 100%);
    pointer-events: none;
  }

  .release-masthead > * {
    position: relative;
    z-index: 1;
  }

  .release-intro {
    padding: 2.15rem 2.4rem 2.25rem;
  }

  .release-kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.9rem;
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 550;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .release-intro h2 {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(2.6rem, 5vw, 4rem);
    font-weight: 690;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  .release-deck,
  .release-intro time {
    display: block;
    margin: 1rem 0 0;
    color: var(--color-ink-dim);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .release-intro time {
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .release-total {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-left: 1px solid var(--color-rule-strong);
    background: color-mix(in srgb, var(--color-void-sunk) 55%, transparent);
  }

  .release-total strong {
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 3.35rem;
    font-weight: 420;
    letter-spacing: -0.08em;
    line-height: 1;
  }

  .release-total span {
    margin-top: 0.45rem;
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .install-command {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    min-width: 0;
    padding: 0.72rem 0.8rem 0.72rem 1rem;
    border-top: 1px solid var(--color-rule-strong);
    background: var(--color-void-sunk);
    font-family: var(--font-mono);
  }

  .command-prompt {
    margin-right: 0.7rem;
    color: var(--color-kolu-bottom);
    font-size: 0.78rem;
  }

  .install-command code {
    overflow: hidden;
    min-width: 0;
    color: var(--color-kolu-top-strong);
    font-size: 0.75rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .install-command button {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    margin-left: auto;
    padding: 0.42rem 0.6rem;
    border: 1px solid var(--color-rule-strong);
    border-radius: 4px;
    color: var(--color-ink-dim);
    background: var(--color-void-raised);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    cursor: pointer;
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }

  .install-command button:hover {
    color: var(--color-ink);
    border-color: var(--color-kolu-primary);
  }

  .install-command button[data-state="copied"] {
    color: var(--color-kolu-bottom-strong);
    border-color: var(--color-kolu-bottom-strong);
  }

  .install-command button[data-state="error"] {
    color: var(--color-kolu-primary-hover);
    border-color: var(--color-kolu-primary-hover);
  }

  .install-command svg {
    width: 0.78rem;
    height: 0.78rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
  }

  .release-stats {
    grid-column: 1 / -1;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    margin: 0;
    border-top: 1px solid var(--color-rule-strong);
    background: color-mix(in srgb, var(--color-void-raised) 82%, transparent);
  }

  .release-stats > div {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.85rem 1.1rem;
  }

  .release-stats > div + div {
    border-left: 1px solid var(--color-rule);
  }

  .release-stats > div::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--section-accent, var(--color-kolu-primary));
    opacity: 0.75;
  }

  .release-stats > [data-section="added"] {
    --section-accent: var(--color-kolu-bottom);
  }

  .release-stats > [data-section="changed"] {
    --section-accent: var(--color-kolu-top);
  }

  .release-stats > [data-section="fixed"] {
    --section-accent: var(--color-kolu-primary);
  }

  .release-stats > [data-section="heads-up"] {
    --section-accent: var(--color-kolu-top-strong);
  }

  .release-stats dt {
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.61rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .release-stats dd {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 500;
  }

  .release-tools {
    position: sticky;
    top: 3.5rem;
    z-index: 8;
    display: none;
    grid-template-columns: minmax(13rem, 1fr) auto auto auto;
    align-items: center;
    gap: 0.55rem;
    margin: 1.35rem 0 0;
    padding: 0.45rem;
    border: 1px solid var(--color-rule-strong);
    border-radius: 6px;
    background: color-mix(in srgb, var(--color-void) 88%, transparent);
    box-shadow: 0 12px 24px -20px rgb(0 0 0 / 0.7);
    backdrop-filter: blur(12px);
  }

  .release-tools[data-enhanced="true"] {
    display: grid;
  }

  .change-search {
    display: flex;
    align-items: center;
    min-width: 0;
    padding: 0.45rem 0.55rem;
    border-right: 1px solid var(--color-rule);
    color: var(--color-ink-muted);
  }

  .change-search svg {
    width: 0.9rem;
    height: 0.9rem;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.35;
  }

  .change-search input {
    width: 100%;
    min-width: 0;
    margin: 0 0.6rem;
    border: 0;
    outline: 0;
    color: var(--color-ink);
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .change-search input::placeholder {
    color: var(--color-ink-muted);
  }

  .change-search:focus-within {
    color: var(--color-kolu-primary);
  }

  .change-search kbd {
    padding: 0.1rem 0.3rem;
    border: 1px solid var(--color-rule-strong);
    border-radius: 3px;
    color: var(--color-ink-muted);
    background: var(--color-void-raised);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .section-filters {
    display: flex;
    gap: 0.15rem;
  }

  .section-filters button,
  .expand-notes {
    padding: 0.42rem 0.58rem;
    border: 1px solid transparent;
    border-radius: 3px;
    color: var(--color-ink-muted);
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.025em;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 150ms ease,
      border-color 150ms ease,
      background 150ms ease;
  }

  .section-filters button:hover,
  .expand-notes:hover {
    color: var(--color-ink);
    border-color: var(--color-rule-strong);
  }

  .section-filters button[aria-pressed="true"] {
    color: var(--color-kolu-primary);
    border-color: color-mix(
      in srgb,
      var(--color-kolu-primary) 36%,
      var(--color-rule)
    );
    background: color-mix(
      in srgb,
      var(--color-kolu-primary) 8%,
      transparent
    );
  }

  .filter-count {
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.59rem;
    white-space: nowrap;
  }

  .expand-notes {
    border-left-color: var(--color-rule);
    border-radius: 0;
  }

  .expand-notes:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .release-body {
    width: min(100%, 64rem);
    max-width: none;
    margin: 3.4rem auto 0;
    counter-reset: changelog-section;
  }

  .changelog :global(.prose-changelog) {
    max-width: none;
    color: var(--color-ink-dim);
  }

  .changelog :global(.prose-changelog > p:first-child) {
    max-width: 50rem;
    margin: 0 0 3rem;
    color: var(--color-ink-dim);
    font-size: 1.03rem;
    line-height: 1.72;
  }

  .changelog :global(.prose-changelog h3) {
    display: grid;
    grid-template-columns: 2rem max-content minmax(2rem, 1fr);
    align-items: center;
    gap: 0.8rem;
    margin: 5rem 0 1.6rem;
    padding: 0;
    border: 0;
    color: var(--color-ink);
    font-size: clamp(1.8rem, 3vw, 2.55rem);
    font-weight: 680;
    letter-spacing: -0.04em;
    line-height: 1;
    text-transform: none;
    scroll-margin-top: 8.5rem;
    counter-increment: changelog-section;
  }

  .changelog :global(.prose-changelog h3:first-child) {
    margin-top: 0.25rem;
  }

  .changelog :global(.prose-changelog h3::before) {
    content: "0" counter(changelog-section);
    color: var(--section-accent, var(--color-kolu-primary));
    font-family: var(--font-mono);
    font-size: 0.63rem;
    font-weight: 550;
    letter-spacing: 0.08em;
  }

  .changelog :global(.prose-changelog h3::after) {
    content: "";
    width: 100%;
    height: 1px;
    background: linear-gradient(
      90deg,
      color-mix(
        in srgb,
        var(--section-accent, var(--color-kolu-primary)) 55%,
        var(--color-rule)
      ),
      var(--color-rule)
    );
  }

  .changelog :global(.prose-changelog h3[data-section="added"]) {
    --section-accent: var(--color-kolu-bottom);
  }

  .changelog :global(.prose-changelog h3[data-section="changed"]) {
    --section-accent: var(--color-kolu-top);
  }

  .changelog :global(.prose-changelog h3[data-section="fixed"]) {
