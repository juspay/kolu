---
import { type CollectionEntry, getCollection, render } from "astro:content";
import {
  changelogInstallCommand,
  changelogReleaseKey,
  readChangelogStats,
} from "../changelog";
import Change from "../components/Change.astro";
import InstallCommand from "../components/InstallCommand.astro";
import PR from "../components/PR.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const mdxComponents = { PR, Change };
const masterCommand = changelogInstallCommand();
const repositoryUrl = "https://github.com/juspay/kolu";
const versionOrder = new Intl.Collator("en", { numeric: true });

const fmtDate = (date: Date) =>
  date
    .toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "2-digit",
      timeZone: "UTC",
    })
    .toUpperCase();

type ChangelogEntry = CollectionEntry<"changelog">;
type UnreleasedEntry = ChangelogEntry & {
  data: ChangelogEntry["data"] & { version: "Unreleased"; date?: undefined };
};
type ReleasedEntry = ChangelogEntry & {
  data: ChangelogEntry["data"] & { version: string; date: Date };
};
const isUnreleased = (entry: ChangelogEntry): entry is UnreleasedEntry =>
  entry.data.version === "Unreleased";
const isReleased = (entry: ChangelogEntry): entry is ReleasedEntry =>
  entry.data.version !== "Unreleased" && entry.data.date instanceof Date;

const all = await getCollection("changelog");
const unreleasedEntries = all.filter(isUnreleased);
const unreleased = unreleasedEntries.at(0);
if (unreleasedEntries.length !== 1 || !unreleased)
  throw new Error(
    `Changelog requires exactly one Unreleased entry, found ${unreleasedEntries.length}`,
  );

const released = all
  .filter(isReleased)
  .sort(
    (a, b) =>
      b.data.date.valueOf() - a.data.date.valueOf() ||
      versionOrder.compare(b.data.version, a.data.version) ||
      a.id.localeCompare(b.id),
  );
const releasedVersions = new Set<string>();
for (const entry of released) {
  if (releasedVersions.has(entry.data.version))
    throw new Error(`Changelog has duplicate release version ${entry.data.version}`);
  releasedVersions.add(entry.data.version);
}

const unreleasedHasBody = !!unreleased.body?.trim();
const renderedUnreleased = await render(unreleased);
const unreleasedStats = readChangelogStats(
  renderedUnreleased.remarkPluginFrontmatter.changelogStats,
);
const unreleasedChangeCount = unreleasedStats.reduce(
  (total, section) => total + section.count,
  0,
);
const UnreleasedBody = renderedUnreleased.Content;

const releases = await Promise.all(
  released.map(async (entry) => {
    const date = entry.data.date;
    const rendered = await render(entry);
    const stats = readChangelogStats(rendered.remarkPluginFrontmatter.changelogStats);
    const tag = `v${entry.data.version}`;
    return {
      version: entry.data.version,
      tag,
      date,
      dateLabel: fmtDate(date),
      anchor: changelogReleaseKey(entry.data.version),
      releaseUrl: `${repositoryUrl}/releases/tag/${tag}`,
      installCommand: changelogInstallCommand(tag),
      changeCount: stats.reduce((total, section) => total + section.count, 0),
      stats,
      Body: rendered.Content,
    };
  }),
);

const previousVersion = releases[0]?.version;
---

<BaseLayout
  title="Changelog"
  description="Every user-facing change in kolu, newest first."
  searchSection="Changelog"
>
  <section class="changelog">
    <header class="changelog-hero reveal reveal-1">
      <p class="hero-eyebrow">
        <span aria-hidden="true">↳</span>
        Release notes
      </p>
      <div class="hero-grid">
        <h1 class="display">Changelog<span>.</span></h1>
        <p>
          What changed, why it matters, and the work behind it. Product notes,
          not a commit dump. Newest first.
        </p>
      </div>
    </header>

    <nav class="release-nav reveal reveal-2" aria-label="Changelog releases">
      <span class="release-nav-label">Releases</span>
      <div class="release-nav-links">
        <a href="#unreleased" class="is-current">
          <span class="release-live" aria-hidden="true"></span>
          <span>Unreleased</span>
          <small>{unreleasedChangeCount} changes</small>
        </a>
        {
          releases.map((release) => (
            <a href={`#${release.anchor}`}>
              <span>v{release.version}</span>
              <small>{release.dateLabel}</small>
            </a>
          ))
        }
      </div>
    </nav>

    <div class="release-stream">
      <article
        id="unreleased"
        class="release release-current reveal reveal-3"
        data-release="unreleased"
        data-filterable={unreleasedHasBody || undefined}
      >
        <header class="release-masthead">
          <div class="release-intro">
            <p class="release-kicker">
              <span class="release-live" aria-hidden="true"></span>
              Next release · live on master
            </p>
            <h2>Unreleased</h2>
            <p class="release-deck">
              {
                previousVersion
                  ? `Everything that has landed since v${previousVersion}.`
                  : "Everything that has landed before the first numbered release."
              }
            </p>
          </div>

          <div class="release-total" aria-label={`${unreleasedChangeCount} changes`}>
            <strong>{unreleasedChangeCount}</strong>
            <span>changes</span>
          </div>

          <InstallCommand command={masterCommand} />

          {
            unreleasedStats.length > 0 && (
              <dl class="release-stats" aria-label="Changes by type">
                {unreleasedStats.map((section) => (
                  <div data-kind={section.key}>
                    <dt>{section.label}</dt>
                    <dd>{section.count}</dd>
                  </div>
                ))}
              </dl>
            )
          }
        </header>

        {
          unreleasedHasBody && UnreleasedBody ? (
            <>
              <div class="release-tools" aria-label="Filter release notes">
                <label class="change-search">
                  <span class="sr-only">Search release notes</span>
                  <input
                    type="search"
                    name="release-note-search"
                    placeholder={`Search ${unreleasedChangeCount} changes`}
                    autocomplete="off"
                    data-change-search
                  />
                  <kbd aria-hidden="true">/</kbd>
                </label>

                <div class="kind-filters" role="group" aria-label="Change type">
                  <button type="button" data-kind-filter="all" aria-pressed="true">
                    All
                  </button>
                  {
                    unreleasedStats.map((section) => (
                      <button
                        type="button"
                        data-kind-filter={section.key}
                        aria-pressed="false"
                      >
                        {section.label}
                      </button>
                    ))
                  }
                </div>

                <output class="filter-count" data-filter-count aria-live="polite">
                  {unreleasedChangeCount} shown
                </output>
                <button
                  class="expand-notes"
                  type="button"
                  data-expand-notes
                  aria-expanded="false"
                >
                  Expand shown
                </button>
              </div>

              <p class="no-results" data-no-results hidden>
                No release note matches that filter.
              </p>

              <div class="release-body prose prose-changelog">
                <UnreleasedBody components={mdxComponents} />
              </div>
            </>
          ) : (
            <p class="empty-note">
              Nothing unreleased. Track master with the command above.
            </p>
          )
        }
      </article>

      {
        releases.map((release) => (
          <article
            id={release.anchor}
            class="release release-past"
            data-release={release.anchor}
          >
            <header class="release-masthead release-masthead-past">
              <div class="release-intro">
                <p class="release-kicker">Release</p>
                <h2>
                  <a
                    class="release-version-link"
                    href={release.releaseUrl}
                    aria-label={`View ${release.tag} on GitHub`}
                  >
                    {release.tag}<span aria-hidden="true">↗</span>
                  </a>
                </h2>
                <time datetime={release.date.toISOString()}>{release.dateLabel}</time>
              </div>

              <div class="release-total" aria-label={`${release.changeCount} changes`}>
                <strong>{release.changeCount}</strong>
                <span>changes</span>
              </div>

              <InstallCommand command={release.installCommand} />

              {release.stats.length > 0 && (
                <dl class="release-stats" aria-label="Changes by section">
                  {release.stats.map((section) => (
                    <div data-section={section.key}>
                      <dt>{section.label}</dt>
                      <dd>{section.count}</dd>
                    </div>
                  ))}
                </dl>
              )}
            </header>

            <div class="release-body prose prose-changelog">
              <release.Body components={mdxComponents} />
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* The release body is emitted by MDX, so its headings/lists cannot carry
     page-local utilities; counters, sticky state, and responsive relationships
     also depend on selectors across those generated nodes. */
  .changelog {
    width: min(calc(100% - 3rem), 80rem);
    margin: 0 auto;
    padding: 3rem 0 5rem;
  }

  .changelog-hero {
    max-width: 70rem;
    margin: 0 auto;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 0.65rem;
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 550;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hero-eyebrow span {
    color: var(--color-kolu-bottom);
    font-size: 0.95rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    align-items: end;
    gap: 2rem;
  }

  .hero-grid h1 {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(3.5rem, 7vw, 5.35rem);
  }

  .hero-grid h1 span {
    color: var(--color-kolu-primary);
  }

  .hero-grid > p {
    max-width: 31rem;
    margin: 0 0 0.25rem;
    padding-left: 1rem;
    border-left: 1px solid var(--color-kolu-bottom);
    color: var(--color-ink-dim);
    font-size: 0.94rem;
    line-height: 1.52;
  }

  .release-nav {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    margin-top: 1.75rem;
    border-top: 1px solid var(--color-rule-strong);
    border-bottom: 1px solid var(--color-rule-strong);
  }

  .release-nav-label {
    display: flex;
    align-items: center;
    padding: 0.65rem 0.8rem 0.65rem 0;
    border-right: 1px solid var(--color-rule);
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .release-nav-links {
    display: flex;
    min-width: 0;
    overflow-x: auto;
  }

  .release-nav a {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.55rem;
    min-width: 10.75rem;
    padding: 0.65rem 0.9rem;
    border-right: 1px solid var(--color-rule);
    color: var(--color-ink-dim);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-decoration: none;
    transition:
      color 150ms ease,
      background 150ms ease;
  }

  .release-nav a:hover {
    color: var(--color-ink);
    background: color-mix(
      in srgb,
      var(--color-kolu-primary) 5%,
      transparent
    );
  }

  .release-nav a.is-current {
    color: var(--color-kolu-primary);
  }

  .release-nav small {
    margin-left: auto;
    color: var(--color-ink-muted);
    font-size: 0.58rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .release-live {
    display: inline-block;
    width: 0.42rem;
    height: 0.42rem;
    flex: none;
    border-radius: 50%;
    background: var(--color-kolu-bottom-strong);
    box-shadow: 0 0 0 3px
      color-mix(in srgb, var(--color-kolu-bottom-strong) 12%, transparent);
  }

  .release {
    scroll-margin-top: 5rem;
  }

  .release-current {
    margin-top: 1.65rem;
  }

  .release-past {
    margin-top: 5rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--color-rule-strong);
  }

  .release-masthead {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 9.5rem;
    overflow: hidden;
    border: 1px solid var(--color-rule-strong);
    border-top: 2px solid var(--color-kolu-primary);
    border-radius: 9px;
    background: color-mix(
      in srgb,
      var(--color-void-raised) 90%,
      var(--color-void)
    );
    box-shadow: 0 18px 55px -44px var(--color-kolu-primary);
  }

  .release-masthead::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.45;
    background-image:
      linear-gradient(var(--color-rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-rule) 1px, transparent 1px);
    background-size: 2.25rem 2.25rem;
    mask-image: linear-gradient(90deg, transparent 15%, black 100%);
    pointer-events: none;
  }

  .release-masthead > * {
    position: relative;
    z-index: 1;
  }

  .release-intro {
    padding: 1.35rem 1.6rem 1.4rem;
  }

  .release-kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.55rem;
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 550;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .release-intro h2 {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(2.25rem, 4vw, 3.15rem);
    font-weight: 690;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  .release-deck,
  .release-intro time {
    display: block;
    margin: 0.65rem 0 0;
    color: var(--color-ink-dim);
    font-size: 0.88rem;
    line-height: 1.42;
  }

  .release-intro time {
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .release-version-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  .release-version-link span {
    color: var(--color-kolu-bottom);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0;
    transition: transform 150ms ease;
  }

  .release-version-link:hover span {
    transform: translate(2px, -2px);
  }

  .release-total {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-left: 1px solid var(--color-rule-strong);
    background: color-mix(in srgb, var(--color-void-sunk) 55%, transparent);
  }

  .release-total strong {
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 2.65rem;
    font-weight: 420;
    letter-spacing: -0.08em;
    line-height: 1;
  }

  .release-total span {
    margin-top: 0.3rem;
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .release-stats {
    grid-column: 1 / -1;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    margin: 0;
    border-top: 1px solid var(--color-rule-strong);
    background: color-mix(in srgb, var(--color-void-raised) 82%, transparent);
  }

  .release-stats > div {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
  }

  .release-stats > div + div {
    border-left: 1px solid var(--color-rule);
  }

  .release-stats > div::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--section-accent, var(--color-kolu-primary));
    opacity: 0.75;
  }

  .release-stats > [data-kind="added"],
  .release-stats > [data-section="added"] {
    --section-accent: var(--color-kolu-bottom);
  }

  .release-stats > [data-kind="changed"],
  .release-stats > [data-section="changed"] {
    --section-accent: var(--color-kolu-top);
  }

  .release-stats > [data-kind="fixed"],
  .release-stats > [data-section="fixed"] {
    --section-accent: var(--color-kolu-primary);
  }

  .release-stats > [data-kind="heads-up"],
  .release-stats > [data-section="heads-up"] {
    --section-accent: var(--color-kolu-bottom-deep);
  }

  .release-stats dt {
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.61rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .release-stats dd {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 500;
  }

  .release-tools {
    position: sticky;
    top: 3.5rem;
    z-index: 8;
    display: none;
    grid-template-columns: minmax(13rem, 1fr) auto auto auto;
    align-items: center;
    gap: 0.55rem;
    margin: 0.85rem 0 0;
    padding: 0.35rem;
    border: 1px solid var(--color-rule-strong);
    border-radius: 6px;
    background: color-mix(in srgb, var(--color-void) 88%, transparent);
    box-shadow: 0 12px 24px -20px rgb(0 0 0 / 0.7);
    backdrop-filter: blur(12px);
  }

  .release-tools[data-enhanced="true"] {
    display: grid;
  }

  .change-search {
    display: flex;
    align-items: center;
    min-width: 0;
    padding: 0.38rem 0.5rem;
    border-right: 1px solid var(--color-rule);
    color: var(--color-ink-muted);
  }

  .change-search input {
    width: 100%;
    min-width: 0;
    margin: 0 0.6rem;
    border: 0;
    outline: 0;
    color: var(--color-ink);
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .change-search input::placeholder {
    color: var(--color-ink-muted);
  }

  .change-search:focus-within {
    color: var(--color-kolu-primary);
  }

  .change-search kbd {
    padding: 0.1rem 0.3rem;
    border: 1px solid var(--color-rule-strong);
    border-radius: 3px;
    color: var(--color-ink-muted);
    background: var(--color-void-raised);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .kind-filters {
    display: flex;
    gap: 0.15rem;
  }

  .kind-filters button,
  .expand-notes {
    padding: 0.42rem 0.58rem;
    border: 1px solid transparent;
    border-radius: 3px;
    color: var(--color-ink-muted);
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.025em;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 150ms ease,
      border-color 150ms ease,
      background 150ms ease;
  }

  .kind-filters button:hover,
  .expand-notes:hover {
    color: var(--color-ink);
    border-color: var(--color-rule-strong);
  }

  .kind-filters button[aria-pressed="true"] {
    color: var(--color-kolu-primary);
    border-color: color-mix(
      in srgb,
      var(--color-kolu-primary) 36%,
      var(--color-rule)
    );
    background: color-mix(
      in srgb,
      var(--color-kolu-primary) 8%,
      transparent
    );
  }

  .filter-count {
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.59rem;
    white-space: nowrap;
  }

  .expand-notes {
    border-left-color: var(--color-rule);
    border-radius: 0;
  }

  .expand-notes:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .release-body {
    width: min(100%, 69rem);
    max-width: none;
    margin: 2rem auto 0;
    counter-reset: changelog-section;
  }

  .changelog :global(.prose-changelog) {
    max-width: none;
    color: var(--color-ink-dim);
  }

  .changelog :global(.prose-changelog > p:first-child) {
    max-width: 50rem;
    margin: 0 0 2rem;
    color: var(--color-ink-dim);
    font-size: 0.98rem;
    line-height: 1.62;
  }

  .changelog :global(.prose-changelog h3) {
    display: grid;
    grid-template-columns: 1.7rem minmax(0, max-content) minmax(2rem, 1fr);
    align-items: center;
    gap: 0.8rem;
    margin: 2.65rem 0 0.65rem;
    padding: 0;
    border: 0;
    color: var(--color-ink);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 680;
    letter-spacing: -0.04em;
    line-height: 1;
    text-transform: none;
    scroll-margin-top: 7.5rem;
    counter-increment: changelog-section;
  }

  .changelog :global(.prose-changelog h3:first-child) {
    margin-top: 0.1rem;
  }

  .changelog :global(.prose-changelog h3::before) {
    content: counter(changelog-section, decimal-leading-zero);
    color: var(--color-kolu-primary);
    font-family: var(--font-mono);
    font-size: 0.63rem;
    font-weight: 550;
    letter-spacing: 0.08em;
  }

  .changelog :global(.prose-changelog h3::after) {
    content: "";
    width: 100%;
    height: 1px;
    background: linear-gradient(
      90deg,
      color-mix(
        in srgb,
        var(--color-kolu-primary) 45%,
        var(--color-rule)
      ),
      var(--color-rule)
    );
  }

  .changelog :global(.prose-changelog h3 a) {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    min-width: 0;
    border: 0;
    color: var(--color-ink);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .changelog :global(.prose-changelog h3 a::after) {
    content: "guide ↗";
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    font-weight: 550;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .changelog :global(.prose-changelog h3 a:hover) {
    color: var(--color-kolu-primary);
  }

  .changelog :global(.prose-changelog ul) {
    display: block;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .changelog :global(.prose-changelog li) {
    margin: 0;
    padding: 0;
  }

  .changelog :global(.prose-changelog li:has(.cl-change)::before) {
    content: none;
  }

  .changelog :global(.prose-changelog li:last-child .cl-change) {
