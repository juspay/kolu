  @media (prefers-reduced-motion: reduce) {
    .release-nav a,
    .kind-filters button,
    .expand-notes {
      transition: none;
    }
  }
</style>

<script>
  import { type ChangeKind, isChangeKind } from "../changelog";

  const normalizeSearch = (value: string) => value.toLocaleLowerCase("en-US");

  // The build plugin owns heading IDs. This pass only carries each product-area
  // label onto its notes so a category name is part of the searchable corpus.
  for (const body of document.querySelectorAll<HTMLElement>(".release-body")) {
    let categoryLabel: string | undefined;
    for (const child of body.children) {
      if (child instanceof HTMLHeadingElement && child.tagName === "H3") {
        if (!child.id) throw new Error("A changelog heading is missing its build-time id");
        const candidate = child.textContent?.trim();
        if (!candidate) throw new Error("A changelog category has no label");
        categoryLabel = candidate;
        child.setAttribute("aria-label", categoryLabel);
      }

      if (child instanceof HTMLUListElement) {
        for (const item of child.children) {
          if (!(item instanceof HTMLLIElement) || !item.querySelector(".cl-change")) continue;
          if (categoryLabel === undefined)
            throw new Error("A changelog note appears before its category");
          item.dataset.category = categoryLabel;
        }
      }
    }
  }

  const filterableRelease = document.querySelector<HTMLElement>("[data-filterable]");
  if (filterableRelease) {
    const body = filterableRelease.querySelector<HTMLElement>(".release-body");
    const toolbar = filterableRelease.querySelector<HTMLElement>(".release-tools");
    const search = filterableRelease.querySelector<HTMLInputElement>("[data-change-search]");
    const count = filterableRelease.querySelector<HTMLOutputElement>("[data-filter-count]");
    const noResults = filterableRelease.querySelector<HTMLElement>("[data-no-results]");
    const expand = filterableRelease.querySelector<HTMLButtonElement>("[data-expand-notes]");

    if (!body || !toolbar || !search || !count || !noResults || !expand)
      throw new Error("The filterable changelog release is missing required controls");

    const notes = [...body.querySelectorAll<HTMLLIElement>("li")]
      .filter((item) => item.querySelector(".cl-change"))
      .map((item) => {
        const change = item.querySelector<HTMLDetailsElement>(".cl-change");
        const title = item.querySelector<HTMLElement>(".cl-change-title");
        const noteBody = item.querySelector<HTMLElement>(".cl-change-body");
        const preview = item.querySelector<HTMLElement>("[data-search-preview]");
        const kind = change?.dataset.kind;
        if (!change || !title || !noteBody || !preview || !isChangeKind(kind))
          throw new Error("A changelog note is missing searchable content");

        const bodyText = (noteBody.textContent ?? "").replace(/\s+/g, " ").trim();
        return {
          item,
          change,
          kind,
          preview,
          titleText: normalizeSearch(title.textContent ?? ""),
          categoryText: normalizeSearch(item.dataset.category ?? ""),
          bodyText,
          searchableBodyText: normalizeSearch(bodyText),
        };
      });
    const lists = [...body.querySelectorAll<HTMLUListElement>("ul")];
    const categoryHeadings = [...body.querySelectorAll<HTMLHeadingElement>("h3")];
    const filters = [
      ...filterableRelease.querySelectorAll<HTMLButtonElement>("[data-kind-filter]"),
    ].map((button) => {
      const kind = button.dataset.kindFilter;
      if (kind !== "all" && !isChangeKind(kind))
        throw new Error("A changelog filter has an unknown kind");
      return { button, kind };
    });

    let activeKind: ChangeKind | "all" = "all";

    const visibleDetails = () =>
      notes
        .filter(({ item }) => !item.hidden)
        .map(({ change }) => change);

    const updateExpandButton = () => {
      const details = visibleDetails();
      const allOpen = details.length > 0 && details.every((note) => note.open);
      expand.disabled = details.length === 0;
      expand.setAttribute("aria-expanded", String(allOpen));
      expand.textContent = allOpen ? "Collapse shown" : "Expand shown";
    };

    // A match needs only a short lead-in for orientation, but enough trailing
    // text to explain why it matters. Snap both edges to whole words.
    const SEARCH_CONTEXT_BEFORE = 44;
    const SEARCH_CONTEXT_AFTER = 78;
    const showSearchContext = (
      preview: HTMLElement,
      text: string,
      query: string,
      matchIndex: number,
    ) => {
      let start = Math.max(0, matchIndex - SEARCH_CONTEXT_BEFORE);
      let end = Math.min(text.length, matchIndex + query.length + SEARCH_CONTEXT_AFTER);

      if (start > 0) {
        const nextSpace = text.indexOf(" ", start);
        if (nextSpace !== -1 && nextSpace < matchIndex) start = nextSpace + 1;
      }
      if (end < text.length) {
        const previousSpace = text.lastIndexOf(" ", end);
        if (previousSpace > matchIndex + query.length) end = previousSpace;
      }

      const mark = document.createElement("mark");
      mark.textContent = text.slice(matchIndex, matchIndex + query.length);
      preview.replaceChildren(
        document.createTextNode(`${start > 0 ? "…" : ""}${text.slice(start, matchIndex)}`),
        mark,
        document.createTextNode(
          `${text.slice(matchIndex + query.length, end)}${end < text.length ? "…" : ""}`,
        ),
      );
      preview.hidden = false;
    };

    const applyFilter = () => {
      const query = normalizeSearch(search.value.trim());
      let visibleCount = 0;

      for (const note of notes) {
        const inKind = activeKind === "all" || note.kind === activeKind;
        const bodyMatchIndex = query ? note.searchableBodyText.indexOf(query) : -1;
        const titleMatches = !!query && note.titleText.includes(query);
        const categoryMatches = !!query && note.categoryText.includes(query);
        const matchesText =
          !query || titleMatches || categoryMatches || bodyMatchIndex !== -1;

        note.preview.hidden = true;
        note.preview.replaceChildren();
        if (query && !titleMatches && !categoryMatches && bodyMatchIndex !== -1)
          showSearchContext(note.preview, note.bodyText, query, bodyMatchIndex);

        note.item.hidden = !(inKind && matchesText);
        if (!note.item.hidden) visibleCount += 1;
      }

      for (const list of lists) {
        list.hidden = ![...list.children].some(
          (item) => item instanceof HTMLLIElement && !item.hidden,
        );
      }

      for (const heading of categoryHeadings) {
        let sibling = heading.nextElementSibling;
        let hasVisibleList = false;
        while (sibling && sibling.tagName !== "H3") {
          if (sibling instanceof HTMLUListElement && !sibling.hidden) {
            hasVisibleList = true;
            break;
          }
          sibling = sibling.nextElementSibling;
        }
        heading.hidden = !hasVisibleList;
      }

      for (const filter of filters)
        filter.button.setAttribute("aria-pressed", String(filter.kind === activeKind));

      count.textContent = `${visibleCount} shown`;
      noResults.hidden = visibleCount !== 0;
      updateExpandButton();
    };

    for (const filter of filters) {
      filter.button.addEventListener("click", () => {
        activeKind = filter.kind;
        applyFilter();
      });
    }

    let pendingFilter: number | undefined;
    search.addEventListener("input", () => {
      if (pendingFilter !== undefined) window.clearTimeout(pendingFilter);
      pendingFilter = window.setTimeout(() => {
        pendingFilter = undefined;
        applyFilter();
      }, 75);
    });
    expand.addEventListener("click", () => {
      const details = visibleDetails();
      const shouldOpen = !details.every((note) => note.open);
      for (const note of details) note.open = shouldOpen;
      updateExpandButton();
    });
    body.addEventListener("toggle", updateExpandButton, true);

    document.addEventListener("keydown", (event) => {
      const target = event.target;
      const isTyping =
        target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement ||
        (target instanceof HTMLElement && target.isContentEditable);

      if (
        event.key === "/" &&
        !event.metaKey &&
        !event.ctrlKey &&
        !event.altKey &&
        !isTyping
      ) {
        event.preventDefault();
        search.focus();
      }

      if (event.key === "Escape" && (search.value || activeKind !== "all")) {
        if (pendingFilter !== undefined) {
          window.clearTimeout(pendingFilter);
          pendingFilter = undefined;
        }
        search.value = "";
        activeKind = "all";
        applyFilter();
        search.focus();
      }
    });

    toolbar.dataset.enhanced = "true";
    applyFilter();
  }
</script>
