  }

  .changelog :global(.prose-changelog h3[data-section="heads-up"]) {
    --section-accent: var(--color-kolu-top-strong);
  }

  .changelog :global(.prose-changelog h4) {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 2.2rem 0 0.35rem;
    color: var(--color-ink-dim);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 550;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-transform: uppercase;
    scroll-margin-top: 8.5rem;
  }

  .changelog :global(.prose-changelog h3 + h4) {
    margin-top: 0;
  }

  .changelog :global(.prose-changelog h4::before) {
    content: "";
    width: 1.35rem;
    height: 1px;
    flex: none;
    background: var(--color-rule-strong);
  }

  .changelog :global(.prose-changelog h4 a) {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    color: inherit;
    border: 0;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .changelog :global(.prose-changelog h4 a::after) {
    content: "guide ↗";
    color: var(--color-ink-muted);
    font-size: 0.56rem;
    letter-spacing: 0.04em;
    opacity: 0.8;
  }

  .changelog :global(.prose-changelog h4 a:hover) {
    color: var(--color-kolu-primary);
  }

  .changelog :global(.prose-changelog ul) {
    display: block;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .changelog :global(.prose-changelog li) {
    margin: 0;
    padding: 0;
  }

  .changelog :global(.prose-changelog li:has(.cl-change)::before) {
    content: none;
  }

  .changelog :global(.prose-changelog li:last-child .cl-change) {
    border-bottom: 1px solid var(--color-rule);
  }

  .changelog :global(.prose-changelog ul[data-section="added"] .cl-change) {
    --note-accent: var(--color-kolu-bottom);
  }

  .changelog :global(.prose-changelog ul[data-section="changed"] .cl-change) {
    --note-accent: var(--color-kolu-top);
  }

  .changelog :global(.prose-changelog ul[data-section="fixed"] .cl-change) {
    --note-accent: var(--color-kolu-primary);
  }

  .changelog :global(.prose-changelog ul[data-section="heads-up"] .cl-change) {
    --note-accent: var(--color-kolu-top-strong);
  }

  .changelog :global(.prose-changelog li:not(:has(.cl-change))) {
    position: relative;
    margin: 0;
    padding: 0.95rem 0.25rem 0.95rem 1.75rem;
    border-top: 1px solid var(--color-rule);
    color: var(--color-ink-dim);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .changelog :global(.prose-changelog li:not(:has(.cl-change)):last-child) {
    border-bottom: 1px solid var(--color-rule);
  }

  .changelog :global(.prose-changelog li:not(:has(.cl-change))::before) {
    content: "→";
    position: absolute;
    top: 1.08rem;
    left: 0.25rem;
    color: var(--color-kolu-bottom);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .changelog :global(.prose-changelog strong) {
    color: var(--color-ink);
    font-weight: 620;
  }

  .changelog :global(.prose-changelog code),
  .changelog :global(.prose-changelog kbd) {
    color: var(--color-kolu-top-strong);
  }

  .changelog :global(.prose-changelog [hidden]),
  .changelog :global(.prose-changelog li[hidden]) {
    display: none;
  }

  .no-results,
  .empty-note {
    width: min(100%, 64rem);
    margin: 3rem auto 0;
    padding: 2rem;
    border: 1px dashed var(--color-rule-strong);
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-align: center;
  }

  .no-results[hidden] {
    display: none;
  }

  .release-masthead-past {
    border-top-color: var(--color-kolu-bottom);
    box-shadow: 0 18px 55px -48px var(--color-kolu-bottom);
  }

  .release-masthead-past .release-intro {
    padding-block: 1.8rem;
  }

  .release-masthead-past .release-intro h2 {
    font-size: clamp(2.3rem, 4.5vw, 3.4rem);
  }

  @media (max-width: 980px) {
    .release-tools[data-enhanced="true"] {
      grid-template-columns: minmax(12rem, 1fr) auto auto;
    }

    .section-filters {
      grid-column: 1 / -1;
      grid-row: 2;
      overflow-x: auto;
      padding-top: 0.35rem;
      border-top: 1px solid var(--color-rule);
    }

    .filter-count {
      grid-column: 2;
      grid-row: 1;
    }

    .expand-notes {
      grid-column: 3;
      grid-row: 1;
    }
  }

  @media (max-width: 740px) {
    .changelog {
      width: min(calc(100% - 2rem), 78rem);
      padding: 3rem 0 5rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }

    .hero-grid h1 {
      font-size: clamp(3.35rem, 17vw, 5rem);
    }

    .hero-grid > p {
      max-width: 32rem;
      margin: 0;
      font-size: 0.96rem;
    }

    .release-nav {
      grid-template-columns: 5.75rem minmax(0, 1fr);
      margin-top: 2.4rem;
    }

    .release-nav a {
      min-width: 10.5rem;
    }

    .release-current {
      margin-top: 2rem;
    }

    .release-masthead {
      grid-template-columns: minmax(0, 1fr) 7rem;
    }

    .release-intro {
      padding: 1.65rem 1.4rem 1.75rem;
    }

    .release-total strong {
      font-size: 2.6rem;
    }

    .release-stats {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, 1fr);
    }

    .release-stats > div:nth-child(odd) {
      border-left: 0;
    }

    .release-stats > div:nth-child(n + 3) {
      border-top: 1px solid var(--color-rule);
    }

    .release-tools {
      top: 3.5rem;
    }

    .release-body {
      margin-top: 2.8rem;
    }

    .changelog :global(.prose-changelog h3) {
      grid-template-columns: 1.55rem max-content minmax(1rem, 1fr);
      gap: 0.6rem;
      margin-top: 4rem;
      font-size: 1.75rem;
      scroll-margin-top: 10.5rem;
    }

    .changelog :global(.prose-changelog h4) {
      margin-top: 1.8rem;
      scroll-margin-top: 10.5rem;
    }

    .release-past {
      margin-top: 6rem;
    }
  }

  @media (max-width: 560px) {
    .release-masthead {
      grid-template-columns: 1fr;
    }

    .release-total {
      flex-direction: row;
      justify-content: flex-start;
      gap: 0.75rem;
      padding: 0.9rem 1.4rem;
      border-top: 1px solid var(--color-rule-strong);
      border-left: 0;
    }

    .release-total strong {
      font-size: 1.7rem;
      letter-spacing: -0.05em;
    }

    .release-total span {
      margin: 0;
    }

    .install-command code {
      font-size: 0.67rem;
    }

    .install-command button span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .release-tools[data-enhanced="true"] {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .change-search {
      border-right: 0;
    }

    .filter-count {
      display: none;
    }

    .expand-notes {
      grid-column: 2;
    }

    .section-filters {
      grid-column: 1 / -1;
    }

    .changelog :global(.prose-changelog h3) {
      grid-template-columns: 1.3rem max-content minmax(0.5rem, 1fr);
      gap: 0.5rem;
      font-size: 1.55rem;
    }

    .changelog :global(.prose-changelog h3::before) {
      font-size: 0.56rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .release-nav a,
    .install-command button,
    .section-filters button,
    .expand-notes {
      transition: none;
    }
  }
</style>

<script>
  const slugifyHeading = (value: string) =>
    value
      .toLowerCase()
      .replace(/&/g, "and")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "");

  // Each MDX document owns its own heading slugger, so two releases otherwise
  // emit duplicate `#added` / `#fixed` ids on the combined page. Prefix every
  // rendered heading with its release id and annotate the lists from the same
  // heading structure for filtering and section colour.
  for (const release of document.querySelectorAll<HTMLElement>("[data-release]")) {
    const releaseKey = release.dataset.release;
    if (!releaseKey) throw new Error("Changelog release is missing data-release");

    const body = release.querySelector<HTMLElement>(".release-body");
    if (!body) continue;

    let sectionKey = "";
    for (const child of body.children) {
      if (child instanceof HTMLHeadingElement) {
        const originalId = child.id || slugifyHeading(child.textContent ?? "");
        child.id = `${releaseKey}-${originalId}`;

        if (child.tagName === "H3") {
          const headingLabel = child.textContent?.trim() ?? "";
          sectionKey = slugifyHeading(headingLabel);
          child.setAttribute("aria-label", headingLabel);
          child.dataset.section = sectionKey;
        } else if (child.tagName === "H4") {
          child.dataset.section = sectionKey;
        }
      }

      if (child instanceof HTMLUListElement) {
        child.dataset.section = sectionKey;
        for (const item of child.children) {
          if (item instanceof HTMLLIElement) item.dataset.section = sectionKey;
        }
      }
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-text]")) {
    const label = button.querySelector("span");
    if (!label) throw new Error("Changelog copy button is missing its label");

    button.addEventListener("click", async () => {
      const text = button.dataset.copyText;
      if (!text) throw new Error("Changelog copy button is missing data-copy-text");

      try {
        await navigator.clipboard.writeText(text);
        button.dataset.state = "copied";
        label.textContent = "Copied";
      } catch (error) {
        console.error("Failed to copy the changelog install command", error);
        button.dataset.state = "error";
        label.textContent = "Copy failed";
      }

      window.setTimeout(() => {
        delete button.dataset.state;
        label.textContent = "Copy";
      }, 1800);
    });
  }

  const filterableRelease = document.querySelector<HTMLElement>("[data-filterable]");
  if (filterableRelease) {
    const body = filterableRelease.querySelector<HTMLElement>(".release-body");
    const toolbar = filterableRelease.querySelector<HTMLElement>(".release-tools");
    const search = filterableRelease.querySelector<HTMLInputElement>("[data-change-search]");
    const count = filterableRelease.querySelector<HTMLOutputElement>("[data-filter-count]");
    const noResults = filterableRelease.querySelector<HTMLElement>("[data-no-results]");
    const expand = filterableRelease.querySelector<HTMLButtonElement>("[data-expand-notes]");

    if (!body || !toolbar || !search || !count || !noResults || !expand)
      throw new Error("The filterable changelog release is missing required controls");

    const notes = [...body.querySelectorAll<HTMLLIElement>("li")].filter((item) =>
      item.querySelector(".cl-change"),
    );
    const lists = [...body.querySelectorAll<HTMLUListElement>("ul")];
    const sectionHeadings = [...body.querySelectorAll<HTMLHeadingElement>("h3")];
    const groupHeadings = [...body.querySelectorAll<HTMLHeadingElement>("h4")];
    const filterButtons = [
      ...filterableRelease.querySelectorAll<HTMLButtonElement>("[data-section-filter]"),
    ];

    let activeSection = "";

    const visibleDetails = () =>
      notes
        .filter((note) => !note.hidden)
        .map((note) => note.querySelector<HTMLDetailsElement>(".cl-change"))
        .filter((details): details is HTMLDetailsElement => details !== null);

    const updateExpandButton = () => {
      const details = visibleDetails();
      const allOpen = details.length > 0 && details.every((note) => note.open);
      expand.disabled = details.length === 0;
      expand.setAttribute("aria-expanded", String(allOpen));
      expand.textContent = allOpen ? "Collapse shown" : "Expand shown";
    };

    const showSearchContext = (
      preview: HTMLElement,
      text: string,
      query: string,
      matchIndex: number,
    ) => {
      const beforeRadius = 44;
      const afterRadius = 78;
      let start = Math.max(0, matchIndex - beforeRadius);
      let end = Math.min(text.length, matchIndex + query.length + afterRadius);

      if (start > 0) {
        const nextSpace = text.indexOf(" ", start);
        if (nextSpace !== -1 && nextSpace < matchIndex) start = nextSpace + 1;
      }
      if (end < text.length) {
        const previousSpace = text.lastIndexOf(" ", end);
        if (previousSpace > matchIndex + query.length) end = previousSpace;
      }

      const mark = document.createElement("mark");
      mark.textContent = text.slice(matchIndex, matchIndex + query.length);
      preview.replaceChildren(
        document.createTextNode(`${start > 0 ? "…" : ""}${text.slice(start, matchIndex)}`),
        mark,
        document.createTextNode(
          `${text.slice(matchIndex + query.length, end)}${end < text.length ? "…" : ""}`,
        ),
      );
      preview.hidden = false;
    };

    const applyFilter = () => {
      const query = search.value.trim().toLocaleLowerCase();
      let visibleCount = 0;

      for (const note of notes) {
        const inSection = !activeSection || note.dataset.section === activeSection;
        const title = note.querySelector<HTMLElement>(".cl-change-title");
        const body = note.querySelector<HTMLElement>(".cl-change-body");
        const preview = note.querySelector<HTMLElement>("[data-search-preview]");
        if (!title || !body || !preview)
          throw new Error("A changelog note is missing searchable content");

        const titleText = title.textContent?.toLocaleLowerCase() ?? "";
        const bodyText = (body.textContent ?? "").replace(/\s+/g, " ").trim();
        const bodyMatchIndex = query
          ? bodyText.toLocaleLowerCase().indexOf(query)
          : -1;
        const titleMatches = !!query && titleText.includes(query);
        const matchesText = !query || titleMatches || bodyMatchIndex !== -1;

        preview.hidden = true;
        preview.replaceChildren();
        if (query && !titleMatches && bodyMatchIndex !== -1)
          showSearchContext(preview, bodyText, query, bodyMatchIndex);

        note.hidden = !(inSection && matchesText);
        if (!note.hidden) visibleCount += 1;
      }

      for (const list of lists) {
        list.hidden = ![...list.children].some(
          (item) => item instanceof HTMLLIElement && !item.hidden,
        );
      }

      for (const heading of groupHeadings) {
        const list = heading.nextElementSibling;
        heading.hidden = !(list instanceof HTMLUListElement) || list.hidden;
      }

      for (const heading of sectionHeadings) {
        let sibling = heading.nextElementSibling;
        let hasVisibleList = false;
        while (sibling && sibling.tagName !== "H3") {
          if (sibling instanceof HTMLUListElement && !sibling.hidden) {
            hasVisibleList = true;
            break;
          }
          sibling = sibling.nextElementSibling;
        }
        heading.hidden = !hasVisibleList;
      }

      for (const button of filterButtons)
        button.setAttribute(
          "aria-pressed",
          String((button.dataset.sectionFilter ?? "") === activeSection),
        );

      count.textContent = `${visibleCount} shown`;
      noResults.hidden = visibleCount !== 0;
      updateExpandButton();
    };

    for (const button of filterButtons) {
      button.addEventListener("click", () => {
        activeSection = button.dataset.sectionFilter ?? "";
        applyFilter();
      });
    }

    search.addEventListener("input", applyFilter);
    expand.addEventListener("click", () => {
      const details = visibleDetails();
      const shouldOpen = !details.every((note) => note.open);
      for (const note of details) note.open = shouldOpen;
      updateExpandButton();
    });
    body.addEventListener("toggle", updateExpandButton, true);

    document.addEventListener("keydown", (event) => {
      const target = event.target;
      const isTyping =
        target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement ||
        (target instanceof HTMLElement && target.isContentEditable);

      if (
        event.key === "/" &&
        !event.metaKey &&
        !event.ctrlKey &&
        !event.altKey &&
        !isTyping
      ) {
        event.preventDefault();
        search.focus();
      }

      if (event.key === "Escape" && (search.value || activeSection)) {
        search.value = "";
        activeSection = "";
        applyFilter();
        search.focus();
      }
    });

    toolbar.dataset.enhanced = "true";
    applyFilter();
  }
</script>
