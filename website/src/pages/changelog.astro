      margin-top: 4rem;
    }
  }

  @media (max-width: 560px) {
    .changelog {
      padding-top: 1.65rem;
    }

    .hero-grid h1 {
      font-size: clamp(2.9rem, 14vw, 3.5rem);
    }

    .hero-grid > p {
      font-size: 0.86rem;
