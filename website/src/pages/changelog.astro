---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import PR from "../components/PR.astro";
import Change from "../components/Change.astro";

const mdxComponents = { PR, Change };

const fmtDate = (date: Date) =>
  date
    .toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "2-digit",
      timeZone: "UTC",
    })
    .toUpperCase();

const countChanges = (body?: string) => body?.match(/<Change\b/g)?.length ?? 0;

const semverDesc = (a: string, b: string) => {
  const [aMaj, aMin, aPat] = a.split(".").map(Number);
  const [bMaj, bMin, bPat] = b.split(".").map(Number);
  return (bMaj! - aMaj!) || (bMin! - aMin!) || (bPat! - aPat!);
};

const all = await getCollection("changelog");
const unreleased = all.find((entry) => !entry.data.date);
const released = all
  .filter((entry) => entry.data.date)
  .sort(
    (a, b) =>
      b.data.date!.valueOf() - a.data.date!.valueOf() ||
      semverDesc(a.data.version, b.data.version) ||
      a.id.localeCompare(b.id),
  );

const unreleasedHasBody = !!unreleased?.body?.trim();
const unreleasedChangeCount = countChanges(unreleased?.body);
const UnreleasedBody = unreleased ? (await render(unreleased)).Content : null;

const releases = await Promise.all(
  released.map(async (entry) => {
    const date = entry.data.date!;
    return {
      version: entry.data.version,
      date,
      dateLabel: fmtDate(date),
      anchor: `v${entry.data.version.replace(/\./g, "-")}`,
      changeCount: countChanges(entry.body),
      Body: (await render(entry)).Content,
    };
  }),
);
---

<BaseLayout title="Changelog" description="What's new in kolu, newest first." searchSection="Changelog">
  <section class="changelog">
    <header class="changelog-head">
      <h1>Changelog</h1>
      <p>
        Newest first. On master:
        <code>nix run github:juspay/kolu</code>
      </p>
    </header>

    <div class="release-stream">
      <article class="release">
        <aside class="release-stamp">
          <a href="#unreleased" class="release-link">
            <span id="unreleased">Unreleased</span>
          </a>
          <small>
            {unreleasedChangeCount ? `${unreleasedChangeCount} pending` : "empty"}
          </small>
        </aside>

        <div class="release-body-wrap">
          {
            unreleasedHasBody && UnreleasedBody ? (
              <div class="release-body prose prose-changelog">
                <UnreleasedBody components={mdxComponents} />
              </div>
            ) : (
              <p class="empty-note">
                Nothing unreleased. Track master with the command above.
              </p>
            )
          }
        </div>
      </article>

      {
        releases.map((release) => (
          <article class="release">
            <aside class="release-stamp">
              <a href={`#${release.anchor}`} class="release-link">
                <span id={release.anchor}>v{release.version}</span>
              </a>
              <time datetime={release.date.toISOString()}>{release.dateLabel}</time>
              {release.changeCount > 0 && <small>{release.changeCount} changes</small>}
            </aside>

            <div class="release-body-wrap">
              <div class="release-body prose prose-changelog">
                <release.Body components={mdxComponents} />
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .changelog {
    width: min(100% - 2rem, 72rem);
    margin: 0 auto;
    padding: 2.45rem 0 3.5rem;
  }

  .changelog-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 1.05rem;
  }

  .changelog-head h1 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1;
  }

  .changelog-head p {
    margin: 0;
    color: var(--color-ink-dim);
    font-size: 0.88rem;
    line-height: 1.35;
  }

  .changelog code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    color: var(--color-ink);
    background: var(--color-void-raised);
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    padding: 0.1em 0.38em;
  }

  /* Editorial single column: each release is a stacked block — a version header
     line, then its sections at full measure. No left rail, no per-release rule
     (space separates releases; the version header anchors each). */
  .release {
    display: block;
    padding: 0;
  }

  .release + .release {
    margin-top: 3.2rem;
  }

  /* The version marker as a header line: "Unreleased · 71 pending". */
  .release-stamp {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.7rem;
    margin-bottom: 0.2rem;
  }

  .release-link {
    color: var(--color-ink);
    text-decoration: none;
  }

  .release-link span {
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.1;
    scroll-margin-top: 5rem;
    transition: color 0.15s ease;
  }

  .release-link:hover span {
    color: var(--color-kolu-primary);
  }

  .release-stamp time,
  .release-stamp small {
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.07em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .release-body-wrap {
    min-width: 0;
  }

  .install-note,
  .empty-note {
    margin: 0.7rem 0 0;
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0;
    line-height: 1.25;
  }

  .install-note code,
  .empty-note code {
    margin-left: 0.35rem;
  }

  .changelog :global(.prose-changelog) {
    max-width: none;
  }

  .changelog :global(.prose-changelog > p:first-child) {
    margin: 0.1rem 0 0.8rem;
    color: var(--color-ink-dim);
    font-size: 0.92rem;
    line-height: 1.45;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Type hierarchy reads top-down: the section header (### Added/Changed/Fixed)
     dominates, the #### docs-page subheadings are clearly secondary, and the
     entry rows sit below both. */
  .changelog :global(.prose-changelog h3) {
    margin: 2.1rem 0 0.9rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-rule-strong);
    color: var(--color-ink);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.1;
  }

  .changelog :global(.prose-changelog h3:first-child) {
    margin-top: 0.3rem;
  }

  /* Group headings index entries by their docs page. Secondary to the section
     header — distinguished by size + weight + accent colour, NOT a rule or an
     underline. The link affordance is the accent colour plus a hover ↗. */
  .changelog :global(.prose-changelog h4) {
    margin: 1.5rem 0 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 650;
    letter-spacing: 0;
    line-height: 1.2;
    color: var(--color-kolu-primary);
  }
  .changelog :global(.prose-changelog h3 + h4) {
    margin-top: 0.75rem;
  }
  .changelog :global(.prose-changelog h4 a) {
    color: inherit;
    text-decoration: none;
    border-bottom: 0;
    transition: color 0.15s ease;
  }
  .changelog :global(.prose-changelog h4 a::after) {
    content: " ↗";
    font-size: 0.8em;
    color: var(--color-ink-faint);
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .changelog :global(.prose-changelog h4 a:hover),
  .changelog :global(.prose-changelog h4 a:focus-visible) {
    color: var(--color-kolu-primary-hover);
  }
  .changelog :global(.prose-changelog h4 a:hover::after),
  .changelog :global(.prose-changelog h4 a:focus-visible::after) {
    opacity: 1;
  }

  .changelog :global(.prose-changelog ul) {
    display: grid;
    gap: 0;
  }

  .changelog :global(.prose-changelog li) {
    margin: 0;
  }

  .changelog :global(.prose-changelog li:not(:has(.cl-change))) {
    margin: 0;
    padding-left: 1.05rem;
    color: var(--color-ink-dim);
    font-size: 0.92rem;
    line-height: 1.55;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .changelog :global(.prose-changelog li:not(:has(.cl-change))::before) {
    top: 0;
  }

  .changelog :global(.cl-change) {
    margin-left: -0.25rem;
    margin-right: -0.25rem;
    padding: 0.08rem 0.25rem;
    border-radius: 3px;
  }

  /* Entry head: arrow, title, and the PR chips all flow inline on one baseline —
     the chips sit right after the title text (no ragged right gutter). A long
     title wraps and the chips follow it. */
  .changelog :global(.cl-change-head) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.45rem;
    row-gap: 0.1rem;
    line-height: 1.4;
  }

  .changelog :global(.cl-change-arrow) {
    flex: none;
    font-size: 0.82rem;
  }

  .changelog :global(.cl-change-title) {
    flex: 0 1 auto;
    overflow: visible;
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.4;
    white-space: normal;
  }

  .changelog :global(.cl-change-meta) {
    flex: 0 0 auto;
    flex-wrap: wrap;
    gap: 0.22rem;
    max-width: none;
  }

  .changelog :global(.pr-ref) {
    gap: 0.24em;
    font-size: 0.64rem;
    padding: 0.1em 0.42em 0.1em 0.34em;
  }

  /* Scannable index: headlines + inline chips at rest; the description expands
     INLINE (no floating popover) on hover or keyboard focus. Overrides the
     component's collapse/popover. */
  .changelog :global(.cl-change .cl-change-reveal) {
    position: static;
    display: grid;
    grid-template-rows: 0fr;
    width: auto;
    max-width: 48rem;
    margin: 0;
    padding: 0 0 0 1.3rem;
    background: none;
    border: 0;
    box-shadow: none;
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
    transition: grid-template-rows 0.2s ease;
  }
  .changelog :global(.cl-change:hover .cl-change-reveal),
  .changelog :global(.cl-change:focus-within .cl-change-reveal) {
    grid-template-rows: 1fr;
  }
  .changelog :global(.cl-change .cl-change-desc) {
    overflow: hidden;
    opacity: 1;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-ink-muted);
    transition: none;
  }
  .changelog :global(.cl-change:hover),
  .changelog :global(.cl-change:focus-within) {
    background: none;
  }

  .changelog :global(.prose-changelog strong) {
    font-weight: 500;
  }

  .changelog :global(.cl-change-desc > :first-child) {
    margin-top: 0.36rem;
  }

  .changelog :global(.cl-change-desc p + p) {
    margin-top: 0.5rem;
  }

  @media (max-width: 740px) {
    .changelog {
      width: min(100% - 2rem, 58rem);
      padding-top: 2rem;
    }

    .changelog-head {
      display: block;
      gap: 1rem;
    }

    .changelog-head h1 {
      font-size: 1.55rem;
    }

    .release {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      padding: 0.85rem 0 0.95rem;
    }

    .release-stamp {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.45rem 0.7rem;
      padding-top: 0;
    }

    .release-stamp time,
    .release-stamp small {
      margin-top: 0;
    }

    .changelog :global(.cl-change-head) {
      grid-template-columns: 0.7rem minmax(0, 1fr);
    }

    .changelog :global(.cl-change-meta) {
      grid-column: 2;
      max-width: 100%;
    }
  }
</style>
