  .no-results,
  .empty-note {
    width: min(100%, 69rem);
    margin: 2rem auto 0;
    padding: 2rem;
    border: 1px dashed var(--color-rule-strong);
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-align: center;
  }

  .no-results[hidden] {
    display: none;
  }

  .release-masthead-past {
    border-top-color: var(--color-kolu-bottom);
    box-shadow: 0 18px 55px -48px var(--color-kolu-bottom);
  }

  .release-masthead-past .release-intro {
    padding-block: 1.25rem;
  }

  .release-masthead-past .release-intro h2 {
    font-size: clamp(2rem, 3.8vw, 2.8rem);
  }

  @media (max-width: 980px) {
    .release-tools[data-enhanced="true"] {
      grid-template-columns: minmax(12rem, 1fr) auto auto;
    }

    .kind-filters {
      grid-column: 1 / -1;
      grid-row: 2;
      overflow-x: auto;
      padding-top: 0.35rem;
      border-top: 1px solid var(--color-rule);
    }

    .filter-count {
