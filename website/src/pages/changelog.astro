    }

    .release-tools[data-enhanced="true"] {
      grid-template-columns: minmax(6.8rem, 0.8fr) minmax(0, 1.2fr);
    }

    .change-search {
      border-right: 1px solid var(--color-rule);
    }

    .change-search kbd {
      display: none;
    }

    .filter-count {
      display: none;
    }

    .expand-notes {
      display: none;
    }

    .kind-filters {
      grid-column: 2;
      grid-row: 1;
      min-width: 0;
      padding-top: 0;
      border-top: 0;
      overflow-x: auto;
    }

    .release-body {
      margin-top: 1.3rem;
    }

    .changelog :global(.prose-changelog h3) {
      grid-template-columns: 1.2rem minmax(0, max-content) minmax(0.5rem, 1fr);
      gap: 0.5rem;
      font-size: 1.38rem;
    }

    .changelog :global(.prose-changelog h3::before) {
