      grid-row: 1;
    }
  }

  @media (max-width: 740px) {
    .changelog {
      width: min(calc(100% - 2rem), 78rem);
      padding: 2.25rem 0 4rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }

    .hero-grid h1 {
      font-size: clamp(3.15rem, 16vw, 4.35rem);
    }

    .hero-grid > p {
      max-width: 32rem;
      margin: 0;
      font-size: 0.9rem;
    }

    .release-nav {
      grid-template-columns: 5.75rem minmax(0, 1fr);
      margin-top: 1.5rem;
    }

    .release-nav a {
      min-width: 10.5rem;
    }

    .release-current {
      margin-top: 1.4rem;
    }

    .release-masthead {
      grid-template-columns: minmax(0, 1fr) 6.5rem;
    }

    .release-intro {
      padding: 1.2rem 1.25rem 1.25rem;
    }

    .release-total strong {
      font-size: 2.2rem;
    }

    .release-stats {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, 1fr);
    }

    .release-stats > div:nth-child(odd) {
      border-left: 0;
    }

    .release-stats > div:nth-child(n + 3) {
      border-top: 1px solid var(--color-rule);
    }

    .release-tools {
      top: 3.5rem;
    }

    .release-body {
      margin-top: 1.65rem;
    }

    .changelog :global(.prose-changelog h3) {
      grid-template-columns: 1.45rem minmax(0, max-content) minmax(1rem, 1fr);
      gap: 0.6rem;
      margin-top: 2.4rem;
      font-size: 1.55rem;
      scroll-margin-top: 9.5rem;
    }

