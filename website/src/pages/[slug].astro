---
/**
 * Root-level docs routes. Each entry in the `docs` collection renders at
 * /<slug> (padi.mdx → /padi), preserving the pages' original URLs with no
 * /docs prefix. getStaticPaths emits ONLY the collection's slugs, so this
 * catch-all never shadows the static file-based pages (/, /blog, /changelog,
 * /open-graph) — those win by route specificity, and this only owns the three
 * doc slugs.
 */
import { getCollection, render } from "astro:content";
import DocsLayout from "../layouts/DocsLayout.astro";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout entry={entry} headings={headings}>
  <Content />
</DocsLayout>
