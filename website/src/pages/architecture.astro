        >
        <text x="360" y="74" text-anchor="middle" class="ax-d-sub"
          >the view in your browser</text
        >

        <rect x="190" y="126" width="340" height="64" rx="10" class="ax-d-box"
        ></rect>
        <image
          href="/favicon.svg"
          x="208"
          y="140"
          width="36"
          height="36"
          preserveAspectRatio="xMidYMid meet"
          class="ax-d-logo"
        ></image>
        <text x="360" y="152" text-anchor="middle" class="ax-d-label"
          >kolu-server</text
        >
        <text x="360" y="172" text-anchor="middle" class="ax-d-sub"
          >the web shell</text
        >

        <rect x="190" y="224" width="340" height="64" rx="10" class="ax-d-daemon"
        ></rect>
        <image
          href="/padi-logo.svg"
          x="208"
          y="238"
