---
/**
 * kolu.dev/architecture — how kolu is built: the daemon stack (PWA client ·
 * kolu-server · padi · kaval) and the @kolu/surface framework underneath it.
 *
 * A LISTED page — in the nav (Header.astro) and the sitemap. Describes only
 * what is MERGED on master today (padi W0–W2.2). Remote hosts (W3) are teased
 * as "coming", never presented as current.
 *
 * Two hand-authored inline SVG diagrams (the stack, the survival timeline)
 * pull every colour from the global tokens (var(--color-…)) so they track the
 * light/dark theme automatically — no hard-coded hex.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Repo from "../components/Repo.astro";

// The four layers, top (closest to you) to bottom (closest to the metal).
const layers = [
  {
    name: "PWA client",
    job: "the view in your browser — one surface consumer per pane",
    keeps: "Reload the tab, switch devices: it re-subscribes. It holds no state to lose.",
  },
  {
    name: "kolu-server",
    job: "the web shell — HTTP, the PWA, websockets; dials and binds padi",
    keeps: "Restart it and no terminal metadata is lost — padi's registry stays warm.",
  },
  {
    name: "padi",
    job: "the per-host workspace daemon — session, awareness, restore",
    keeps: "Kill it and no terminal state is lost — records live in its folder on disk; PTYs survive in kaval. It re-seeds in seconds.",
  },
  {
    name: "kaval",
    job: "the PTY survivor — owns the shells and their live screens",
    keeps: "Kill everything above it and the live shells and scrollback keep running — they live in kaval's memory.",
  },
];

// The four @kolu/surface primitives — the framework's own taxonomy.
const primitives = [
  {
    sig: "Cell<T>",
    q: "what's the current X?",
    what: "one value, snapshot then live deltas — the session, the version.",
  },
  {
    sig: "Collection<K,T>",
    q: "what's the current X per key?",
    what: "many keyed rows, each independently observable — the terminals registry.",
  },
  {
    sig: "Stream<I,T>",
    q: "what's the live view for input I?",
    what: "computed over outside state (fs, git), snapshot + deltas, never stored — a file preview.",
  },
  {
    sig: "Event<I,T>",
    q: "has X happened yet?",
    what: "point-in-time, no snapshot, no current value — a terminal exited.",
  },
];
---

<BaseLayout
  title="Architecture"
  description="How kolu is built: a stack of daemons that each survive a different failure. Close the tab, restart the server, redeploy — your terminals and the agents in them keep running. The daemon stack (PWA client · kolu-server · padi · kaval) and the @kolu/surface framework underneath it."
>
  <section class="mx-auto max-w-3xl px-6 pt-20 md:pt-28 pb-10">
    <p class="eyebrow text-ink-dim mb-4">architecture</p>
    <h1 class="display text-[3.2rem] md:text-[4.2rem] text-ink">
      How kolu is built
    </h1>
    <p class="mt-6 text-ink-dim max-w-xl leading-relaxed">
      kolu splits the terminal problem across daemons, and each one survives a
      different failure. Close the browser tab, restart the web server, redeploy
      the whole thing — your shells, and the agents running in them, keep going.
      Here's the stack that makes that true, and the one contract that ties it
      together.
    </p>
  </section>

  {/* ── the stack ─────────────────────────────────────────── */}
  <section class="mx-auto max-w-3xl px-6 pb-14">
    <h2 class="ax-head">the stack</h2>
    <p class="text-ink-dim text-[0.95rem] leading-relaxed max-w-xl mb-6">
      Four layers, each with one job. The top two are <em>faces</em> — they come
      and go. The bottom two are <em>daemons</em> — they hold the state and stay
      up. The arrows are transports: a websocket to the browser, a unix socket
      between the daemons. Kill any layer and everything below it keeps running.
    </p>

    <figure class="rounded-xl border border-rule px-5 py-6 overflow-x-auto">
      <svg
        class="ax-diagram"
